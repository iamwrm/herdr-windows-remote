#!/bin/sh
# hcode — herdr remote shim: open local VS Code (Remote-SSH) on this host.
#
# Install on every Linux host you attach to with `herdr --remote`:
#
#   mkdir -p ~/.local/bin
#   cp hcode ~/.local/bin/hcode && chmod +x ~/.local/bin/hcode
#
# (~/.local/bin must be on PATH.)
#
# How it works: inside a herdr pane this script sends a chunked magic JSON
# blob through `herdr terminal title set`. The official server forwards those
# reliable control messages to the attached client; the patched Windows client
# (patch 0003, IV-0004) consumes them before they reach the host title and
# launches local VS Code with `vscode://vscode-remote/ssh-remote+<target>` URLs.
# This avoids the server's normal OSC 52 "copied to clipboard" feedback.

set -eu

if [ "${HERDR_ENV:-}" != "1" ]; then
    echo "hcode: not inside a herdr pane; this shim only works under 'herdr --remote'" >&2
    exit 1
fi

[ "$#" -gt 0 ] || set -- .

if [ "$#" -gt 8 ]; then
    echo "hcode: too many paths (max 8)" >&2
    exit 1
fi

json='{"herdr":"code-open","v":1,"paths":['
sep=''
for arg in "$@"; do
    # -m: allow not-yet-existing paths (VS Code opens them as new files).
    if ! abs=$(realpath -m -- "$arg" 2>/dev/null); then
        echo "hcode: cannot resolve path: $arg" >&2
        exit 1
    fi
    if [ -d "$abs" ]; then dir=true; else dir=false; fi
    # JSON string escaping; control characters are rejected client-side.
    esc=$(printf '%s' "$abs" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    json="${json}${sep}{\"p\":\"${esc}\",\"dir\":${dir}}"
    sep=','
done
json="${json}]}"

b64=$(printf '%s' "$json" | base64 | tr -d '\n')
chunk_size=128
length=${#b64}
total=$(( (length + chunk_size - 1) / chunk_size ))
index=0
while [ "$index" -lt "$total" ]; do
    start=$((index * chunk_size + 1))
    end=$((start + chunk_size - 1))
    chunk=$(printf '%s' "$b64" | cut -c "${start}-${end}")
    title="herdr-code-open:1:$$:${index}:${total}:${chunk}"
    # Keep successful API JSON out of the pane, but preserve a concise,
    # sanitized reason when the server rejects or cannot deliver the chunk.
    if response=$(herdr terminal title set "$title" 2>&1); then
        :
    else
        detail=$(printf '%s' "$response" | tr '\r\n\t' '   ' | LC_ALL=C tr -cd '[:print:]' | cut -c 1-240)
        echo "hcode: failed to send request to the attached herdr client${detail:+: $detail}" >&2
        exit 1
    fi
    if ! printf '%s' "$response" | grep -Eq '"changed"[[:space:]]*:[[:space:]]*true([,}])'; then
        detail=$(printf '%s' "$response" | tr '\r\n\t' '   ' | LC_ALL=C tr -cd '[:print:]' | cut -c 1-240)
        echo "hcode: no attached herdr client accepted the request${detail:+: $detail}" >&2
        exit 1
    fi
    index=$((index + 1))
done
