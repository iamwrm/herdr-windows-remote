+    /// Reconstructs host theme report sequences (OSC 10/11 responses, color
+    /// scheme reports) so the client can forward them to the server as raw
+    /// input bytes — the same shape Unix clients deliver. The server's
+    /// raw-input framer parses them into this client's host theme, which
+    /// pane rendering needs to resolve inverse-video cells against the real
+    /// host colors instead of libghostty's fallback palette.
+    fn collect_theme_report(&mut self, event: &crate::raw_input::RawInputEvent) {
+        match event {
+            crate::raw_input::RawInputEvent::HostDefaultColor { kind, color } => {
+                self.theme_reports.bytes.extend_from_slice(
+                    crate::terminal_theme::osc_set_default_color_sequence(*kind, *color).as_bytes(),
+                );
+            }
+            crate::raw_input::RawInputEvent::HostColorSchemeChanged(appearance) => {
+                self.theme_reports
+                    .bytes
+                    .extend_from_slice(match appearance {
+                        crate::terminal_theme::HostAppearance::Dark => {
+                            crate::raw_input::GHOSTTY_COLOR_SCHEME_DARK_REPORT
+                        }
+                        crate::terminal_theme::HostAppearance::Light => {
+                            crate::raw_input::GHOSTTY_COLOR_SCHEME_LIGHT_REPORT
+                        }
+                    });
+                self.theme_reports.requery = true;
+            }
+            _ => {}
+        }
+    }
+
+    #[cfg(test)]
+    fn take_theme_reports(&mut self) -> ThemeReportOutbox {
+        std::mem::take(&mut self.theme_reports)
+    }
