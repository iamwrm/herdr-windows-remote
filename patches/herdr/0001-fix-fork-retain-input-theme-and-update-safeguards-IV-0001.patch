+/// Concrete pane default colors for resolving inverse cells, or `None` per
+/// side when that color cannot be trusted.
+///
+/// A side is trustworthy when the host terminal theme for it is known (the
+/// pane palette was seeded/updated from real host colors) or when the pane
+/// app customized it away from the initial default (the app chose a concrete
+/// color on purpose). Otherwise the pane palette is just libghostty's
+/// built-in fallback and must not be baked into rendered cells.
+fn ghostty_resolved_inverse_colors(
+    colors: Option<crate::ghostty::RenderColors>,
+    host_theme: crate::terminal_theme::TerminalTheme,
+    initial_default_foreground: Option<crate::ghostty::RgbColor>,
+    initial_default_background: Option<crate::ghostty::RgbColor>,
+) -> (Option<Color>, Option<Color>) {
+    let resolved_fg = colors.and_then(|c| {
+        (host_theme.foreground.is_some()
+            || initial_default_foreground.is_some_and(|initial| initial != c.foreground))
+        .then(|| ghostty_color(c.foreground))
+    });
+    let resolved_bg = colors.and_then(|c| {
+        (host_theme.background.is_some()
+            || initial_default_background.is_some_and(|initial| initial != c.background))
+        .then(|| ghostty_color(c.background))
+    });
+    (resolved_fg, resolved_bg)
+}
