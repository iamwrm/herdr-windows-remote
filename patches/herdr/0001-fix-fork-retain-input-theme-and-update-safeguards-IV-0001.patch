+
+        let buffer = terminal.backend().buffer();
+        let cell = &buffer[(0, 0)];
+        assert_eq!(cell.symbol(), "h");
+        assert_eq!(cell.style().fg, Some(Color::Rgb(0x11, 0x22, 0x33)));
+        assert_eq!(cell.style().bg, Some(Color::Rgb(0xaa, 0xbb, 0xcc)));
