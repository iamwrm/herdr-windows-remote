+            clipboard_image_buffer_mb: DEFAULT_REMOTE_CLIPBOARD_IMAGE_BUFFER_MB,
             code_open: true,
         }
     }
 }
 
+impl RemoteConfig {
+    pub(crate) fn clipboard_image_buffer_bytes(&self) -> u64 {
+        self.clipboard_image_buffer_mb * 1024 * 1024
+    }
+}
+
+fn deserialize_remote_clipboard_image_buffer_mb<'de, D>(deserializer: D) -> Result<u64, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    let value = u64::deserialize(deserializer)?;
+    if (1..=MAX_REMOTE_CLIPBOARD_IMAGE_BUFFER_MB).contains(&value) {
+        Ok(value)
+    } else {
+        Err(de::Error::custom(format!(
+            "remote.clipboard_image_buffer_mb must be between 1 and {MAX_REMOTE_CLIPBOARD_IMAGE_BUFFER_MB}"
+        )))
+    }
+}
+
+fn default_remote_clipboard_image_buffer_mb() -> u64 {
+    DEFAULT_REMOTE_CLIPBOARD_IMAGE_BUFFER_MB
+}
