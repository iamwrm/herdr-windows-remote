 }
 
-pub fn show_desktop_notification(_title: &str, _body: Option<&str>) -> std::io::Result<bool> {
-    Ok(false)
+/// Python helper executed through `uv run`. It reads the notification title
+/// and body from `sys.argv`, so notification text is passed as process
+/// arguments and never interpolated into code.
+const WINDOWS_TOAST_PYTHON_SCRIPT: &str = "import sys
+from windows_toasts import Toast, WindowsToaster
+toaster = WindowsToaster('herdr')
+toast = Toast()
+toast.text_fields = [field for field in sys.argv[1:] if field]
+toaster.show_toast(toast)
+";
+
+/// Show a native Windows toast notification through `uv` and the
+/// `windows-toasts` Python package (both the interpreter and the package are
+/// resolved by `uv run`).
+///
+/// The spawn is fire-and-forget: `uv run` can take seconds on a cold cache
+/// and this is called from the client event loop, so the helper is spawned
+/// with a hidden console and never awaited. A missing `uv` reports
+/// `Ok(false)`, matching how a missing `notify-send` behaves on Linux.
+pub fn show_desktop_notification(title: &str, body: Option<&str>) -> std::io::Result<bool> {
+    show_desktop_notification_with_command(title, body, |program| Command::new(program))
+}
+
+fn show_desktop_notification_with_command(
+    title: &str,
+    body: Option<&str>,
+    mut command: impl FnMut(&str) -> Command,
+) -> std::io::Result<bool> {
+    let mut cmd = command("uv");
+    build_windows_toast_command(&mut cmd, title, body);
+    spawn_notification_command(cmd)
+}
+
+fn build_windows_toast_command(cmd: &mut Command, title: &str, body: Option<&str>) {
+    // --no-project keeps `uv run` from syncing an unrelated pyproject.toml in
+    // the client's working directory.
+    cmd.args(["run", "--no-project", "--with", "windows-toasts", "python", "-c"])
+        .arg(WINDOWS_TOAST_PYTHON_SCRIPT)
+        .arg(title)
+        .arg(body.unwrap_or_default());
+}
+
+fn spawn_notification_command(mut command: Command) -> std::io::Result<bool> {
+    configure_background_command_platform(&mut command);
+    match command
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+    {
+        Ok(_) => Ok(true),
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(false),
+        Err(err) => Err(err),
+    }
 }
 
 fn wide_null(value: &str) -> Vec<u16> {
@@ -1352,6 +1405,61 @@ mod tests {
         );
