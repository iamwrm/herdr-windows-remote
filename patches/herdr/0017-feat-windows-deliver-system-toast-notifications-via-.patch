+    #[test]
+    fn windows_toast_command_passes_title_and_body_as_argv() {
+        let mut cmd = Command::new("uv");
+        super::build_windows_toast_command(&mut cmd, "-danger: build", Some("api \u{b7} 1"));
+
+        let args: Vec<String> = cmd
+            .get_args()
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect();
+        assert_eq!(cmd.get_program(), "uv");
+        assert_eq!(
+            args[..6],
+            ["run", "--no-project", "--with", "windows-toasts", "python", "-c"]
+        );
+        assert_eq!(args[6], super::WINDOWS_TOAST_PYTHON_SCRIPT);
+        // Title and body ride as trailing argv entries, never inside the code.
+        assert_eq!(args[7..], ["-danger: build", "api \u{b7} 1"]);
+    }
+
+    #[test]
+    fn windows_toast_command_uses_empty_body_placeholder() {
+        let mut cmd = Command::new("uv");
+        super::build_windows_toast_command(&mut cmd, "title", None);
+
+        let args: Vec<String> = cmd
+            .get_args()
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect();
+        assert_eq!(args[7..], ["title", ""]);
+    }
+
+    #[test]
+    fn windows_toast_notification_without_uv_reports_not_shown() {
+        let shown = super::show_desktop_notification_with_command("title", Some("body"), |_| {
+            Command::new("herdr-test-missing-uv-binary.exe")
+        })
+        .expect("missing uv must not error");
+
+        assert!(!shown);
+    }
+
+    #[test]
+    fn windows_toast_notification_spawn_success_reports_shown() {
+        // cmd.exe tolerates the appended uv arguments after /d /c rem; only
+        // the detached spawn itself is under test.
+        let shown = super::show_desktop_notification_with_command("title", None, |_| {
+            let mut cmd = Command::new("cmd.exe");
+            cmd.args(["/d", "/c", "rem"]);
+            cmd
+        })
+        .expect("spawn must succeed");
+
+        assert!(shown);
+    }
+
     fn test_entry(
         pid: u32,
         parent_pid: u32,
