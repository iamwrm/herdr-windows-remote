From 583080f71a4cfb9fcb91d4199bf1ba6580063ca7 Mon Sep 17 00:00:00 2001
From: iamwrm <iamwrm@gmail.com>
Date: Thu, 16 Jul 2026 15:28:14 +0800
Subject: [PATCH 03/16] feat(fork): disable self-update and background version
 check

This binary is the windows-remote fork; the updater compares against the
official herdr.dev manifests and would replace it with an upstream build
that has no native Windows --remote support.

- `herdr update` now errors with a pointer to the fork releases page
- the background version check (startup + periodic) is skipped, so no
  'update available' notice can steer the user onto upstream binaries
- the agent-manifest background check is intentionally left enabled
  (agent detection data, unrelated to the herdr binary)
- the remote-install path is untouched: installing the matching official
  Linux binary on the ssh target from the official manifest is exactly
  what `--remote` needs
---
 src/main.rs   | 24 ++++++++++++++++++------
 src/update.rs | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/src/main.rs b/src/main.rs
index 26dc62a..5d140e1 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -146,15 +146,17 @@ const DEFAULT_CONFIG: &str = r##"# herdr configuration
 # new_cwd = "follow"
 
 [update]
-# Update channel used by background version checks and `herdr update`.
-# Defaults to "stable" on Linux/macOS and "preview" on Windows.
-# Set explicitly to choose stable releases or opt-in preview builds.
+# This patched build disables binary version checks and `herdr update` so an
+# official build cannot replace its native Windows --remote support. Download
+# updates manually from:
+# https://github.com/iamwrm/herdr-windows-remote/releases
+# `channel` and `version_check` remain accepted for config compatibility but
+# have no effect in this build.
 # channel = "stable"
-
-# Check herdr.dev for new Herdr versions in the background.
 # version_check = true
 
-# Check herdr.dev for remote agent-detection manifest updates in the background.
+# Agent-detection manifest updates are independent of binary self-update and
+# remain enabled; they refresh detection data from herdr.dev.
 # manifest_check = true
 
 [keys]
@@ -842,6 +844,16 @@ fn main() -> io::Result<()> {
 mod tests {
     use super::*;
 
+    #[test]
+    fn default_config_explains_disabled_fork_updates() {
+        assert!(DEFAULT_CONFIG.contains("disables binary version checks and `herdr update`"));
+        assert!(DEFAULT_CONFIG.contains("https://github.com/iamwrm/herdr-windows-remote/releases"));
+        assert!(DEFAULT_CONFIG.contains("have no effect in this build"));
+        assert!(DEFAULT_CONFIG
+            .contains("Agent-detection manifest updates are independent of binary self-update"));
+        assert!(DEFAULT_CONFIG.contains("# manifest_check = true"));
+    }
+
     #[test]
     fn default_config_explains_platform_specific_remote_behavior() {
         assert!(DEFAULT_CONFIG.contains("On Unix, true (default) uses a generated config"));
diff --git a/src/update.rs b/src/update.rs
index 9bb764e..4459574 100644
--- a/src/update.rs
+++ b/src/update.rs
@@ -24,6 +24,14 @@ use interprocess::local_socket::traits::Stream as _;
 use serde::{Deserialize, Deserializer};
 
 const STABLE_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/latest.json";
+
+/// This build is the `herdr-windows-remote` patched build. Self-update and the
+/// background version check are disabled: they compare against the *official*
+/// herdr.dev manifests and would replace this binary with an upstream build
+/// that lacks native Windows `--remote` support. Fork releases live at
+/// [`FORK_RELEASES_URL`].
+const FORK_BUILD: bool = true;
+const FORK_RELEASES_URL: &str = "https://github.com/iamwrm/herdr-windows-remote/releases";
 const PREVIEW_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/preview.json";
 const HOMEBREW_FORMULA_API_URL: &str = "https://formulae.brew.sh/api/formula/herdr.json";
 const HERDR_UPDATE_COMMAND: &str = "herdr update";
@@ -1943,6 +1951,12 @@ fn homebrew_cellar_keg_root(path: &Path) -> Option<PathBuf> {
 
 /// Manual self-update command (`herdr update`).
 pub fn self_update(options: SelfUpdateOptions) -> Result<Version, String> {
+    if FORK_BUILD {
+        return Err(format!(
+            "self-update is disabled for this windows-remote fork build: it would install an official upstream binary without `--remote` support on Windows.\nDownload fork builds from {FORK_RELEASES_URL} instead."
+        ));
+    }
+
     let channel = UpdateChannel::configured();
     #[cfg(windows)]
     if channel == UpdateChannel::Stable {
@@ -2078,6 +2092,14 @@ fn print_outdated_integration_notice_with_updated_binary(updated_exe: &Path) {
 /// Background update check: only surface availability and release notes.
 /// Runs in a background thread at startup.
 pub fn auto_update(events: tokio::sync::mpsc::Sender<crate::events::AppEvent>) {
+    if FORK_BUILD {
+        // No version check against the official manifests: any "update
+        // available" notice would steer the user into replacing this fork
+        // build with an upstream binary. Watch FORK_RELEASES_URL instead.
+        tracing::info!("skipping update check: windows-remote fork build");
+        return;
+    }
+
     crate::logging::update_check_started();
     if let Ok(version) = env::var(FAKE_UPDATE_VERSION_ENV) {
         let version = version.trim();
@@ -2232,6 +2254,18 @@ fn platform_target() -> (&'static str, &'static str) {
 // Tests
 // ---------------------------------------------------------------------------
 
+#[cfg(test)]
+mod fork_tests {
+    use super::*;
+
+    #[test]
+    fn fork_self_update_error_points_to_current_releases() {
+        let error = self_update(SelfUpdateOptions::default()).expect_err("fork update disabled");
+        assert!(error.contains("https://github.com/iamwrm/herdr-windows-remote/releases"));
+        assert!(!error.contains("https://github.com/iamwrm/herdr/releases"));
+    }
+}
+
 #[cfg(all(test, unix))]
 mod tests {
     use super::*;
