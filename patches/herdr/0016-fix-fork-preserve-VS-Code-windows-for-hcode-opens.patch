From 9e591f7ccb2edff5058e4c71019db6d2412b5de4 Mon Sep 17 00:00:00 2001
From: iamwrm <iamwrm@gmail.com>
Date: Tue, 21 Jul 2026 15:17:03 +0800
Subject: [PATCH 16/16] fix(fork): preserve VS Code windows for hcode opens

---
 src/client/code_open.rs | 32 +++++++++++++++++++++++---------
 1 file changed, 23 insertions(+), 9 deletions(-)

diff --git a/src/client/code_open.rs b/src/client/code_open.rs
index 30312eb..a839ddb 100644
--- a/src/client/code_open.rs
+++ b/src/client/code_open.rs
@@ -225,10 +225,21 @@ fn percent_encode_path(path: &str) -> String {
 
 fn remote_url(target: &str, path: &str, directory: bool) -> String {
     let mut encoded_path = percent_encode_path(path);
-    if directory && !encoded_path.ends_with('/') {
-        encoded_path.push('/');
+    if directory {
+        if !encoded_path.ends_with('/') {
+            encoded_path.push('/');
+        }
+        // VS Code checks for an already-open matching workspace before
+        // applying this new-window fallback. Without it, an unmatched folder
+        // link may replace the active workspace, and several links can
+        // collapse into the same replacement window.
+        format!("vscode://vscode-remote/ssh-remote+{target}{encoded_path}?windowId=_blank")
+    } else {
+        // VS Code recognizes remote protocol paths as files only when they
+        // carry a line suffix. Its goto-line parser removes this marker before
+        // opening the file and naturally selects an existing containing window.
+        format!("vscode://vscode-remote/ssh-remote+{target}{encoded_path}:1")
     }
-    format!("vscode://vscode-remote/ssh-remote+{target}{encoded_path}")
 }
 
 #[cfg(test)]
@@ -268,7 +279,7 @@ mod tests {
         assert_eq!(
             code_open.evaluate(&encode(payload), Instant::now()),
             Outcome::Open(vec![
-                "vscode://vscode-remote/ssh-remote+deb1/home/u/proj/".to_string(),
+                "vscode://vscode-remote/ssh-remote+deb1/home/u/proj/?windowId=_blank".to_string(),
             ])
         );
     }
@@ -280,7 +291,7 @@ mod tests {
         assert_eq!(
             code_open.evaluate(&encode(payload), Instant::now()),
             Outcome::Open(vec![
-                "vscode://vscode-remote/ssh-remote+deb1/etc/hosts".to_string(),
+                "vscode://vscode-remote/ssh-remote+deb1/etc/hosts:1".to_string(),
             ])
         );
     }
@@ -295,7 +306,7 @@ mod tests {
         };
         assert_eq!(
             urls[0],
-            "vscode://vscode-remote/ssh-remote+deb1/home/u/my%20dir%2B%E6%96%87/"
+            "vscode://vscode-remote/ssh-remote+deb1/home/u/my%20dir%2B%E6%96%87/?windowId=_blank"
         );
     }
 
@@ -306,7 +317,10 @@ mod tests {
         let Outcome::Open(urls) = code_open.evaluate(&encode(payload), Instant::now()) else {
             panic!("expected URL");
         };
-        assert_eq!(urls[0], "vscode://vscode-remote/ssh-remote+admin@deb1/x/");
+        assert_eq!(
+            urls[0],
+            "vscode://vscode-remote/ssh-remote+admin@deb1/x/?windowId=_blank"
+        );
     }
 
     #[test]
@@ -402,8 +416,8 @@ mod tests {
         assert_eq!(
             code_open.evaluate(&encode(payload), Instant::now()),
             Outcome::Open(vec![
-                "vscode://vscode-remote/ssh-remote+deb1/a/".to_string(),
-                "vscode://vscode-remote/ssh-remote+deb1/b/f.txt".to_string(),
+                "vscode://vscode-remote/ssh-remote+deb1/a/?windowId=_blank".to_string(),
+                "vscode://vscode-remote/ssh-remote+deb1/b/f.txt:1".to_string(),
             ])
         );
     }
