         let records = "\x1b[200~alpha\x1b[13;28;13;1;16;1_bravo\x1b[201~"
             .chars()
             .map(key_char);
@@ -1698,7 +1803,7 @@ mod tests {
         assert_eq!(
             translate(records),
             vec![crate::protocol::ClientInputEvent::Paste {
-                text: "alpha\x1b[13;28;13;1;16;1_bravo".into(),
