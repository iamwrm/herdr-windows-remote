+/// Parses the parameter body of a win32-input-mode sequence
+/// (`CSI Vk;Sc;Uc;Kd;Cs;Rc _`).
+///
+/// Mirrors the reference decoder, `InputStateMachineEngine::_GenerateWin32Key`
+/// in microsoft/terminal: every parameter is optional (defaulting to 0, except
+/// the repeat count which defaults to 1), empty parameters count as omitted,
+/// and extra trailing parameters are ignored. Some ConPTY hosts emit more than
+/// six fields (e.g. Enter arrives as `^[[13;28;13;1;0;0;1_`); rejecting those
+/// leaked the literal sequence bytes into bracketed-paste payloads, which
+/// showed up as `[13;28;13;1;0;0;1_` after every line end when pasting
+/// multi-line text into a remote (Linux) pane. Local Windows panes hid the
+/// bug because their own ConPTY re-parses the leaked sequence leniently.
 fn parse_win32_input_mode_key_record(body: &str) -> Option<WindowsKeyRecord> {
-    let mut fields = body.split(';');
-    let virtual_key_code = fields.next()?.parse::<u16>().ok()?;
-    let virtual_scan_code = fields.next()?.parse::<u16>().ok()?;
-    let unicode = fields.next()?.parse::<u16>().ok()?;
-    let key_down = fields.next()?.parse::<u16>().ok()? != 0;
-    let control_key_state = fields.next()?.parse::<u32>().ok()?;
-    let repeat_count = fields.next()?.parse::<u16>().ok()?;
-    if fields.next().is_some() {
-        return None;
+    fn field<T: std::str::FromStr>(value: Option<&str>, default: T) -> Option<T> {
+        match value {
+            None | Some("") => Some(default),
+            Some(value) => value.parse::<T>().ok(),
+        }
     }
 
+    let mut fields = body.split(';');
+    let virtual_key_code = field(fields.next(), 0u16)?;
+    let virtual_scan_code = field(fields.next(), 0u16)?;
+    let unicode = field(fields.next(), 0u16)?;
+    let key_down = field(fields.next(), 0u16)? != 0;
+    let control_key_state = field(fields.next(), 0u32)?;
+    let repeat_count = field(fields.next(), 1u16)?;
+    // Extra parameters are ignored, exactly like the reference decoder.
+
     Some(WindowsKeyRecord {
         key_down,
         repeat_count,
@@ -1188,6 +1204,90 @@ mod tests {
         );
     }
 
+    #[test]
+    fn vti_win32_input_mode_seven_field_enter_decodes_as_enter() {
+        // Some ConPTY hosts append an extra parameter to win32-input-mode
+        // sequences. The reference decoder ignores extra parameters; so must
+        // we.
+        let records = "\x1b[13;28;13;1;0;0;1_".chars().map(key_char);
+
+        assert_eq!(
+            translate(records),
+            vec![crate::protocol::ClientInputEvent::Key {
+                code: crate::protocol::ClientKeyCode::Enter,
+                modifiers: 0,
+                kind: crate::protocol::ClientKeyKind::Press,
+            }]
+        );
+    }
+
+    #[test]
+    fn vti_win32_input_mode_omitted_fields_use_reference_defaults() {
+        // Per the win32-input-mode spec, all parameters are optional
+        // (repeat count defaults to 1). `^[[13;28;13;1_` is Enter down.
+        let records = "\x1b[13;28;13;1_".chars().map(key_char);
+
+        assert_eq!(
+            translate(records),
+            vec![crate::protocol::ClientInputEvent::Key {
+                code: crate::protocol::ClientKeyCode::Enter,
+                modifiers: 0,
+                kind: crate::protocol::ClientKeyKind::Press,
+            }]
+        );
+    }
+
+    #[test]
+    fn vti_win32_encoded_enter_inside_plain_paste_stays_in_paste_payload() {
+        // Multi-line paste as some ConPTY hosts deliver it: pasted text
+        // forwarded verbatim (plain chars, bracketed), but the Enter between
+        // lines re-encoded as a win32-input-mode key sequence. The decoded
+        // Enter must contribute `\r` to the paste payload, not its raw
+        // sequence bytes.
+        let mut records: Vec<_> = "\x1b[200~echo XXX".chars().map(key_char).collect();
+        records.extend("\x1b[13;28;13;1;0;0;1_".chars().map(key_char));
+        records.extend("\x1b[13;28;13;0;0;0;1_".chars().map(key_char));
+        records.extend("echo YYY\x1b[201~".chars().map(key_char));
+
+        assert_eq!(
+            translate(records),
+            vec![crate::protocol::ClientInputEvent::Paste {
+                text: "echo XXX\recho YYY".into(),
+            }]
+        );
+    }
+
+    #[test]
+    fn vti_win32_encoded_six_field_enter_inside_plain_paste_stays_in_paste_payload() {
+        // Same as above with the standard six-field encoding.
+        let mut records: Vec<_> = "\x1b[200~alpha".chars().map(key_char).collect();
+        records.extend("\x1b[13;28;13;1;0;1_".chars().map(key_char));
+        records.extend("bravo\x1b[201~".chars().map(key_char));
+
+        assert_eq!(
+            translate(records),
+            vec![crate::protocol::ClientInputEvent::Paste {
+                text: "alpha\rbravo".into(),
+            }]
+        );
+    }
+
+    #[test]
+    fn vti_win32_input_mode_bracketed_paste_with_seven_field_enters_emits_single_paste() {
+        // Fully win32-encoded paste (brackets included) with the
+        // extra-parameter Enter variant between lines.
+        let mut records = win32_input_mode_encoded_key_bytes(b"\x1b[200~line one");
+        records.extend("\x1b[13;28;13;1;0;0;1_".chars().map(key_char));
+        records.extend(win32_input_mode_encoded_key_bytes(b"line two\x1b[201~"));
+
+        assert_eq!(
+            translate(records),
+            vec![crate::protocol::ClientInputEvent::Paste {
+                text: "line one\rline two".into(),
+            }]
+        );
+    }
+
     #[test]
     fn vti_win32_input_mode_decoded_paste_handles_shift_repeats_and_releases() {
         let mut records = win32_input_mode_encoded_key_bytes(b"\x1b[200~");
@@ -1690,7 +1790,12 @@ mod tests {
     }
 
     #[test]
-    fn vti_win32_input_mode_sequence_inside_bracketed_paste_stays_payload() {
+    fn vti_win32_input_mode_sequence_inside_bracketed_paste_decodes_to_payload() {
+        // A win32-encoded key record inside a plain-started paste contributes
