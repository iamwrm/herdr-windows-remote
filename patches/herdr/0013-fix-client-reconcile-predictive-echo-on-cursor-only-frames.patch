@@ -2032,6 +2048,73 @@ fn write_window_title(title: Option<&str>) {
 // Frame output
 // ---------------------------------------------------------------------------
 
+const SYNC_OUTPUT_END: &[u8] = b"\x1b[?2026l";
+
+fn write_prediction_output(bytes: &[u8]) {
+    if bytes.is_empty() {
+        return;
+    }
+    let mut stdout = io::stdout().lock();
+    let _ = stdout.write_all(bytes);
+    let _ = stdout.flush();
+}
+
+/// Keep frame reconciliation atomic with the server frame. Inserting the
+/// predictor's repaint/cursor anchor before the synchronized-output terminator
+/// prevents the host terminal from briefly exposing the stale server cursor.
+/// Linux encoders append a duplicate IME cursor anchor after that terminator;
+/// discard that tail when a predictor anchor supersedes it.
+fn write_terminal_frame_with_predictions(
+    mut writer: impl io::Write,
+    frame: &[u8],
+    prediction_output: &[u8],
+) -> io::Result<()> {
+    if prediction_output.is_empty() {
+        writer.write_all(frame)?;
+    } else if let Some(sync_end) = frame
+        .windows(SYNC_OUTPUT_END.len())
+        .rposition(|window| window == SYNC_OUTPUT_END)
+    {
+        let tail = &frame[sync_end + SYNC_OUTPUT_END.len()..];
+        if tail.is_empty() || is_post_sync_ime_cursor_anchor(tail) {
+            writer.write_all(&frame[..sync_end])?;
+            writer.write_all(prediction_output)?;
+            writer.write_all(SYNC_OUTPUT_END)?;
+        } else {
+            // Never discard an unrecognized server suffix. The correction is
+            // less atomic in this defensive fallback, but remains final.
+            writer.write_all(frame)?;
+            writer.write_all(prediction_output)?;
+        }
+    } else {
+        writer.write_all(frame)?;
+        writer.write_all(prediction_output)?;
+    }
+    writer.flush()
+}
+
+/// The non-Windows encoder's optional IME suffix is exactly
+/// `CUP(row,col) + DECTCEM(show|hide)`. Recognize only that grammar before
+/// replacing it; arbitrary bytes after synchronized output must be preserved.
+fn is_post_sync_ime_cursor_anchor(bytes: &[u8]) -> bool {
+    let Some(rest) = bytes.strip_prefix(b"\x1b[") else {
+        return false;
+    };
+    let Some(cup_end) = rest.iter().position(|byte| *byte == b'H') else {
+        return false;
+    };
+    let coordinates = &rest[..cup_end];
+    let Some(separator) = coordinates.iter().position(|byte| *byte == b';') else {
+        return false;
+    };
+    let (row, column_with_separator) = coordinates.split_at(separator);
+    let column = &column_with_separator[1..];
+    let valid_number = |number: &[u8]| !number.is_empty() && number.iter().all(u8::is_ascii_digit);
+    valid_number(row)
+        && valid_number(column)
+        && matches!(&rest[cup_end + 1..], b"\x1b[?25h" | b"\x1b[?25l")
+}
+
