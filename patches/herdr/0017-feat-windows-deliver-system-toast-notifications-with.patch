+    #[test]
+    fn windows_toast_document_preserves_title_and_body_as_text() {
+        let document =
+            super::build_windows_toast_document("build <failed> & retry", Some("api \u{b7} 1 > 0"))
+                .expect("toast document");
+        let nodes = document
+            .GetElementsByTagName(&windows::core::HSTRING::from("text"))
+            .expect("text nodes");
+
+        assert_eq!(nodes.Length().unwrap(), 2);
+        assert_eq!(
+            nodes.Item(0).unwrap().InnerText().unwrap(),
+            "build <failed> & retry"
+        );
+        assert_eq!(
+            nodes.Item(1).unwrap().InnerText().unwrap(),
+            "api \u{b7} 1 > 0"
+        );
+    }
+
+    #[test]
+    fn windows_toast_document_omits_empty_body() {
+        for body in [None, Some("")] {
+            let document =
+                super::build_windows_toast_document("title", body).expect("toast document");
+            let nodes = document
+                .GetElementsByTagName(&windows::core::HSTRING::from("text"))
+                .expect("text nodes");
+
+            assert_eq!(nodes.Length().unwrap(), 1);
+            assert_eq!(nodes.Item(0).unwrap().InnerText().unwrap(), "title");
+        }
+    }
