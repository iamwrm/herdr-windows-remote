+
+/// `ProxyCommand` routing the connection through this binary's TCP_NODELAY
+/// relay. `%h`/`%p` are expanded by ssh; the exe path is double-quoted for
+/// the shell Windows OpenSSH runs proxy commands with. Beware this option
+/// has command-line precedence and overrides any ProxyCommand/ProxyJump the
+/// user's ssh config defines for the target — which is why `remote.tcp_relay`
+/// is opt-in.
+fn tcp_relay_proxy_option() -> Option<String> {
+    let exe = std::env::current_exe().ok()?;
+    let exe = exe.to_str()?;
+    Some(format!("ProxyCommand=\"{exe}\" remote-tcp-relay %h %p"))
 }
 
