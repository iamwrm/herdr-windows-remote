+
+/// Overrides `remote.tcp_relay` for testing: `HERDR_REMOTE_TCP_RELAY=1`
+/// forces the relay on, `=0` forces it off.
+const TCP_RELAY_ENV_VAR: &str = "HERDR_REMOTE_TCP_RELAY";
+
+fn tcp_relay_enabled(config_value: bool) -> bool {
+    match std::env::var(TCP_RELAY_ENV_VAR) {
+        Ok(value) => match value.trim() {
+            "" => config_value,
+            "0" => false,
+            _ => true,
+        },
+        Err(_) => config_value,
+    }
 }
 
