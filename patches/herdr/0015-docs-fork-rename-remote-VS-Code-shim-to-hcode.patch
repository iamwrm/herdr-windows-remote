From f67ade9d03522e41b6cb28a81af2e5ac2de5de83 Mon Sep 17 00:00:00 2001
From: iamwrm <iamwrm@gmail.com>
Date: Mon, 20 Jul 2026 19:08:15 +0800
Subject: [PATCH] docs(fork): rename remote VS Code shim to hcode

---
 src/client/code_open.rs | 4 ++--
 src/client/mod.rs       | 6 +++---
 src/config/model.rs     | 4 ++--
 src/remote/launcher.rs  | 2 +-
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/client/code_open.rs b/src/client/code_open.rs
index 14a593c..30312eb 100644
--- a/src/client/code_open.rs
+++ b/src/client/code_open.rs
@@ -1,7 +1,7 @@
-//! `code .` typed on a remote herdr host opens local VS Code Remote-SSH.
+//! `hcode .` typed on a remote herdr host opens local VS Code Remote-SSH.
 //!
 //! A shim script installed on the remote host (shipped as
-//! `extras/remote-bin/code` in the patches repo) emits an OSC 52 clipboard
+//! `extras/remote-bin/hcode` in the patches repo) emits an OSC 52 clipboard
 //! write whose payload is a magic JSON blob carrying absolute paths. The
 //! official Linux server already forwards pane OSC 52 writes to the
 //! foreground client as `ServerMessage::Clipboard`, so the blob arrives here
diff --git a/src/client/mod.rs b/src/client/mod.rs
index 497e6e9..17fa3a8 100644
--- a/src/client/mod.rs
+++ b/src/client/mod.rs
@@ -58,7 +58,7 @@ static RECEIVED_KITTY_GRAPHICS_IDS: OnceLock<Mutex<HashSet<u32>>> = OnceLock::ne
 struct ClientLoopConfig {
     /// `remote.predictive_echo` setting ("off" | "auto" | "always").
     predictive_echo: String,
-    /// `remote.code_open` setting: allow the remote `code` shim to open
+    /// `remote.code_open` setting: allow the remote `hcode` shim to open
     /// local VS Code Remote-SSH windows (i0004).
     code_open: bool,
     sound_config: crate::config::SoundConfig,
@@ -1309,7 +1309,7 @@ async fn run_client_loop(
         None
     };
 
-    // `code <path>` typed on the remote host → local VS Code Remote-SSH
+    // `hcode <path>` typed on the remote host → local VS Code Remote-SSH
     // window (i0004). Only active for remote attach clients.
     let mut code_open = code_open::CodeOpen::from_client_env(config.code_open);
 
@@ -1623,7 +1623,7 @@ async fn run_client_loop(
                     handle_notify(kind, &message, body.as_deref(), &state.sound_config);
                 }
                 ServerMessage::Clipboard { data } => {
-                    // The remote `code` shim rides the OSC 52 channel; its
+                    // The remote `hcode` shim rides the OSC 52 channel; its
                     // magic payloads must never reach the real clipboard.
                     let handled = code_open
                         .as_mut()
diff --git a/src/config/model.rs b/src/config/model.rs
index 1fe281b..53aa77a 100644
--- a/src/config/model.rs
+++ b/src/config/model.rs
@@ -874,8 +874,8 @@ pub struct RemoteConfig {
     /// once echo delay is observed to be high), or `"always"`.
     /// Default: "auto".
     pub predictive_echo: String,
-    /// Allow the remote `code` shim script to open local VS Code Remote-SSH
-    /// windows for paths on the attached host (`code .` inside
+    /// Allow the remote `hcode` shim script to open local VS Code Remote-SSH
+    /// windows for paths on the attached host (`hcode .` inside
     /// `herdr --remote`). The client only ever launches VS Code with
     /// `vscode://vscode-remote/ssh-remote+<target>` URLs for the current
     /// attach target. Env override: `HERDR_REMOTE_CODE_OPEN=1|0`. Default: true.
diff --git a/src/remote/launcher.rs b/src/remote/launcher.rs
index 730e0ce..8eefc4c 100644
--- a/src/remote/launcher.rs
+++ b/src/remote/launcher.rs
@@ -69,7 +69,7 @@ pub(crate) const REATTACH_COMMAND_ENV_VAR: &str = "HERDR_REATTACH_COMMAND";
 pub(crate) const REMOTE_KEYBINDINGS_ENV_VAR: &str = "HERDR_REMOTE_KEYBINDINGS";
 
 /// Ssh target of the active `herdr --remote` attach, exported to the spawned
-/// client process so client-local integrations (the remote `code` shim →
+/// client process so client-local integrations (the remote `hcode` shim →
 /// local VS Code Remote-SSH, i0004) know which host they are attached to.
 pub(crate) const REMOTE_TARGET_ENV_VAR: &str = "HERDR_REMOTE_TARGET";
 
-- 
2.52.0.windows.1

