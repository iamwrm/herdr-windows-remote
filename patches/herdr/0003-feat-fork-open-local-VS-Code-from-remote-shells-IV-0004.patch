+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"proj","dir":true}]}"#;
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Rejected(_)
+        ));
+    }
+
+    #[test]
