+//! `hcode .` typed on a remote herdr host opens local VS Code Remote-SSH.
+//!
+//! A shim script installed on the remote host (shipped as
+//! `extras/remote-bin/hcode` in the patches repo) sends a chunked magic JSON
+//! blob through the existing `herdr terminal title set` API. The official
+//! Linux server forwards those reliable control messages to the foreground
+//! client as `ServerMessage::WindowTitle`, so the request arrives here with no
+//! wire-protocol change and without triggering clipboard-feedback UI. Legacy
+//! OSC 52 requests from older installed shims remain accepted. When the
+//! decoded payload starts with the magic prefix, the client opens a
+//! `vscode://vscode-remote/ssh-remote+<target>/<path>` URL instead of touching
+//! the local clipboard. The platform URL handler launches the user's
+//! registered VS Code installation without a shell or launcher discovery.
+//!
+//! Safety posture — any remote pane process can invoke the local server API,
+//! so the client keeps control of everything that matters:
+//! - the ssh authority comes from `HERDR_REMOTE_TARGET` (set by the local
+//!   launcher), never from the payload;
+//! - paths must be absolute, control-character-free, and bounded in count
+//!   and length;
+//! - the opened URL has a fixed VS Code Remote-SSH prefix and a
+//!   percent-encoded path;
+//! - launches are rate-limited;
+//! - `remote.code_open = false` (or `HERDR_REMOTE_CODE_OPEN=0`) disables the
+//!   feature entirely.
+
+use std::time::{Duration, Instant};
+
+use base64::Engine;
+use tracing::{info, warn};
+
+/// Decoded payloads must start with these exact bytes to be treated as a
+/// code-open request. The shim emits its JSON with this exact key order;
+/// legacy clipboard payloads without it remain ordinary clipboard writes.
+const MAGIC_PREFIX: &[u8] = b"{\"herdr\":\"code-open\"";
+/// Prefix carried in `ServerMessage::WindowTitle`. The rest is
+/// `<version>:<request-id>:<index>:<total>:<base64-chunk>`.
+const TITLE_PREFIX: &str = "herdr-code-open:";
+/// Overrides `remote.code_open` for testing: `HERDR_REMOTE_CODE_OPEN=1`
+/// forces the feature on, `=0` forces it off.
+const ENV_VAR: &str = "HERDR_REMOTE_CODE_OPEN";
+/// Payload format version this client understands.
+const SUPPORTED_VERSION: u32 = 1;
+const MAX_PATHS: usize = 8;
+const MAX_PATH_LEN: usize = 4096;
+/// Minimum time between launches, so a hostile remote loop cannot spawn an
+/// unbounded number of VS Code windows.
+const MIN_LAUNCH_INTERVAL: Duration = Duration::from_secs(1);
+const TITLE_CHUNK_TIMEOUT: Duration = Duration::from_secs(5);
+const MAX_TITLE_CHUNKS: usize = 512;
+const MAX_ENCODED_PAYLOAD_LEN: usize = 64 * 1024;
+
+#[derive(serde::Deserialize)]
+struct Payload {
+    herdr: String,
+    v: u32,
+    paths: Vec<PayloadPath>,
+}
+
+#[derive(serde::Deserialize)]
+struct PayloadPath {
+    p: String,
+    #[serde(default)]
+    dir: bool,
+}
+
+/// What a decoded code-open transport payload turned out to be.
+#[derive(Debug, PartialEq, Eq)]
+enum Outcome {
+    /// Not a code-open payload; forward it to the clipboard as usual.
+    NotOurs,
+    /// A code-open payload that failed validation or rate limiting. Consumed
+    /// (kept off the clipboard) but nothing is launched.
+    Rejected(String),
+    /// A valid request: open these VS Code Remote-SSH URLs.
+    Open(Vec<String>),
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum TitleChunkResult {
+    NotOurs,
+    Pending,
+    Complete(Outcome),
+    Rejected(String),
+}
+
+struct PendingTitleRequest {
+    id: String,
+    total: usize,
+    next_index: usize,
+    encoded: String,
+    updated_at: Instant,
+}
+
+pub(crate) struct CodeOpen {
+    target: String,
+    enabled: bool,
+    last_launch: Option<Instant>,
+    pending_title: Option<PendingTitleRequest>,
+}
+
+impl CodeOpen {
+    /// Build the handler for this client process. Returns `None` only when
+    /// this is not a remote attach; disabled handlers still consume magic
+    /// payloads so they never reach the host title or clipboard.
+    pub(crate) fn from_client_env(config_enabled: bool) -> Option<Self> {
+        let enabled = match std::env::var(ENV_VAR) {
+            Ok(value) => match value.trim() {
+                "1" | "true" => true,
+                "0" | "false" => false,
+                _ => config_enabled,
+            },
+            Err(_) => config_enabled,
+        };
+        let target = std::env::var(crate::remote::REMOTE_TARGET_ENV_VAR).ok()?;
+        // Keep a handler even when disabled or the target is unsupported so
+        // magic requests are consumed rather than rendered by the host.
+        Some(Self {
+            target,
+            enabled,
+            last_launch: None,
+            pending_title: None,
+        })
+    }
+
+    #[cfg(test)]
+    fn new(target: String) -> Option<Self> {
+        if !is_valid_target(&target) {
+            return None;
+        }
+        Some(Self {
+            target,
+            enabled: true,
+            last_launch: None,
+            pending_title: None,
+        })
+    }
+
+    /// Handle a legacy `ServerMessage::Clipboard` payload (base64). Returns
+    /// true when it was a code-open request; false forwards ordinary clipboard
+    /// traffic unchanged.
+    pub(crate) fn try_handle_clipboard(&mut self, data: &str) -> bool {
+        let outcome = self.evaluate(data, Instant::now());
+        self.handle_outcome(outcome)
+    }
+
+    /// Handle the chunked title-control transport used by current `hcode`.
+    /// Magic chunks are always consumed so transport data never becomes the
+    /// host terminal's visible title.
+    pub(crate) fn try_handle_window_title(&mut self, title: &str) -> bool {
+        match self.ingest_title_chunk(title, Instant::now()) {
+            TitleChunkResult::NotOurs => false,
+            TitleChunkResult::Pending => true,
+            TitleChunkResult::Complete(outcome) => self.handle_outcome(outcome),
+            TitleChunkResult::Rejected(reason) => {
+                warn!(reason, "ignored code-open title request from remote");
+                true
+            }
+        }
+    }
+
+    fn handle_outcome(&mut self, outcome: Outcome) -> bool {
+        match outcome {
+            Outcome::NotOurs => false,
+            Outcome::Rejected(reason) => {
+                warn!(reason, "ignored code-open request from remote");
+                true
+            }
+            Outcome::Open(urls) => {
+                info!(?urls, "opening VS Code for remote code-open request");
+                for url in urls {
+                    if let Err(err) = crate::platform::open_url(&url) {
+                        warn!(%err, "failed to open VS Code Remote-SSH URL");
+                    }
+                }
+                true
+            }
+        }
+    }
+
+    fn ingest_title_chunk(&mut self, title: &str, now: Instant) -> TitleChunkResult {
+        let Some(encoded_header) = title.strip_prefix(TITLE_PREFIX) else {
+            return TitleChunkResult::NotOurs;
+        };
+        if self.pending_title.as_ref().is_some_and(|pending| {
+            now.saturating_duration_since(pending.updated_at) >= TITLE_CHUNK_TIMEOUT
+        }) {
+            self.pending_title = None;
+        }
+
+        let mut fields = encoded_header.splitn(5, ':');
+        let Some((version, id, index, total, chunk)) = fields
+            .next()
+            .zip(fields.next())
+            .zip(fields.next())
+            .zip(fields.next())
+            .zip(fields.next())
+            .map(|((((version, id), index), total), chunk)| (version, id, index, total, chunk))
+        else {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("malformed title chunk".to_string());
+        };
+        if version != "1"
+            || id.is_empty()
+            || id.len() > 32
+            || !id
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+        {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("invalid title chunk header".to_string());
+        }
+        let (Ok(index), Ok(total)) = (index.parse::<usize>(), total.parse::<usize>()) else {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("invalid title chunk numbers".to_string());
+        };
+        if total == 0
+            || total > MAX_TITLE_CHUNKS
+            || index >= total
+            || chunk.is_empty()
+            || !chunk
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'/' | b'='))
+        {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("invalid title chunk bounds".to_string());
+        }
+
+        if index == 0 {
+            self.pending_title = Some(PendingTitleRequest {
+                id: id.to_string(),
+                total,
+                next_index: 0,
+                encoded: String::new(),
+                updated_at: now,
+            });
+        }
+        let Some(pending) = self.pending_title.as_mut() else {
+            return TitleChunkResult::Rejected("title chunk without a start".to_string());
+        };
+        if pending.id != id || pending.total != total || pending.next_index != index {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("out-of-order title chunk".to_string());
+        }
+        if pending.encoded.len().saturating_add(chunk.len()) > MAX_ENCODED_PAYLOAD_LEN {
+            self.pending_title = None;
+            return TitleChunkResult::Rejected("title request too large".to_string());
+        }
+        pending.encoded.push_str(chunk);
+        pending.next_index += 1;
+        pending.updated_at = now;
+        if pending.next_index < pending.total {
+            return TitleChunkResult::Pending;
+        }
+
+        let encoded = self
+            .pending_title
+            .take()
+            .expect("completed title request exists")
+            .encoded;
+        TitleChunkResult::Complete(self.evaluate(&encoded, now))
+    }
+
+    fn evaluate(&mut self, data: &str, now: Instant) -> Outcome {
+        let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(data) else {
+            return Outcome::NotOurs;
+        };
+        if !bytes.starts_with(MAGIC_PREFIX) {
+            return Outcome::NotOurs;
+        }
+
+        let payload: Payload = match serde_json::from_slice(&bytes) {
+            Ok(payload) => payload,
+            Err(err) => return Outcome::Rejected(format!("invalid payload JSON: {err}")),
+        };
+        if payload.herdr != "code-open" {
+            return Outcome::Rejected("unexpected payload kind".to_string());
+        }
+        if payload.v != SUPPORTED_VERSION {
+            return Outcome::Rejected(format!("unsupported payload version {}", payload.v));
+        }
+        if !self.enabled {
+            return Outcome::Rejected("disabled by remote.code_open".to_string());
+        }
+        if !is_valid_target(&self.target) {
+            return Outcome::Rejected("unsupported ssh target syntax".to_string());
+        }
+        if payload.paths.is_empty() {
+            return Outcome::Rejected("no paths in payload".to_string());
+        }
+        if payload.paths.len() > MAX_PATHS {
+            return Outcome::Rejected(format!("too many paths ({})", payload.paths.len()));
+        }
+
+        let mut urls = Vec::with_capacity(payload.paths.len());
+        for path in &payload.paths {
+            if let Err(reason) = validate_remote_path(&path.p) {
+                return Outcome::Rejected(format!("rejected path {:?}: {reason}", path.p));
+            }
+            urls.push(remote_url(&self.target, &path.p, path.dir));
+        }
+
+        if let Some(last) = self.last_launch {
+            if now.duration_since(last) < MIN_LAUNCH_INTERVAL {
+                return Outcome::Rejected("rate limited".to_string());
+            }
+        }
+        self.last_launch = Some(now);
+
+        Outcome::Open(urls)
+    }
+}
+
+/// The ssh target is set by our own launcher, but validate it anyway so a
+/// corrupt value can never smuggle URI or argv structure.
+fn is_valid_target(target: &str) -> bool {
+    !target.is_empty()
+        && target.len() <= 256
+        && target
+            .chars()
+            .all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '.' | '_' | '-' | '@'))
+}
+
+fn validate_remote_path(path: &str) -> Result<(), &'static str> {
+    if path.is_empty() {
+        return Err("empty");
+    }
+    if !path.starts_with('/') {
+        return Err("not absolute");
+    }
+    if path.len() > MAX_PATH_LEN {
+        return Err("too long");
+    }
+    if path.chars().any(char::is_control) {
+        return Err("contains control characters");
+    }
+    Ok(())
+}
+
+/// Percent-encode a remote absolute path for use in a VS Code URL,
+/// keeping only RFC 3986 unreserved characters and `/`.
+fn percent_encode_path(path: &str) -> String {
+    let mut encoded = String::with_capacity(path.len());
+    for byte in path.bytes() {
+        match byte {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' | b'/' => {
+                encoded.push(byte as char);
+            }
+            _ => encoded.push_str(&format!("%{byte:02X}")),
+        }
+    }
+    encoded
+}
+
+fn remote_url(target: &str, path: &str, directory: bool) -> String {
+    let mut encoded_path = percent_encode_path(path);
+    if directory {
+        if !encoded_path.ends_with('/') {
+            encoded_path.push('/');
+        }
+        // VS Code checks for an already-open matching workspace before
+        // applying this new-window fallback. Without it, an unmatched folder
+        // link may replace the active workspace, and several links can
+        // collapse into the same replacement window.
+        format!("vscode://vscode-remote/ssh-remote+{target}{encoded_path}?windowId=_blank")
+    } else {
+        // VS Code recognizes remote protocol paths as files only when they
+        // carry a line suffix. Its goto-line parser removes this marker before
+        // opening the file and naturally selects an existing containing window.
+        format!("vscode://vscode-remote/ssh-remote+{target}{encoded_path}:1")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn handler() -> CodeOpen {
+        CodeOpen::new("deb1".to_string()).expect("valid target")
+    }
+
+    fn encode(json: &str) -> String {
+        base64::engine::general_purpose::STANDARD.encode(json)
+    }
+
+    fn title_chunks(json: &str, id: &str, chunk_size: usize) -> Vec<String> {
+        let encoded = encode(json);
+        let chunks = encoded.as_bytes().chunks(chunk_size).collect::<Vec<_>>();
+        chunks
+            .iter()
+            .enumerate()
+            .map(|(index, chunk)| {
+                format!(
+                    "{TITLE_PREFIX}1:{id}:{index}:{}:{}",
+                    chunks.len(),
+                    std::str::from_utf8(chunk).expect("base64 is ASCII")
+                )
+            })
+            .collect()
+    }
+
+    #[test]
+    fn plain_clipboard_payload_is_not_ours() {
+        let mut code_open = handler();
+        assert_eq!(
+            code_open.evaluate(&encode("hello world"), Instant::now()),
+            Outcome::NotOurs
+        );
+    }
+
+    #[test]
+    fn invalid_base64_is_not_ours() {
+        let mut code_open = handler();
+        assert_eq!(
+            code_open.evaluate("not-base64!!!", Instant::now()),
+            Outcome::NotOurs
+        );
+    }
+
+    #[test]
+    fn title_chunks_reassemble_without_becoming_window_titles() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/home/u/project with spaces","dir":true}]}"#;
+        let chunks = title_chunks(payload, "1234", 24);
+        let now = Instant::now();
+        for chunk in &chunks[..chunks.len() - 1] {
+            assert_eq!(
+                code_open.ingest_title_chunk(chunk, now),
+                TitleChunkResult::Pending
+            );
+        }
+        assert_eq!(
+            code_open.ingest_title_chunk(chunks.last().unwrap(), now),
+            TitleChunkResult::Complete(Outcome::Open(vec![
+                "vscode://vscode-remote/ssh-remote+deb1/home/u/project%20with%20spaces/?windowId=_blank"
+                    .to_string(),
+            ]))
+        );
+    }
+
+    #[test]
+    fn normal_window_title_is_not_consumed() {
+        let mut code_open = handler();
+        assert_eq!(
+            code_open.ingest_title_chunk("shell: ~/project", Instant::now()),
+            TitleChunkResult::NotOurs
+        );
+    }
+
+    #[test]
+    fn malformed_and_out_of_order_title_chunks_are_consumed_and_reset() {
+        let mut code_open = handler();
+        let now = Instant::now();
+        assert!(matches!(
+            code_open.ingest_title_chunk("herdr-code-open:bad", now),
+            TitleChunkResult::Rejected(_)
+        ));
+        assert!(matches!(
+            code_open.ingest_title_chunk("herdr-code-open:1:req:1:2:YWJj", now),
+            TitleChunkResult::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn stale_title_request_cannot_accept_late_chunks() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/x","dir":true}]}"#;
+        let chunks = title_chunks(payload, "req", 20);
+        let now = Instant::now();
+        assert_eq!(
+            code_open.ingest_title_chunk(&chunks[0], now),
+            TitleChunkResult::Pending
+        );
+        assert!(matches!(
+            code_open.ingest_title_chunk(&chunks[1], now + TITLE_CHUNK_TIMEOUT),
+            TitleChunkResult::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn folder_request_builds_folder_url() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/home/u/proj","dir":true}]}"#;
+        assert_eq!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Open(vec![
+                "vscode://vscode-remote/ssh-remote+deb1/home/u/proj/?windowId=_blank".to_string(),
+            ])
+        );
+    }
+
+    #[test]
+    fn file_request_builds_file_url() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/etc/hosts","dir":false}]}"#;
+        assert_eq!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Open(vec![
+                "vscode://vscode-remote/ssh-remote+deb1/etc/hosts:1".to_string(),
+            ])
+        );
+    }
+
+    #[test]
+    fn paths_are_percent_encoded() {
+        let mut code_open = handler();
+        let payload =
+            r#"{"herdr":"code-open","v":1,"paths":[{"p":"/home/u/my dir+文","dir":true}]}"#;
+        let Outcome::Open(urls) = code_open.evaluate(&encode(payload), Instant::now()) else {
+            panic!("expected URL");
+        };
+        assert_eq!(
+            urls[0],
+            "vscode://vscode-remote/ssh-remote+deb1/home/u/my%20dir%2B%E6%96%87/?windowId=_blank"
+        );
+    }
+
+    #[test]
+    fn user_at_host_target_is_preserved() {
+        let mut code_open = CodeOpen::new("admin@deb1".to_string()).expect("valid target");
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/x","dir":true}]}"#;
+        let Outcome::Open(urls) = code_open.evaluate(&encode(payload), Instant::now()) else {
+            panic!("expected URL");
+        };
+        assert_eq!(
+            urls[0],
+            "vscode://vscode-remote/ssh-remote+admin@deb1/x/?windowId=_blank"
+        );
+    }
+
+    #[test]
