+
+    #[test]
+    fn disabled_handler_consumes_request_without_launching() {
+        let mut code_open = handler();
+        code_open.enabled = false;
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/x","dir":true}]}"#;
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn unsupported_version_is_rejected() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":2,"paths":[{"p":"/x","dir":true}]}"#;
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn malformed_magic_payload_is_consumed_not_forwarded() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":"#; // truncated JSON
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn too_many_paths_are_rejected() {
+        let mut code_open = handler();
+        let entries: Vec<String> = (0..9)
+            .map(|i| format!(r#"{{"p":"/d{i}","dir":true}}"#))
+            .collect();
+        let payload = format!(
+            r#"{{"herdr":"code-open","v":1,"paths":[{}]}}"#,
+            entries.join(",")
+        );
+        assert!(matches!(
+            code_open.evaluate(&encode(&payload), Instant::now()),
+            Outcome::Rejected(_)
+        ));
+    }
+
+    #[test]
+    fn repeat_requests_are_rate_limited() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/x","dir":true}]}"#;
+        let now = Instant::now();
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), now),
+            Outcome::Open(_)
+        ));
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), now + Duration::from_millis(200)),
+            Outcome::Rejected(_)
+        ));
+        assert!(matches!(
+            code_open.evaluate(&encode(payload), now + Duration::from_millis(1200)),
+            Outcome::Open(_)
+        ));
+    }
+
+    #[test]
+    fn multiple_paths_build_multiple_urls() {
+        let mut code_open = handler();
+        let payload = r#"{"herdr":"code-open","v":1,"paths":[{"p":"/a","dir":true},{"p":"/b/f.txt","dir":false}]}"#;
+        assert_eq!(
+            code_open.evaluate(&encode(payload), Instant::now()),
+            Outcome::Open(vec![
+                "vscode://vscode-remote/ssh-remote+deb1/a/?windowId=_blank".to_string(),
+                "vscode://vscode-remote/ssh-remote+deb1/b/f.txt:1".to_string(),
+            ])
+        );
+    }
+
+    #[test]
+    fn hostile_target_values_are_refused() {
+        assert!(CodeOpen::new(String::new()).is_none());
+        assert!(CodeOpen::new("host/../x".to_string()).is_none());
+        assert!(CodeOpen::new("host name".to_string()).is_none());
+        assert!(CodeOpen::new("host\u{7}".to_string()).is_none());
+        assert!(CodeOpen::new("host?query".to_string()).is_none());
+    }
+}
