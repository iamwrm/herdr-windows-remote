+    #[derive(Clone, Default)]
+    struct SharedSink(Arc<std::sync::Mutex<Vec<u8>>>);
+
+    impl io::Write for SharedSink {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            self.0.lock().expect("sink lock").extend_from_slice(buf);
+            Ok(buf.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    fn pipe_pair(name: &str) -> (LocalStream, LocalStream) {
+        use interprocess::local_socket::traits::Listener as _;
+        let path = std::env::temp_dir().join(format!(
+            "herdr-pump-test-{name}-{}.sock",
+            std::process::id()
+        ));
+        let listener = crate::ipc::bind_local_listener(&path).expect("bind");
+        let client = crate::ipc::connect_local_stream(&path).expect("connect");
+        let server = listener.accept().expect("accept");
+        let _ = fs::remove_file(&path);
+        (client, server)
+    }
+
+    #[test]
+    fn pump_forwards_client_bytes_and_exits_on_client_close() {
+        use std::io::Write as _;
+
+        let (mut client, server) = pipe_pair("forward");
+        let sink = SharedSink::default();
+        let mut pump_sink = sink.clone();
+        let stop = Arc::new(AtomicBool::new(false));
+        let pump_stop = Arc::clone(&stop);
+        let pump = thread::spawn(move || {
+            pump_client_to_ssh(&server, &mut pump_sink, &pump_stop);
+        });
+
+        client.write_all(b"keystrokes").expect("client write");
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        while sink.0.lock().expect("sink lock").len() < 10 {
+            assert!(std::time::Instant::now() < deadline, "pump never forwarded");
+            thread::sleep(Duration::from_millis(1));
+        }
+        assert_eq!(sink.0.lock().expect("sink lock").as_slice(), b"keystrokes");
+
+        // Client close must end the pump without any cancel.
+        drop(client);
+        pump.join().expect("pump thread");
+    }
+
+    #[test]
+    fn pump_blocked_in_read_is_released_by_cancel() {
+        let (client, server) = pipe_pair("cancel");
+        let server = Arc::new(server);
+        let pump_stream = Arc::clone(&server);
+        let stop = Arc::new(AtomicBool::new(false));
+        let pump_stop = Arc::clone(&stop);
+        let pump = thread::spawn(move || {
+            pump_client_to_ssh(&pump_stream, &mut io::sink(), &pump_stop);
+        });
+
+        // Let the pump enter its blocking read, then stop it the way
+        // bridge_connection does.
+        thread::sleep(Duration::from_millis(50));
+        assert!(!pump.is_finished(), "pump must be blocked in read");
+        stop.store(true, Ordering::Release);
+        cancel_blocking_pipe_read(&server, &pump);
+        pump.join().expect("pump thread");
+        drop(client);
+    }
