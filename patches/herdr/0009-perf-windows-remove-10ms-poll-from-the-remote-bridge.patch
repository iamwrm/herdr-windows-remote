+/// Repeatedly cancels in-flight I/O on the pipe until the pump thread exits.
+/// The caller must have set the pump's stop flag first, so a cancel that
+/// lands between two reads is followed by a clean flag-observed exit instead
+/// of another blocking read racing the next cancel forever.
+///
+/// Uses `CancelIoEx` on the pipe handle — not `CancelSynchronousIo` on the
+/// thread — because interprocess implements "sync" named-pipe reads as
+/// overlapped I/O awaited internally, which is invisible to the synchronous
+/// cancel API. The cancelled read surfaces as `ERROR_OPERATION_ABORTED`.
+fn cancel_blocking_pipe_read(stream: &LocalStream, thread: &JoinHandle<()>) {
+    use std::os::windows::io::{AsHandle as _, AsRawHandle as _};
+
+    let LocalStream::NamedPipe(pipe) = stream;
+    while !thread.is_finished() {
+        // CancelIoEx returns ERROR_NOT_FOUND when no I/O is in flight at
+        // this instant; harmless, retry until the stop flag is observed.
+        let _ = unsafe {
+            windows_sys::Win32::System::IO::CancelIoEx(
+                pipe.as_handle().as_raw_handle(),
+                std::ptr::null(),
+            )
+        };
+        thread::sleep(CANCEL_RETRY);
+    }
+}
