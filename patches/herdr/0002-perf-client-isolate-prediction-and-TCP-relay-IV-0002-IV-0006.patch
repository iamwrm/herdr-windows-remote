+                .checked_sub(AUTO_MIN_LATENCY + Duration::from_millis(1))
+                .expect("past")
+        } else {
+            Instant::now()
+                .checked_add(AUTO_MIN_LATENCY)
+                .expect("future")
+        };
+        let cells = confirmed_text
+            .chars()
