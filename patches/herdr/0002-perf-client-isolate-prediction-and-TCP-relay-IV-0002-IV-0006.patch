+    struct ScriptedWriter<'a> {
+        now: &'a std::cell::Cell<Instant>,
+        steps: std::collections::VecDeque<Result<usize, io::ErrorKind>>,
+        bytes: Vec<u8>,
+    }
+
+    impl io::Write for ScriptedWriter<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            self.now.set(self.now.get() + Duration::from_secs(2));
+            let count = self.steps.pop_front().expect("scripted write attempt")?;
+            self.bytes.extend_from_slice(&bytes[..count]);
+            Ok(count)
+        }
+
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn progressing_frame_can_outlast_the_write_timeout() {
+        let started = Instant::now();
+        let now = std::cell::Cell::new(started);
+        let mut writer = ScriptedWriter {
+            now: &now,
+            steps: [Ok(1), Err(io::ErrorKind::WouldBlock)]
+                .into_iter()
+                .cycle()
+                .take(11)
+                .collect(),
+            bytes: Vec::new(),
+        };
+        write_frame_with_clock(&mut writer, b"abcdef", &AtomicBool::new(false), || {
+            now.get()
+        })
+        .expect("ongoing progress must renew the inactivity deadline");
+        assert!(now.get().duration_since(started) > WRITE_TIMEOUT);
+        assert_eq!(writer.bytes, b"abcdef");
+    }
+
+    #[test]
+    fn frame_times_out_when_progress_stops() {
+        for blocked in [Ok(0), Err(io::ErrorKind::WouldBlock)] {
+            let now = std::cell::Cell::new(Instant::now());
+            let mut writer = ScriptedWriter {
+                now: &now,
+                steps: [Ok(1), blocked, blocked, blocked].into(),
+                bytes: Vec::new(),
+            };
+            let error =
+                write_frame_with_clock(&mut writer, b"ab", &AtomicBool::new(false), || now.get())
+                    .unwrap_err();
+            assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+            assert_eq!(writer.bytes, b"a");
+            assert!(
+                writer.steps.is_empty(),
+                "timeout starts at the last progress"
+            );
+        }
+    }
