diff --git a/src/client/predict.rs b/src/client/predict.rs
new file mode 100644
index 00000000..b4f8bb22
--- /dev/null
+++ b/src/client/predict.rs
@@ -0,0 +1,1341 @@
+//! Predictive local echo for remote attach (i0002 W3, mosh-style).
+//!
+//! On a high-RTT link every keystroke takes a full round trip before it
+//! echoes. When the typing context is safe (plain cells with a visible
+//! hardware cursor, or matching color-only cells with a reverse-video
+//! software cursor, plus room before the right margin) the client draws the typed
+//! character immediately — underlined, like mosh — and reconciles against
+//! the frames the server sends later:
+//!
+//! - the server echoes the same character into the predicted cell, or moves
+//!   its cursor past an unchanged cell such as a blank space → the prediction
+//!   is confirmed (cursor-only confirmations are explicitly repainted to drop
+//!   the local underline);
+//! - the server writes something else there → all outstanding predictions
+//!   are repainted from the [`ScreenModel`] (the server's truth) — this is
+//!   why the model exists: the server diffs against *its* idea of the
+//!   screen and would never repaint a wrongly-predicted cell it did not
+//!   touch;
+//! - a prediction stays unconfirmed too long → same repaint, so stalls
+//!   cannot leave stale artifacts.
+//!
+//! Modes (`remote.predictive_echo`, env `HERDR_PREDICTIVE_ECHO`):
+//! `off` — fully disabled, byte-for-byte today's behavior; `always` — draw
+//! from the first keystroke; `auto` (default) — predictions are tracked
+//! invisibly until two of them are confirmed with an echo delay above
+//! [`AUTO_MIN_LATENCY`], so fast links never see underlines and broken
+//! contexts never draw at all.
+//!
+//! Only printable width-1 characters (optionally shifted) and backspace
+//! over our own predictions are predicted. Any other key press flushes
+//! outstanding predictions back to server truth.
+
+use std::collections::VecDeque;
+use std::io::Write;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use super::screen_model::ScreenModel;
+#[cfg(test)]
+use crate::protocol::TerminalFrame;
+
+/// The plain pen (matches `render_ansi::build_sgr` for an unstyled cell).
+const PLAIN_SGR: &str = "\x1b[0;39;49m";
+/// Prediction pen: underline over default colors.
+const UNDERLINE_SGR: &str = "\x1b[0;4;39;49m";
+/// Maximum keystrokes predicted ahead of the last confirmation.
+const MAX_PENDING: usize = 8;
+/// Unconfirmed predictions older than this are flushed back to server truth.
+const PREDICTION_TIMEOUT: Duration = Duration::from_secs(5);
+/// `auto` starts drawing after this many confirmed predictions…
+const AUTO_MIN_CONFIRMED: u64 = 2;
+/// …whose echo delay exceeded this (fast links never show predictions).
+const AUTO_MIN_LATENCY: Duration = Duration::from_millis(60);
+
+const ENV_VAR: &str = "HERDR_PREDICTIVE_ECHO";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PredictiveEchoMode {
+    Off,
+    Auto,
+    Always,
+}
+
+impl PredictiveEchoMode {
+    pub(crate) fn from_config(config_value: &str) -> Self {
+        let value = std::env::var(ENV_VAR)
+            .ok()
+            .filter(|value| !value.trim().is_empty())
+            .unwrap_or_else(|| config_value.to_string());
+        match value.trim().to_ascii_lowercase().as_str() {
+            "off" | "false" | "0" => Self::Off,
+            "always" => Self::Always,
+            _ => Self::Auto,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum PredictionCursor {
+    Hardware,
+    Software { base_sgr: Arc<str> },
+}
+
+#[derive(Debug)]
+struct Prediction {
+    x: u16,
+    y: u16,
+    ch: char,
+    cursor: PredictionCursor,
+    /// Whether the local underlined overlay is still visible. A matching
+    /// server cell write clears it even if FIFO retirement is blocked by an
+    /// earlier cursor-only prediction.
+    drawn: bool,
+    /// Cumulative server acknowledgement; unlike `touched`, this survives
+    /// across frames until older predictions retire.
+    observed: bool,
+    sent_at: Instant,
+}
+
+pub(crate) struct Predictor {
+    model: ScreenModel,
+    pending: VecDeque<Prediction>,
+    /// An input could not be predicted, so the model is stale until another
+    /// server frame arrives. Never start a second prediction chain from that
+    /// stale cursor.
+    blocked_until_frame: bool,
+    display_unlocked: bool,
+    slow_confirmed: u64,
+    touched_scratch: Vec<(u16, u16)>,
+}
+
+impl Predictor {
+    /// Returns `None` for [`PredictiveEchoMode::Off`], so the client loop
+    /// carries no prediction state at all when disabled.
+    pub(crate) fn new(mode: PredictiveEchoMode) -> Option<Self> {
+        if mode == PredictiveEchoMode::Off {
+            return None;
+        }
+        Some(Self {
+            model: ScreenModel::new(),
+            pending: VecDeque::new(),
+            blocked_until_frame: false,
+            display_unlocked: mode == PredictiveEchoMode::Always,
+            slow_confirmed: 0,
+            touched_scratch: Vec::new(),
+        })
+    }
+
+    /// Semantic pane input after local UI routing.
+    pub(crate) fn on_input_events(
+        &mut self,
+        events: &[crate::protocol::ClientPaneInputEvent],
+    ) -> Vec<u8> {
+        use crate::protocol::{
+            ClientKeyCode, ClientKeyKind, ClientPaneInputEvent as ClientInputEvent,
+        };
+
+        const SHIFT: u8 = 0b1;
+        let mut out = Vec::new();
+        for event in events {
+            match event {
+                ClientInputEvent::Key {
+                    code,
+                    modifiers,
+                    kind: ClientKeyKind::Press | ClientKeyKind::Repeat,
+                    ..
+                } => match code {
+                    ClientKeyCode::Char(ch) if modifiers & !SHIFT == 0 => {
+                        self.on_char(*ch, &mut out);
+                    }
+                    ClientKeyCode::Backspace if *modifiers == 0 => {
+                        self.on_backspace(&mut out);
+                    }
+                    _ => self.on_other_input(&mut out),
+                },
+                ClientInputEvent::TextCommit(_)
+                | ClientInputEvent::Paste(..)
+                | ClientInputEvent::Mouse { .. } => {
+                    self.on_other_input(&mut out);
+                }
+                // Key releases do not act on the remote application and must
+                // not interrupt a prediction chain. Focus notifications are
+                // likewise harmless to the modeled cursor.
+                _ => {}
+            }
+        }
+        out
+    }
+
+    /// A printable character was typed. Predicts and (when unlocked) draws
+    /// it underlined at the predicted insertion point.
+    fn on_char(&mut self, ch: char, out: &mut impl Write) {
+        use unicode_width::UnicodeWidthChar as _;
+
+        if self.blocked_until_frame {
+            return;
+        }
+        if self.pending.len() >= MAX_PENDING {
+            self.stop_predicting_until_frame(out);
+            return;
+        }
+        if ch.is_control() || ch.width() != Some(1) {
+            self.stop_predicting_until_frame(out);
+            return;
+        }
+        let Some(cursor) = self.prediction_cursor() else {
+            self.stop_predicting_until_frame(out);
+            return;
+        };
+        let (x, y) = self.insertion_point();
+        if y != self.model.cursor().1 || x + 1 >= self.model.width() {
+            self.stop_predicting_until_frame(out);
+            return;
+        }
+        let safe_target = match &cursor {
+            PredictionCursor::Hardware => self.cell_is_plain(x, y) && self.cell_is_plain(x + 1, y),
+            PredictionCursor::Software { base_sgr } => {
+                let first = self.pending.is_empty();
+                self.cell_has_base_style(x, y, base_sgr, first)
+                    && self.cell_has_base_style(x + 1, y, base_sgr, false)
+            }
+        };
+        if !safe_target {
+            self.stop_predicting_until_frame(out);
+            return;
+        }
+
+        let drawn = self.display_unlocked;
+        if drawn {
+            match &cursor {
+                PredictionCursor::Hardware => {
+                    let _ = write!(
+                        out,
+                        "\x1b[{};{}H{UNDERLINE_SGR}{ch}{PLAIN_SGR}",
+                        y + 1,
+                        x + 1
+                    );
+                }
+                PredictionCursor::Software { base_sgr } => {
+                    self.draw_software_prediction(out, x, y, ch, base_sgr);
+                }
+            }
+        }
+        self.pending.push_back(Prediction {
+            x,
+            y,
+            ch,
+            cursor,
+            drawn,
+            observed: false,
+            sent_at: Instant::now(),
+        });
+    }
+
+    /// Backspace is only predicted over our own outstanding predictions.
+    fn on_backspace(&mut self, out: &mut impl Write) {
+        let Some(prediction) = self.pending.pop_back() else {
+            self.blocked_until_frame = true;
+            return;
+        };
+        if prediction.drawn {
+            self.repaint_model_cell(out, prediction.x, prediction.y);
+            match prediction.cursor {
+                PredictionCursor::Hardware => {
+                    let _ = write!(
+                        out,
+                        "\x1b[{row};{col}H",
+                        row = prediction.y + 1,
+                        col = prediction.x + 1,
+                    );
+                }
+                PredictionCursor::Software { .. } => self.redraw_software_pending(out),
+            }
+        }
+    }
+
+    /// Any other key press invalidates the cursor used by this prediction
+    /// chain. Restore server truth and wait for a fresh frame before trying
+    /// to predict again.
+    fn on_other_input(&mut self, out: &mut impl Write) {
+        self.stop_predicting_until_frame(out);
+    }
+
+    pub(crate) fn on_resize(&mut self) -> Vec<u8> {
+        let mut out = Vec::new();
+        self.stop_predicting_until_frame(&mut out);
+        out
+    }
+
+    /// Applies a received frame to the model and returns bytes that must be
+    /// written after (or inserted at the end of) that frame.
+    #[cfg(test)]
+    pub(crate) fn on_frame(&mut self, frame: &TerminalFrame) -> Vec<u8> {
+        self.on_encoded_frame(&frame.bytes, frame.width, frame.height, frame.full)
+    }
+    pub(crate) fn on_encoded_frame(
+        &mut self,
+        bytes: &[u8],
+        width: u16,
+        height: u16,
+        full: bool,
+    ) -> Vec<u8> {
+        let mut out = Vec::new();
+        self.model.ensure_size(width, height);
+        if full {
+            self.model.begin_full_frame();
+        }
+        let mut touched = std::mem::take(&mut self.touched_scratch);
+        touched.clear();
+        self.model.apply(bytes, &mut touched);
+
+        if !self.model.prediction_safe() {
+            if full {
+                self.pending.clear();
+            } else {
+                self.stop_predicting_until_frame(&mut out);
+            }
+            self.blocked_until_frame = true;
+            self.touched_scratch = touched;
+            return out;
+        }
+        self.blocked_until_frame = false;
+
+        if full {
+            // The redraw repainted every cell; the screen is server truth.
+            self.pending.clear();
+            self.touched_scratch = touched;
+            return out;
+        }
+
+        // Record observations before any conservative abort so repaint
+        // cleanup cannot overwrite cells the raw frame already styled. Cursor
+        // progress acknowledges unchanged cells such as a blank space.
+        let (server_x, server_y) = self.model.cursor();
+        let cursor_valid = self.server_cursor_matches_chain();
+        let model = &self.model;
+        let mut observed_mismatch = false;
+        for prediction in &mut self.pending {
+            let cell_touched = touched.contains(&(prediction.x, prediction.y));
+            let cursor_passed = cursor_valid && server_y == prediction.y && server_x > prediction.x;
+            let software_caret_waiting =
+                matches!(prediction.cursor, PredictionCursor::Software { .. })
+                    && cursor_valid
+                    && server_x == prediction.x
+                    && server_y == prediction.y;
+            if cell_touched {
+                prediction.drawn = false;
+            }
+            if software_caret_waiting {
+                // Prime Agent repaints its reverse-video caret over the first
+                // unacknowledged prediction. It is cursor state, not a
+                // conflicting character write; redraw the local suffix below.
+                continue;
+            }
+            if !cell_touched && !cursor_passed {
+                continue;
+            }
+            let matches = model
+                .cell(prediction.x, prediction.y)
+                .is_some_and(|cell| cell.symbol.chars().eq(std::iter::once(prediction.ch)));
+            if matches {
+                prediction.observed = true;
+            } else {
+                observed_mismatch = true;
+            }
+        }
+
+        // A row jump or cursor representation change is not a safe
+        // continuation of this prediction chain. Software-cursor chains
+        // deliberately accept a hidden hardware cursor only while the model
+        // contains the matching reverse-video caret at that position.
+        if !self.pending.is_empty()
+            && (!cursor_valid || server_y != self.pending.front().expect("pending exists").y)
+        {
+            self.stop_predicting_until_frame(&mut out);
+            self.touched_scratch = touched;
+            return out;
+        }
+
+        let now = Instant::now();
+        let mut repainted_confirmation = false;
+        // Observations are cumulative. Cursor progress confirms visually
+        // unchanged characters such as a space typed over an already-blank
+        // cell, while later touched predictions no longer lose their evidence
+        // behind that space.
+        while self.pending.front().is_some_and(|front| front.observed) {
+            let front = self.pending.pop_front().expect("front exists");
+            if front.drawn {
+                // A cursor-only acknowledgement did not repaint the local
+                // underline. Explicitly restore the now-confirmed cell.
+                self.repaint_model_cell(&mut out, front.x, front.y);
+                repainted_confirmation = true;
+            }
+            if now.saturating_duration_since(front.sent_at) >= AUTO_MIN_LATENCY {
+                self.slow_confirmed += 1;
+                if self.slow_confirmed >= AUTO_MIN_CONFIRMED {
+                    self.display_unlocked = true;
+                }
+            }
+        }
+
+        let mispredicted = observed_mismatch || self.prediction_timed_out(now);
+
+        if mispredicted {
+            self.stop_predicting_until_frame(&mut out);
+        } else if self.display_unlocked
+            && matches!(
+                self.pending.front().map(|prediction| &prediction.cursor),
+                Some(PredictionCursor::Software { .. })
+            )
+        {
+            // A server frame can overwrite the application's software caret and
+            // the first pending overlay, so redraw the whole suffix.
+            self.redraw_software_pending(&mut out);
+        } else if self.pending.iter().any(|prediction| prediction.drawn) {
+            // Hardware-cursor predictions retain their cheaper cursor-only
+            // reanchor when matching server writes removed earlier overlays.
+            self.reanchor_pending(&mut out);
+        } else if repainted_confirmation {
+            let (x, y) = self.model.cursor();
+            let sgr = self
+                .model
+                .cell(x, y)
+                .map_or(PLAIN_SGR, |cell| cell.sgr.as_ref());
+            let _ = write!(out, "{sgr}\x1b[{};{}H", y + 1, x + 1);
+        }
+        self.touched_scratch = touched;
+        out
+    }
+
+    /// Timeouts must fire even when the server becomes idle; otherwise a
+    /// stale prediction remains until the next key happens to produce a frame.
+    pub(crate) fn on_timer(&mut self) -> Vec<u8> {
+        let mut out = Vec::new();
+        if self.prediction_timed_out(Instant::now()) {
+            self.stop_predicting_until_frame(&mut out);
+        }
+        out
+    }
+
+    fn prediction_timed_out(&self, now: Instant) -> bool {
+        self.pending
+            .front()
+            .is_some_and(|front| now.saturating_duration_since(front.sent_at) >= PREDICTION_TIMEOUT)
+    }
+
+    fn stop_predicting_until_frame(&mut self, out: &mut impl Write) {
+        self.flush_repaint(out);
+        self.blocked_until_frame = true;
+    }
+
+    fn insertion_point(&self) -> (u16, u16) {
+        match self.pending.back() {
+            Some(prediction) => ((prediction.x + 1).min(self.model.width()), prediction.y),
+            None => self.model.cursor(),
+        }
+    }
+
+    fn cell_is_plain(&self, x: u16, y: u16) -> bool {
+        self.model.cell(x, y).is_some_and(|cell| cell.plain)
+    }
+
+    fn cell_has_base_style(&self, x: u16, y: u16, base_sgr: &str, reversed: bool) -> bool {
+        self.model
+            .cell(x, y)
+            .and_then(|cell| cell.prediction_style.as_ref())
+            .is_some_and(|style| style.base_sgr.as_ref() == base_sgr && style.reversed == reversed)
+    }
+
+    fn prediction_cursor(&self) -> Option<PredictionCursor> {
+        if let Some(prediction) = self.pending.front() {
+            return Some(prediction.cursor.clone());
+        }
+        if self.model.cursor_visible() {
+            return Some(PredictionCursor::Hardware);
+        }
+        let (x, y) = self.model.cursor();
+        if x + 1 >= self.model.width() {
+            return None;
+        }
+        let caret = self.model.cell(x, y)?.prediction_style.as_ref()?;
+        let next = self.model.cell(x + 1, y)?.prediction_style.as_ref()?;
+        (caret.reversed && !next.reversed && caret.base_sgr == next.base_sgr).then(|| {
+            PredictionCursor::Software {
+                base_sgr: caret.base_sgr.clone(),
+            }
+        })
+    }
+
+    fn server_cursor_matches_chain(&self) -> bool {
+        let Some(prediction) = self.pending.front() else {
+            return true;
+        };
+        match &prediction.cursor {
+            PredictionCursor::Hardware => self.model.cursor_visible(),
+            PredictionCursor::Software { base_sgr } => {
+                if self.model.cursor_visible() {
+                    return false;
+                }
+                let (x, y) = self.model.cursor();
+                self.cell_has_base_style(x, y, base_sgr, true)
+            }
+        }
+    }
+
+    fn model_symbol(&self, x: u16, y: u16) -> String {
+        match self.model.cell(x, y) {
+            Some(cell) if !cell.symbol.is_empty() => cell.symbol.clone(),
+            _ => " ".to_string(),
+        }
+    }
+
+    fn repaint_model_cell(&self, out: &mut impl Write, x: u16, y: u16) {
+        let symbol = self.model_symbol(x, y);
+        let sgr = self
+            .model
+            .cell(x, y)
+            .map_or(PLAIN_SGR, |cell| cell.sgr.as_ref());
+        let _ = write!(out, "\x1b[{};{}H{sgr}{symbol}", y + 1, x + 1);
+    }
+
+    fn sgr_with_modifier(base_sgr: &str, modifier: &str) -> String {
+        base_sgr.replacen("\x1b[0;", &format!("\x1b[0;{modifier};"), 1)
+    }
+
+    fn draw_software_prediction(
+        &self,
+        out: &mut impl Write,
+        x: u16,
+        y: u16,
+        ch: char,
+        base_sgr: &str,
+    ) {
+        let underline_sgr = Self::sgr_with_modifier(base_sgr, "4");
+        let reverse_sgr = Self::sgr_with_modifier(base_sgr, "7");
+        let caret_symbol = self.model_symbol(x + 1, y);
+        let _ = write!(
+            out,
+            "\x1b[{};{}H{underline_sgr}{ch}{reverse_sgr}{caret_symbol}{base_sgr}\x1b[{};{}H",
+            y + 1,
+            x + 1,
+            y + 1,
+            x + 2,
+        );
+    }
+
+    fn redraw_software_pending(&mut self, out: &mut impl Write) {
+        let Some(PredictionCursor::Software { base_sgr }) = self
+            .pending
+            .front()
+            .map(|prediction| prediction.cursor.clone())
+        else {
+            return;
+        };
+        let underline_sgr = Self::sgr_with_modifier(&base_sgr, "4");
+        for prediction in &mut self.pending {
+            let _ = write!(
+                out,
+                "\x1b[{};{}H{underline_sgr}{}",
+                prediction.y + 1,
+                prediction.x + 1,
+                prediction.ch,
+            );
+            prediction.drawn = true;
+        }
+        let (x, y) = self.insertion_point();
+        let reverse_sgr = Self::sgr_with_modifier(&base_sgr, "7");
+        let symbol = self.model_symbol(x, y);
+        let _ = write!(
+            out,
+            "\x1b[{};{}H{reverse_sgr}{symbol}{base_sgr}\x1b[{};{}H",
+            y + 1,
+            x + 1,
+            y + 1,
+            x + 1,
+        );
+    }
+
+    /// Repaints every drawn prediction with the model's (server-truth)
+    /// content and parks the host cursor back at the server's position.
+    fn flush_repaint(&mut self, out: &mut impl Write) {
+        let software_caret = self.pending.front().and_then(|prediction| {
+            (self.display_unlocked
+                && matches!(prediction.cursor, PredictionCursor::Software { .. }))
+            .then(|| self.insertion_point())
+        });
+        let mut wrote = false;
+        while let Some(prediction) = self.pending.pop_front() {
+            if !prediction.drawn {
+                continue;
+            }
+            self.repaint_model_cell(out, prediction.x, prediction.y);
+            wrote = true;
+        }
+        if let Some((x, y)) = software_caret {
+            self.repaint_model_cell(out, x, y);
+            wrote = true;
+        }
+        if wrote {
+            let (x, y) = self.model.cursor();
+            let _ = write!(out, "\x1b[{};{}H", y + 1, x + 1);
+        }
+    }
+
+    fn reanchor_pending(&self, out: &mut impl Write) {
+        let (x, y) = self.insertion_point();
+        let _ = write!(
+            out,
+            "{PLAIN_SGR}\x1b[{};{}H",
+            y + 1,
+            x.min(self.model.width().saturating_sub(1)) + 1
+        );
+    }
+}
