--- /dev/null
+++ b/src/client/screen_model.rs
@@ -0,0 +1,860 @@
+//! Client-side mirror of the terminal-ansi frame stream (i0002 W3).
+//!
+//! Terminal-ansi clients normally blit server frame bytes to stdout without
+//! understanding them. Predictive local echo needs to know what is on screen
+//! (cursor position, cell contents and styling), so this model replays every
+//! received `TerminalFrame` into a cell grid.
+//!
+//! The frame stream is produced exclusively by `protocol::render_ansi::
+//! BlitEncoder`, whose output vocabulary is small and contains **no scrolling
+//! and no relative cursor motion**. Cell runs begin at an absolute `CUP`;
+//! a width-1 cell may let the following cell continue inline. Printable runs
+//! are split at Unicode extended grapheme boundaries before updating cells.
+//! The parser below handles that vocabulary — CUP, SGR, `2J` clear, `?25 h/l` cursor
+//! visibility, `?2026 h/l` sync markers, DECSCUSR, OSC (hyperlinks,
+//! clipboard) and APC (Kitty graphics) passthrough — and ignores everything
+//! else. Round-trip tests validate the model against `BlitEncoder` output of
+//! reference frames.
+
+use std::sync::Arc;
+
+/// The SGR sequence `build_sgr` emits for a completely unstyled cell.
+const PLAIN_SGR: &str = "\x1b[0;39;49m";
+
+/// A cell style safe for predictive echo. Colors are preserved, while the
+/// only accepted modifier is reverse video (used by software cursors).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct PredictionStyle {
+    pub(crate) base_sgr: Arc<str>,
+    pub(crate) reversed: bool,
+}
+
+#[derive(Clone, Debug)]
+struct PenStyle {
+    sgr: Arc<str>,
+    prediction: Option<PredictionStyle>,
+}
+
+impl PenStyle {
+    fn plain() -> Self {
+        Self {
+            sgr: Arc::from(PLAIN_SGR),
+            prediction: Some(PredictionStyle {
+                base_sgr: Arc::from(PLAIN_SGR),
+                reversed: false,
+            }),
+        }
+    }
+
+    fn unknown() -> Self {
+        Self {
+            sgr: Arc::from(PLAIN_SGR),
+            prediction: None,
+        }
+    }
+}
+
+/// Parses the complete canonical SGR emitted by `render_ansi::build_sgr`.
+/// Retaining only colors and an optional reverse modifier keeps software
+/// cursor detection strict while supporting indexed and RGB themes.
+fn parse_pen_style(params: &str) -> PenStyle {
+    if matches!(params, "" | "0") {
+        return PenStyle::plain();
+    }
+
+    let sgr: Arc<str> = format!("\x1b[{params}m").into();
+    let parts = params.split(';').collect::<Vec<_>>();
+    if parts.first() != Some(&"0") {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let Some(fg_start) = parts
+        .iter()
+        .enumerate()
+        .skip(1)
+        .find_map(|(index, part)| is_fg_start(part).then_some(index))
+    else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+
+    let modifiers = &parts[1..fg_start];
+    let reversed = modifiers == ["7"];
+    if !modifiers.is_empty() && !reversed {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let Some(fg_end) = color_end(&parts, fg_start, true) else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+    let Some(bg_end) = color_end(&parts, fg_end, false) else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+    if bg_end != parts.len() {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let base_sgr: Arc<str> = format!(
+        "\x1b[0;{};{}m",
+        parts[fg_start..fg_end].join(";"),
+        parts[fg_end..bg_end].join(";")
+    )
+    .into();
+    PenStyle {
+        sgr,
+        prediction: Some(PredictionStyle { base_sgr, reversed }),
+    }
+}
+
+fn is_fg_start(part: &str) -> bool {
+    part.parse::<u16>()
+        .is_ok_and(|value| (30..=39).contains(&value) || (90..=97).contains(&value))
+}
+
+fn is_bg_start(part: &str) -> bool {
+    part.parse::<u16>()
+        .is_ok_and(|value| (40..=49).contains(&value) || (100..=107).contains(&value))
+}
+
+fn color_end(parts: &[&str], start: usize, foreground: bool) -> Option<usize> {
+    let part = *parts.get(start)?;
+    let extended = if foreground { "38" } else { "48" };
+    if part == extended {
+        return match parts.get(start + 1).copied() {
+            Some("5") if parts.get(start + 2)?.parse::<u8>().is_ok() => Some(start + 3),
+            Some("2")
+                if parts.get(start + 2)?.parse::<u8>().is_ok()
+                    && parts.get(start + 3)?.parse::<u8>().is_ok()
+                    && parts.get(start + 4)?.parse::<u8>().is_ok() =>
+            {
+                Some(start + 5)
+            }
+            _ => None,
+        };
+    }
+    let simple = if foreground {
+        is_fg_start(part)
+    } else {
+        is_bg_start(part)
+    };
+    simple.then_some(start + 1)
+}
+
+/// One mirrored cell.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ModelCell {
+    /// Grapheme cluster displayed in the cell. Blank cells hold `" "`.
+    pub(crate) symbol: String,
+    /// Whether the cell was written with the plain pen (default colors, no
+    /// modifiers, no hyperlink).
+    pub(crate) plain: bool,
+    /// Exact canonical SGR emitted before this cell.
+    pub(crate) sgr: Arc<str>,
+    /// Safe colors and reverse-video state, if no other modifier or hyperlink
+    /// makes local prediction ambiguous.
+    pub(crate) prediction_style: Option<PredictionStyle>,
+}
+
+impl ModelCell {
+    fn blank() -> Self {
+        Self {
+            symbol: " ".to_string(),
+            plain: true,
+            sgr: Arc::from(PLAIN_SGR),
+            prediction_style: PenStyle::plain().prediction,
+        }
+    }
+
+    /// Wide-character continuation cells: covered by the cell to their left.
+    fn continuation() -> Self {
+        Self {
+            symbol: String::new(),
+            plain: false,
+            sgr: Arc::from(PLAIN_SGR),
+            prediction_style: None,
+        }
+    }
+}
+
+pub(crate) struct ScreenModel {
+    width: u16,
+    height: u16,
+    cells: Vec<ModelCell>,
+    /// 0-based (col, row) of the host cursor after the last applied frame.
+    cursor: (u16, u16),
+    cursor_visible: bool,
+    /// Current canonical SGR and its prediction-safe interpretation.
+    pen: PenStyle,
+    /// Whether an OSC 8 hyperlink is currently open.
+    hyperlink_open: bool,
+    /// False after standalone zero-width output, whose host-terminal cell
+    /// effect cannot be represented safely for prediction reconciliation.
+    prediction_safe: bool,
+}
+
+impl ScreenModel {
+    pub(crate) fn new() -> Self {
+        Self {
+            width: 0,
+            height: 0,
+            cells: Vec::new(),
+            cursor: (0, 0),
+            cursor_visible: false,
+            pen: PenStyle::unknown(),
+            hyperlink_open: false,
+            prediction_safe: true,
+        }
+    }
+
+    pub(crate) fn ensure_size(&mut self, width: u16, height: u16) {
+        if self.width == width && self.height == height {
+            return;
+        }
+        self.width = width;
+        self.height = height;
+        self.cells = vec![ModelCell::blank(); width as usize * height as usize];
+        self.cursor = (0, 0);
+        self.cursor_visible = false;
+        self.prediction_safe = true;
+    }
+
+    /// A full frame replaces prior screen truth, so it can recover from an
+    /// earlier unmodelable zero-width write unless this frame contains one too.
+    pub(crate) fn begin_full_frame(&mut self) {
+        self.prediction_safe = true;
+    }
+
+    pub(crate) fn prediction_safe(&self) -> bool {
+        self.prediction_safe
+    }
+
+    pub(crate) fn cursor(&self) -> (u16, u16) {
+        self.cursor
+    }
+
+    pub(crate) fn cursor_visible(&self) -> bool {
+        self.cursor_visible
+    }
+
+    pub(crate) fn width(&self) -> u16 {
+        self.width
+    }
+
+    pub(crate) fn cell(&self, x: u16, y: u16) -> Option<&ModelCell> {
+        if x >= self.width || y >= self.height {
+            return None;
+        }
+        self.cells
+            .get(y as usize * self.width as usize + x as usize)
+    }
+
+    /// Replays one frame's bytes into the grid. `touched` receives the
+    /// (col, row) of every cell the frame wrote, for prediction reconcile.
+    pub(crate) fn apply(&mut self, bytes: &[u8], touched: &mut Vec<(u16, u16)>) {
+        let mut index = 0;
+        while index < bytes.len() {
+            if bytes[index] == 0x1b {
+                index = self.apply_escape(bytes, index, touched);
+            } else if bytes[index] < 0x20 || bytes[index] == 0x7f {
+                // Stray C0/DEL outside an escape — the encoder never emits
+                // these, skip defensively.
+                index += 1;
+            } else {
+                index = self.apply_text_run(bytes, index, touched);
+            }
+        }
+    }
+
+    /// Consumes one escape sequence starting at `start` (which is ESC).
+    fn apply_escape(&mut self, bytes: &[u8], start: usize, touched: &mut Vec<(u16, u16)>) -> usize {
+        let Some(&kind) = bytes.get(start + 1) else {
+            return start + 1;
+        };
+        match kind {
+            b'[' => {
+                // CSI: parameter bytes 0x30..=0x3f, intermediates 0x20..=0x2f,
+                // final 0x40..=0x7e.
+                let mut end = start + 2;
+                while end < bytes.len() && !(0x40..=0x7e).contains(&bytes[end]) {
+                    end += 1;
+                }
+                if end >= bytes.len() {
+                    return bytes.len();
+                }
+                let params = &bytes[start + 2..end];
+                self.apply_csi(params, bytes[end], touched);
+                end + 1
+            }
+            b']' => {
+                // OSC: terminated by BEL or ST (ESC \).
+                let mut end = start + 2;
+                while end < bytes.len() {
+                    if bytes[end] == 0x07 {
+                        self.apply_osc(&bytes[start + 2..end]);
+                        return end + 1;
+                    }
+                    if bytes[end] == 0x1b && bytes.get(end + 1) == Some(&b'\\') {
+                        self.apply_osc(&bytes[start + 2..end]);
+                        return end + 2;
+                    }
+                    end += 1;
+                }
+                bytes.len()
+            }
+            b'_' => {
+                // APC (Kitty graphics passthrough): terminated by ST.
+                let mut end = start + 2;
+                while end < bytes.len() {
+                    if bytes[end] == 0x1b && bytes.get(end + 1) == Some(&b'\\') {
+                        return end + 2;
+                    }
+                    end += 1;
+                }
+                bytes.len()
+            }
+            // Stray ST or an escape we do not model.
+            _ => start + 2,
+        }
+    }
+
+    fn apply_csi(&mut self, params: &[u8], final_byte: u8, touched: &mut Vec<(u16, u16)>) {
+        let params = std::str::from_utf8(params).unwrap_or("");
+        match final_byte {
+            b'H' => {
+                let mut split = params.split(';');
+                let row: u16 = split.next().and_then(|v| v.parse().ok()).unwrap_or(1);
+                let col: u16 = split.next().and_then(|v| v.parse().ok()).unwrap_or(1);
+                self.cursor = (
+                    col.saturating_sub(1).min(self.width.saturating_sub(1)),
+                    row.saturating_sub(1).min(self.height.saturating_sub(1)),
+                );
+            }
+            b'm' => {
+                self.pen = parse_pen_style(params);
+            }
+            b'J' => {
+                if params == "2" {
+                    for (index, cell) in self.cells.iter_mut().enumerate() {
+                        if cell.symbol != " " || !cell.plain {
+                            *cell = ModelCell::blank();
+                            touched.push((
+                                (index % self.width.max(1) as usize) as u16,
+                                (index / self.width.max(1) as usize) as u16,
+                            ));
+                        }
+                    }
+                }
+            }
+            // ?2026 sync markers carry no screen state; only ?25 does.
+            b'h' | b'l' if params == "?25" => {
+                self.cursor_visible = final_byte == b'h';
+            }
+            // DECSCUSR (`CSI Ps SP q`) and anything else: no cell effect.
+            _ => {}
+        }
+    }
+
+    fn apply_osc(&mut self, payload: &[u8]) {
+        // OSC 8 hyperlink open/close; OSC 52 clipboard is passthrough.
+        if let Some(rest) = payload.strip_prefix(b"8;") {
+            let uri = rest.splitn(2, |b| *b == b';').nth(1).unwrap_or(b"");
+            self.hyperlink_open = !uri.is_empty();
+        }
+    }
+
+    /// Consumes one printable run. The encoder may batch adjacent cells
+    /// without another CUP because inline eligibility is decided by the
+    /// previous cell. Split the run at extended grapheme boundaries so an
+    /// ASCII base plus combining marks remains one modeled cell.
+    fn apply_text_run(
+        &mut self,
+        bytes: &[u8],
+        start: usize,
+        touched: &mut Vec<(u16, u16)>,
+    ) -> usize {
+        let mut end = start;
+        while end < bytes.len() && bytes[end] != 0x1b && bytes[end] >= 0x20 && bytes[end] != 0x7f {
+            end += 1;
+        }
+        use unicode_segmentation::UnicodeSegmentation as _;
+
+        let run = String::from_utf8_lossy(&bytes[start..end]);
+        for grapheme in run.graphemes(true) {
+            self.write_symbol(grapheme.to_string(), touched);
+        }
+        end
+    }
+
+    fn write_symbol(&mut self, symbol: String, touched: &mut Vec<(u16, u16)>) {
+        use unicode_width::UnicodeWidthStr as _;
+
+        let (x, y) = self.cursor;
+        if x >= self.width || y >= self.height {
+            return;
+        }
+        let width = symbol.width() as u16;
+        if width == 0 {
+            // BlitEncoder emits this grapheme without advancing the cursor.
+            // A host terminal may attach it to a preceding glyph, so neither
+            // a destination cell nor prediction reconciliation is knowable.
+            self.prediction_safe = false;
+            return;
+        }
+        let prediction_style = (!self.hyperlink_open)
+            .then(|| self.pen.prediction.clone())
+            .flatten();
+        let plain = prediction_style
+            .as_ref()
+            .is_some_and(|style| !style.reversed && style.base_sgr.as_ref() == PLAIN_SGR);
+        let index = y as usize * self.width as usize + x as usize;
+        self.cells[index] = ModelCell {
+            symbol,
+            plain,
+            sgr: self.pen.sgr.clone(),
+            prediction_style,
+        };
+        touched.push((x, y));
+        for offset in 1..width {
+            let column = x + offset;
+            if column >= self.width {
+                break;
+            }
+            self.cells[index + offset as usize] = ModelCell::continuation();
+            touched.push((column, y));
+        }
+        self.cursor.0 = (x + width).min(self.width.saturating_sub(1));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::render_ansi::BlitEncoder;
+    use crate::protocol::{CellData, CursorState, FrameData};
+
+    fn plain_cell(symbol: &str) -> CellData {
+        CellData {
+            symbol: symbol.to_string(),
+            fg: 0,
+            bg: 0,
+            modifier: 0,
+            skip: false,
+            hyperlink: None,
+        }
+    }
+
+    fn styled_cell(symbol: &str) -> CellData {
+        CellData {
+            symbol: symbol.to_string(),
+            fg: 0x00_00_00_02, // red
+            bg: 0,
+            modifier: 1, // bold
+            skip: false,
+            hyperlink: None,
+        }
+    }
+
+    fn frame(width: u16, height: u16, cells: Vec<CellData>, cursor: (u16, u16)) -> FrameData {
+        FrameData {
+            cells,
+            width,
+            height,
+            cursor: Some(CursorState {
+                x: cursor.0,
+                y: cursor.1,
+                visible: true,
+                shape: 0,
+            }),
+            hyperlinks: Vec::new(),
+            graphics: Vec::new(),
+        }
+    }
+
+    fn assert_model_matches(model: &ScreenModel, frame: &FrameData) {
+        use unicode_width::UnicodeWidthStr as _;
+
+        let mut expect_continuations = 0;
+        for y in 0..frame.height {
+            for x in 0..frame.width {
+                let cell = &frame.cells[y as usize * frame.width as usize + x as usize];
+                let model_cell = model.cell(x, y).expect("cell in range");
+                if expect_continuations > 0 {
+                    expect_continuations -= 1;
+                    assert_eq!(
+                        model_cell,
+                        &ModelCell::continuation(),
+                        "continuation at ({x},{y})"
+                    );
+                    continue;
+                }
+                if cell.skip {
+                    continue;
+                }
+                assert_eq!(model_cell.symbol, cell.symbol, "symbol at ({x},{y})");
+                let plain = cell.fg == 0 && cell.bg == 0 && cell.modifier == 0;
+                assert_eq!(model_cell.plain, plain, "plainness at ({x},{y})");
+                expect_continuations = cell.symbol.width().saturating_sub(1);
+            }
+        }
+        let cursor = frame.cursor.as_ref().expect("cursor");
+        assert_eq!(model.cursor(), (cursor.x, cursor.y), "cursor position");
+        assert_eq!(model.cursor_visible(), cursor.visible, "cursor visibility");
+    }
+
+    /// Encodes `frames` in sequence through a real `BlitEncoder` (full frame
+    /// first, then diffs) and replays the bytes into a model.
+    fn replay(frames: &[FrameData]) -> ScreenModel {
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        let mut touched = Vec::new();
+        for frame in frames {
+            let encoded = encoder.encode(frame, false);
+            model.ensure_size(frame.width, frame.height);
+            model.apply(&encoded.bytes, &mut touched);
+            encoder.commit(frame.clone(), encoded);
+        }
+        model
+    }
+
+    #[test]
+    fn full_frame_round_trips_through_real_encoder() {
+        let mut cells = vec![plain_cell(" "); 12];
+        cells[0] = plain_cell("$");
+        cells[2] = styled_cell("l");
+        cells[3] = plain_cell("s");
+        let frame = frame(4, 3, cells, (1, 0));
+
+        let model = replay(std::slice::from_ref(&frame));
+        assert_model_matches(&model, &frame);
+    }
+
+    #[test]
+    fn incremental_frame_round_trips_through_real_encoder() {
+        let mut first_cells = vec![plain_cell(" "); 12];
+        first_cells[0] = plain_cell("$");
+        let first = frame(4, 3, first_cells.clone(), (2, 0));
+
+        let mut second_cells = first_cells;
+        second_cells[2] = plain_cell("e");
+        second_cells[5] = styled_cell("X");
+        let second = frame(4, 3, second_cells, (3, 0));
+
+        let model = replay(&[first, second.clone()]);
+        assert_model_matches(&model, &second);
+    }
+
+    #[test]
+    fn contiguous_ascii_diff_updates_each_cell() {
+        let first = frame(4, 1, vec![plain_cell(" "); 4], (0, 0));
+        let second = frame(
+            4,
+            1,
+            vec![
+                plain_cell("a"),
+                plain_cell("b"),
+                plain_cell("c"),
+                plain_cell(" "),
+            ],
+            (3, 0),
+        );
+        let model = replay(&[first, second.clone()]);
+
+        assert_model_matches(&model, &second);
+    }
+
+    #[test]
+    fn decomposed_grapheme_full_frame_occupies_one_cell() {
+        let reference = frame(
+            3,
+            1,
+            vec![plain_cell("e\u{301}"), plain_cell("!"), plain_cell(" ")],
+            (2, 0),
+        );
+
+        let model = replay(std::slice::from_ref(&reference));
+        assert_model_matches(&model, &reference);
+        assert_eq!(model.cell(0, 0).unwrap().symbol, "e\u{301}");
+        assert_eq!(model.cell(1, 0).unwrap().symbol, "!");
+    }
+
+    #[test]
+    fn ascii_prefix_and_decomposed_grapheme_diff_update_separate_cells() {
+        let first = frame(4, 1, vec![plain_cell(" "); 4], (0, 0));
+        let second = frame(
+            4,
+            1,
+            vec![
+                plain_cell("a"),
+                plain_cell("e\u{301}"),
+                plain_cell("!"),
+                plain_cell(" "),
+            ],
+            (3, 0),
+        );
+
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        model.ensure_size(4, 1);
+        let initial = encoder.encode(&first, false);
+        model.apply(&initial.bytes, &mut Vec::new());
+        encoder.commit(first, initial);
+        let diff = encoder.encode(&second, false);
+        assert!(
+            String::from_utf8_lossy(&diff.bytes).contains("ae\u{301}"),
+            "test must exercise one ASCII-leading decomposed run"
+        );
+        let mut touched = Vec::new();
+        model.apply(&diff.bytes, &mut touched);
+
+        assert_model_matches(&model, &second);
+        assert_eq!(touched, vec![(0, 0), (1, 0), (2, 0)]);
+    }
+
+    fn zero_width_diff(symbol: &str) -> (ScreenModel, Vec<(u16, u16)>) {
+        let first = frame(4, 1, vec![plain_cell(" "); 4], (0, 0));
+        let second = frame(
+            4,
+            1,
+            vec![
+                plain_cell(" "),
+                plain_cell(symbol),
+                plain_cell("x"),
+                plain_cell(" "),
+            ],
+            (3, 0),
+        );
+
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        model.ensure_size(4, 1);
+        let initial = encoder.encode(&first, false);
+        model.begin_full_frame();
+        model.apply(&initial.bytes, &mut Vec::new());
+        encoder.commit(first, initial);
+        let diff = encoder.encode(&second, false);
+        let mut touched = Vec::new();
+        model.apply(&diff.bytes, &mut touched);
+        (model, touched)
+    }
+
+    #[test]
+    fn combining_only_symbol_invalidates_prediction_without_advancing() {
+        let (model, touched) = zero_width_diff("\u{301}");
+        assert!(!model.prediction_safe());
+        assert_eq!(model.cell(1, 0).unwrap(), &ModelCell::blank());
+        assert_eq!(model.cell(2, 0).unwrap().symbol, "x");
+        assert_eq!(touched, vec![(2, 0)]);
+    }
+
+    #[test]
+    fn zwj_only_symbol_invalidates_prediction_without_advancing() {
+        let (model, touched) = zero_width_diff("\u{200d}");
+        assert!(!model.prediction_safe());
+        assert_eq!(model.cell(1, 0).unwrap(), &ModelCell::blank());
+        assert_eq!(model.cell(2, 0).unwrap().symbol, "x");
+        assert_eq!(touched, vec![(2, 0)]);
+    }
+
+    #[test]
+    fn ascii_prefix_and_wide_cell_in_one_run_update_separate_cells() {
+        let first = frame(4, 1, vec![plain_cell(" "); 4], (0, 0));
+        let mut second_cells = vec![plain_cell(" "); 4];
+        second_cells[0] = plain_cell("a");
+        second_cells[1] = plain_cell("你");
+        second_cells[2] = CellData {
+            skip: true,
+            ..plain_cell(" ")
+        };
+        let second = frame(4, 1, second_cells, (3, 0));
+
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        model.ensure_size(4, 1);
+        let initial = encoder.encode(&first, false);
+        model.apply(&initial.bytes, &mut Vec::new());
+        encoder.commit(first, initial);
+        let diff = encoder.encode(&second, false);
+        assert!(
+            String::from_utf8_lossy(&diff.bytes).contains("a你"),
+            "test must exercise one mixed printable run"
+        );
+        let mut touched = Vec::new();
+        model.apply(&diff.bytes, &mut touched);
+
+        assert_model_matches(&model, &second);
+        assert_eq!(touched, vec![(0, 0), (1, 0), (2, 0)]);
+    }
+
+    #[test]
+    fn wide_symbol_occupies_two_columns() {
+        let mut cells = vec![plain_cell(" "); 8];
+        cells[0] = plain_cell("你");
+        cells[1] = CellData {
+            skip: true,
+            ..plain_cell(" ")
+        };
+        cells[2] = plain_cell("!");
+        let frame = frame(4, 2, cells, (3, 0));
+
+        let model = replay(std::slice::from_ref(&frame));
+        assert_eq!(model.cell(0, 0).unwrap().symbol, "你");
+        assert_eq!(model.cell(1, 0).unwrap(), &ModelCell::continuation());
+        assert_eq!(model.cell(2, 0).unwrap().symbol, "!");
+    }
+
+    #[test]
+    fn hyperlinked_cells_are_not_plain() {
+        let mut cells = vec![plain_cell(" "); 4];
+        cells[0] = CellData {
+            hyperlink: Some(0),
+            ..plain_cell("h")
+        };
+        cells[1] = plain_cell("x");
+        let mut frame = frame(4, 1, cells, (2, 0));
+        frame.hyperlinks = vec!["https://example.com".to_string()];
+
+        let model = replay(std::slice::from_ref(&frame));
+        assert!(!model.cell(0, 0).unwrap().plain, "hyperlinked cell");
+        assert!(model.cell(1, 0).unwrap().plain, "cell after link close");
+    }
+
+    #[test]
+    fn colored_reverse_cell_retains_safe_base_style() {
+        let mut cells = vec![plain_cell(" "); 3];
+        cells[0] = CellData {
+            fg: 0x02_FF_80_40,
+            bg: 0x01_00_00_04,
+            modifier: 1 << 6,
+            ..plain_cell(" ")
+        };
+        cells[1] = CellData {
+            fg: 0x02_FF_80_40,
+            bg: 0x01_00_00_04,
+            ..plain_cell(" ")
+        };
+        let mut reference = frame(3, 1, cells, (0, 0));
+        reference.cursor.as_mut().expect("cursor").visible = false;
+
+        let model = replay(std::slice::from_ref(&reference));
+        let caret = model
+            .cell(0, 0)
+            .unwrap()
+            .prediction_style
+            .as_ref()
+            .expect("reverse-only style is safe");
+        let neighbor = model
+            .cell(1, 0)
+            .unwrap()
+            .prediction_style
+            .as_ref()
+            .expect("color-only style is safe");
+        assert!(caret.reversed);
+        assert!(!neighbor.reversed);
+        assert_eq!(caret.base_sgr, neighbor.base_sgr);
+        assert_eq!(caret.base_sgr.as_ref(), "\x1b[0;38;2;255;128;64;48;5;4m");
+    }
+
+    #[test]
+    fn hidden_cursor_is_reported_hidden() {
+        let mut reference = frame(2, 1, vec![plain_cell("a"), plain_cell(" ")], (0, 0));
+        reference.cursor.as_mut().expect("cursor").visible = false;
+
+        let model = replay(std::slice::from_ref(&reference));
+        assert!(!model.cursor_visible());
+    }
+
+    #[test]
+    fn resize_clears_the_grid() {
+        let reference = frame(2, 1, vec![plain_cell("a"), plain_cell("b")], (0, 0));
+        let mut model = replay(std::slice::from_ref(&reference));
+        model.ensure_size(3, 2);
+        assert_eq!(model.cell(0, 0).unwrap(), &ModelCell::blank());
+        assert_eq!(model.width(), 3);
+    }
+
+    #[test]
+    fn touched_reports_written_cells() {
+        let mut first_cells = vec![plain_cell(" "); 4];
+        first_cells[0] = plain_cell("a");
+        let first = frame(4, 1, first_cells.clone(), (1, 0));
+
+        let mut second_cells = first_cells;
+        second_cells[2] = plain_cell("b");
+        let second = frame(4, 1, second_cells, (3, 0));
+
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        let mut touched = Vec::new();
+
+        let encoded = encoder.encode(&first, false);
+        model.ensure_size(first.width, first.height);
+        model.apply(&encoded.bytes, &mut touched);
+        encoder.commit(first, encoded);
+
+        touched.clear();
+        let encoded = encoder.encode(&second, false);
+        model.apply(&encoded.bytes, &mut touched);
+        assert_eq!(touched, vec![(2, 0)], "diff frame touches only the change");
+    }
+
+    #[test]
+    fn cursor_only_diff_updates_cursor_without_touching_cells() {
+        let cells = vec![plain_cell(" "); 4];
+        let first = frame(4, 1, cells.clone(), (1, 0));
+        let second = frame(4, 1, cells, (2, 0));
+        let mut encoder = BlitEncoder::new();
+        let mut model = ScreenModel::new();
+        let mut touched = Vec::new();
+
+        let encoded = encoder.encode(&first, false);
+        model.ensure_size(first.width, first.height);
+        model.apply(&encoded.bytes, &mut touched);
+        encoder.commit(first, encoded);
+
+        touched.clear();
+        let encoded = encoder.encode(&second, false);
+        model.apply(&encoded.bytes, &mut touched);
+        assert!(touched.is_empty());
+        assert_eq!(model.cursor(), (2, 0));
+        assert!(model.cursor_visible());
+    }
+
+    #[test]
+    fn kitty_graphics_and_osc52_are_passthrough() {
+        let mut model = ScreenModel::new();
+        model.ensure_size(2, 1);
+        let mut touched = Vec::new();
+        model.apply(
+            b"\x1b_Ga=T;payload\x1b\\\x1b]52;c;YQ==\x07\x1b[1;1Hz",
+            &mut touched,
+        );
+        assert_eq!(model.cell(0, 0).unwrap().symbol, "z");
+    }
+
+    #[test]
+    fn truncated_escape_at_end_does_not_panic() {
+        let mut model = ScreenModel::new();
+        model.ensure_size(2, 1);
+        let mut touched = Vec::new();
+        model.apply(b"\x1b[1;1", &mut touched);
+        model.apply(b"\x1b]8;;unterminated", &mut touched);
+        model.apply(b"\x1b", &mut touched);
+    }
+}
