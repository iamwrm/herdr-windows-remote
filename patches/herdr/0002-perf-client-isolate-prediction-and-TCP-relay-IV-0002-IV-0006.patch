@@ -0,0 +1,264 @@
+//! Local prediction integration. Never changes the stable endpoint codec.
+use super::{
+    echo_timing::EchoTiming,
+    endpoint::ClientEndpointId,
+    predict::{PredictiveEchoMode, Predictor},
+};
+use crate::protocol::ClientMessage;
+use std::io::{self, Write as _};
+const SYNC_OUTPUT_END: &[u8] = b"\x1b[?2026l";
+pub(super) struct Prediction {
+    mode: PredictiveEchoMode,
+    remote: bool,
+    predictor: Option<Predictor>,
+    owner: Option<(ClientEndpointId, String)>,
+    timing: EchoTiming,
+}
+impl Prediction {
+    pub(super) fn new(mode: &str, remote: bool) -> Self {
+        let mode = PredictiveEchoMode::from_config(mode);
+        Self {
+            mode,
+            remote,
+            predictor: if remote { Predictor::new(mode) } else { None },
+            owner: None,
+            timing: EchoTiming::from_env(),
+        }
+    }
+    pub(super) fn set_remote(&mut self, remote: bool) -> bool {
+        if self.remote == remote {
+            return false;
+        }
+        self.reset();
+        self.remote = remote;
+        self.predictor = if remote {
+            Predictor::new(self.mode)
+        } else {
+            None
+        };
+        true
+    }
+    pub(super) fn reset(&mut self) {
+        if let Some(p) = &mut self.predictor {
+            write_prediction_output(&p.on_resize());
+        }
+        self.owner = None;
+    }
+    pub(super) fn input(
+        &mut self,
+        message: &ClientMessage,
+        endpoint: &ClientEndpointId,
+        remote_process: bool,
+    ) {
+        if !remote_process && endpoint.is_local() {
+            self.reset();
+            return;
+        }
+        let (pane, events) = match message {
+            ClientMessage::ClientShellPaneInput { pane_id, events } => (pane_id, events),
+            _ => {
+                self.reset();
+                return;
+            }
+        };
+        let owner = (endpoint.clone(), pane.clone());
+        if self
+            .owner
+            .as_ref()
+            .is_some_and(|previous| previous != &owner)
+        {
+            self.reset();
+        }
+        self.owner = Some(owner);
+        if let Some(p) = &mut self.predictor {
+            write_prediction_output(&p.on_input_events(events));
+        }
+        if events.iter().any(|e| {
+            matches!(
+                e,
+                crate::protocol::ClientPaneInputEvent::Key {
+                    kind: crate::protocol::ClientKeyKind::Press
+                        | crate::protocol::ClientKeyKind::Repeat,
+                    ..
+                } | crate::protocol::ClientPaneInputEvent::TextCommit(_)
+                    | crate::protocol::ClientPaneInputEvent::Paste(_)
+            )
+        }) {
+            self.timing.on_key_input_sent();
+        }
+    }
+    pub(super) fn timer(&mut self) {
+        if let Some(p) = &mut self.predictor {
+            write_prediction_output(&p.on_timer());
+        }
+    }
+    pub(super) fn write_frame(
+        &mut self,
+        writer: &mut impl io::Write,
+        bytes: &[u8],
+        size: (u16, u16),
+        full: bool,
+        graphics: &[u8],
+    ) -> io::Result<()> {
+        let correction = self
+            .predictor
+            .as_mut()
+            .map(|p| p.on_encoded_frame(bytes, size.0, size.1, full))
+            .unwrap_or_default();
+        self.timing.on_render_received();
+        if correction.is_empty() {
+            return super::frame_output::write_encoded_frame_with_graphics(writer, bytes, graphics);
+        }
+        let mut combined = Vec::with_capacity(bytes.len() + correction.len());
+        write_terminal_frame_with_predictions(&mut combined, bytes, &correction)?;
+        super::frame_output::write_encoded_frame_with_graphics(writer, &combined, graphics)
+    }
+}
+fn write_prediction_output(bytes: &[u8]) {
+    if bytes.is_empty() {
+        return;
+    }
+    let mut stdout = io::stdout().lock();
+    let _ = stdout.write_all(bytes);
+    let _ = stdout.flush();
+}
+
+/// Keep frame reconciliation atomic with the server frame. Inserting the
+/// predictor's repaint/cursor anchor before the synchronized-output terminator
+/// prevents the host terminal from briefly exposing the stale server cursor.
+/// Linux encoders append a duplicate IME cursor anchor after that terminator;
+/// discard that tail when a predictor anchor supersedes it.
+fn write_terminal_frame_with_predictions(
+    mut writer: impl io::Write,
+    frame: &[u8],
+    prediction_output: &[u8],
+) -> io::Result<()> {
+    if prediction_output.is_empty() {
+        writer.write_all(frame)?;
+    } else if let Some(sync_end) = frame
+        .windows(SYNC_OUTPUT_END.len())
+        .rposition(|window| window == SYNC_OUTPUT_END)
+    {
+        let tail = &frame[sync_end + SYNC_OUTPUT_END.len()..];
+        if tail.is_empty() || is_post_sync_ime_cursor_anchor(tail) {
+            writer.write_all(&frame[..sync_end])?;
+            writer.write_all(prediction_output)?;
+            writer.write_all(SYNC_OUTPUT_END)?;
+        } else {
+            // Never discard an unrecognized server suffix. The correction is
+            // less atomic in this defensive fallback, but remains final.
+            writer.write_all(frame)?;
+            writer.write_all(prediction_output)?;
+        }
+    } else {
+        writer.write_all(frame)?;
+        writer.write_all(prediction_output)?;
+    }
+    writer.flush()
+}
+
+/// The non-Windows encoder's optional IME suffix is exactly
+/// `CUP(row,col) + DECTCEM(show|hide)`. Recognize only that grammar before
+/// replacing it; arbitrary bytes after synchronized output must be preserved.
+fn is_post_sync_ime_cursor_anchor(bytes: &[u8]) -> bool {
+    let Some(rest) = bytes.strip_prefix(b"\x1b[") else {
+        return false;
+    };
+    let Some(cup_end) = rest.iter().position(|byte| *byte == b'H') else {
+        return false;
+    };
+    let coordinates = &rest[..cup_end];
+    let Some(separator) = coordinates.iter().position(|byte| *byte == b';') else {
+        return false;
+    };
+    let (row, column_with_separator) = coordinates.split_at(separator);
+    let column = &column_with_separator[1..];
+    let valid_number = |number: &[u8]| !number.is_empty() && number.iter().all(u8::is_ascii_digit);
+    valid_number(row)
+        && valid_number(column)
+        && matches!(&rest[cup_end + 1..], b"\x1b[?25h" | b"\x1b[?25l")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn prediction_output_stays_inside_frame_sync_block() {
+        let mut output = Vec::new();
+        write_terminal_frame_with_predictions(
+            &mut output,
+            b"\x1b[?2026hframe\x1b[?2026l\x1b[3;5H\x1b[?25h",
+            b"prediction-cursor",
+        )
+        .unwrap();
+
+        assert_eq!(output, b"\x1b[?2026hframeprediction-cursor\x1b[?2026l");
+    }
+
+    #[test]
+    fn prediction_output_preserves_unrecognized_post_sync_suffix() {
+        let mut output = Vec::new();
+        write_terminal_frame_with_predictions(
+            &mut output,
+            b"\x1b[?2026hframe\x1b[?2026lserver-suffix",
+            b"prediction-cursor",
+        )
+        .unwrap();
+
+        assert_eq!(
+            output,
+            b"\x1b[?2026hframe\x1b[?2026lserver-suffixprediction-cursor"
+        );
+    }
+
+    #[test]
+    fn post_sync_ime_cursor_anchor_recognizer_is_exact() {
+        assert!(is_post_sync_ime_cursor_anchor(b"\x1b[3;5H\x1b[?25h"));
+        assert!(is_post_sync_ime_cursor_anchor(b"\x1b[12;1H\x1b[?25l"));
+        assert!(!is_post_sync_ime_cursor_anchor(b"\x1b[3;5H"));
+        assert!(!is_post_sync_ime_cursor_anchor(b"\x1b[3;5H\x1b[?25hmore"));
+        assert!(!is_post_sync_ime_cursor_anchor(b"server-suffix"));
+    }
+
+    #[test]
+    fn prediction_output_falls_back_after_unsynchronized_frame() {
+        let mut output = Vec::new();
+        write_terminal_frame_with_predictions(&mut output, b"frame", b"prediction").unwrap();
+        assert_eq!(output, b"frameprediction");
+    }
+
+    #[test]
+    fn local_frames_do_not_build_a_prediction_model() {
+        let mut prediction = Prediction::new("always", false);
+        let mut output = Vec::new();
+        prediction
+            .write_frame(&mut output, b"frame", (80, 24), true, &[])
+            .unwrap();
+        assert_eq!(output, b"frame");
+        assert!(prediction.predictor.is_none());
+        assert!(prediction.set_remote(true));
+        assert!(prediction.predictor.is_some());
+        assert!(prediction.set_remote(false));
+        assert!(prediction.predictor.is_none());
+    }
+    #[test]
+    fn same_pane_id_on_different_endpoints_changes_owner() {
+        let mut prediction = Prediction::new("off", true);
+        let first = ClientEndpointId::Ssh(
+            super::super::endpoint::ProfileId::parse("00000000000000000000000000000001").unwrap(),
+        );
+        let second = ClientEndpointId::Ssh(
+            super::super::endpoint::ProfileId::parse("00000000000000000000000000000002").unwrap(),
+        );
+        let message = ClientMessage::ClientShellPaneInput {
+            pane_id: "w1:p1".into(),
+            events: Vec::new(),
+        };
+        prediction.input(&message, &first, false);
+        assert_eq!(prediction.owner.as_ref().unwrap().0, first);
+        prediction.input(&message, &second, false);
+        assert_eq!(prediction.owner.as_ref().unwrap().0, second);
+        prediction.reset();
+        assert!(prediction.owner.is_none());
+    }
+}
