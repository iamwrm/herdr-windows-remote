+//! `herdr remote-tcp-relay <host> <port>` — a minimal ssh ProxyCommand that
+//! owns the TCP connection with `TCP_NODELAY` set (i0002 W1).
+//!
+//! OpenSSH only sets `TCP_NODELAY` on interactive (tty) sessions; the remote
+//! bridge runs `ssh -T`, so Nagle's algorithm can hold a keystroke packet
+//! back until the previous one is acked — up to a full extra RTT when typing
+//! fast on a high-latency link. Routing the connection through this relay
+//! (`-o ProxyCommand=<herdr> remote-tcp-relay %h %p`) puts the socket under
+//! our control. Injected on Windows when `remote.tcp_relay = true` (or
+//! `HERDR_REMOTE_TCP_RELAY=1`); see `remote::windows::apply_managed_ssh_options`.
+//!
+//! Note this only fixes the client→server leg. The server→client leg is
+//! sshd's socket and follows the same tty rule there; measure both with
+//! `HERDR_ECHO_TIMING` before assuming symmetric gains.
+
+use std::io;
+#[cfg(test)]
+use std::io::{Read, Write};
+use std::net::{Shutdown, TcpStream, ToSocketAddrs};
+use std::thread;
+
+fn copy_flush(
+    reader: &mut impl std::io::Read,
+    writer: &mut impl std::io::Write,
+) -> std::io::Result<u64> {
+    let mut buffer = [0u8; 16 * 1024];
+    let mut total = 0;
+    loop {
+        let n = match reader.read(&mut buffer) {
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            other => other?,
+        };
+        if n == 0 {
+            return Ok(total);
+        }
+        writer.write_all(&buffer[..n])?;
+        writer.flush()?;
+        total += n as u64;
+    }
+}
+
+pub(crate) fn run_remote_tcp_relay(args: &[String]) -> io::Result<()> {
+    let (host, port) = parse_relay_args(args).map_err(|usage| {
+        eprintln!("{usage}");
+        io::Error::new(io::ErrorKind::InvalidInput, "invalid remote-tcp-relay args")
+    })?;
+
+    let stream = connect_nodelay(&host, port)?;
+    relay_stdio(stream)
+}
+
+pub(crate) fn parse_relay_args(args: &[String]) -> Result<(String, u16), String> {
+    let usage = "usage: herdr remote-tcp-relay <host> <port>";
+    let [host, port] = args else {
+        return Err(usage.to_string());
+    };
+    if host.is_empty() {
+        return Err(usage.to_string());
+    }
+    let port: u16 = port
+        .parse()
+        .map_err(|_| format!("{usage} (invalid port `{port}`)"))?;
+    Ok((host.clone(), port))
+}
+
+fn connect_nodelay(host: &str, port: u16) -> io::Result<TcpStream> {
+    let addrs = (host, port).to_socket_addrs().map_err(|err| {
+        io::Error::new(
+            err.kind(),
+            format!("failed to resolve {host}:{port}: {err}"),
+        )
+    })?;
+    let mut last_err = None;
+    for addr in addrs {
+        match TcpStream::connect(addr) {
+            Ok(stream) => {
+                stream.set_nodelay(true)?;
+                return Ok(stream);
+            }
+            Err(err) => last_err = Some(err),
+        }
+    }
+    Err(last_err.unwrap_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::AddrNotAvailable,
+            format!("no addresses resolved for {host}:{port}"),
+        )
+    }))
+}
+
+/// Splices stdin→socket and socket→stdout. Returns when the server side
+/// closes (ssh observes EOF on our stdout); a stdin EOF half-closes the
+/// socket so the server can finish sending.
+fn relay_stdio(stream: TcpStream) -> io::Result<()> {
+    let mut write_half = stream.try_clone()?;
+    let upload = thread::spawn(move || {
+        let mut stdin = io::stdin().lock();
+        let _ = copy_flush(&mut stdin, &mut write_half);
+        let _ = write_half.shutdown(Shutdown::Write);
+    });
+
+    let mut read_half = stream;
+    let mut stdout = io::stdout().lock();
+    let result = copy_flush(&mut read_half, &mut stdout).map(|_| ());
+    drop(stdout);
+    // If the server closed first, stdin may still be open and the upload
+    // thread blocked in read; exiting the process releases it. Only join
+    // when the upload already finished (stdin EOF path).
+    if upload.is_finished() {
+        let _ = upload.join();
+    }
+    result
+}
+
+/// Testable core of the relay: like [`relay_stdio`] but over arbitrary
+/// streams instead of the process stdio.
+#[cfg(test)]
+fn relay_streams(
+    mut input: impl Read + Send + 'static,
+    output: &mut impl Write,
+    stream: TcpStream,
+) -> io::Result<()> {
+    let mut write_half = stream.try_clone()?;
+    let upload = thread::spawn(move || {
+        let _ = copy_flush(&mut input, &mut write_half);
+        let _ = write_half.shutdown(Shutdown::Write);
+    });
+    let mut read_half = stream;
+    let result = copy_flush(&mut read_half, output).map(|_| ());
+    let _ = upload.join();
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::net::TcpListener;
+
+    #[test]
+    fn parse_relay_args_accepts_host_and_port() {
+        let args = vec!["example.com".to_string(), "22".to_string()];
+        assert_eq!(parse_relay_args(&args), Ok(("example.com".to_string(), 22)));
+    }
+
+    #[test]
+    fn parse_relay_args_rejects_bad_shapes() {
+        assert!(parse_relay_args(&[]).is_err());
+        assert!(parse_relay_args(&["host".to_string()]).is_err());
+        assert!(parse_relay_args(&["host".to_string(), "notaport".to_string()]).is_err());
+        assert!(parse_relay_args(&[String::new(), "22".to_string()]).is_err());
+        assert!(
+            parse_relay_args(&["host".to_string(), "22".to_string(), "extra".to_string()]).is_err()
+        );
+    }
+
+    #[test]
+    fn relay_sets_nodelay_and_splices_both_directions() {
+        let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+        let addr = listener.local_addr().expect("addr");
+
+        // Echo server: read everything, send it back uppercased, close.
+        let server = thread::spawn(move || {
+            let (mut conn, _) = listener.accept().expect("accept");
+            let mut received = Vec::new();
+            conn.read_to_end(&mut received).expect("read");
+            let upper = received.to_ascii_uppercase();
+            conn.write_all(&upper).expect("write");
+            conn.shutdown(Shutdown::Write).ok();
+        });
+
+        let stream = connect_nodelay(&addr.ip().to_string(), addr.port()).expect("connect");
+        assert!(stream.nodelay().expect("nodelay query"));
+
+        let input = io::Cursor::new(b"keystrokes".to_vec());
+        let mut output = Vec::new();
+        relay_streams(input, &mut output, stream).expect("relay");
+
+        assert_eq!(output, b"KEYSTROKES");
+        server.join().expect("server thread");
+    }
+}
