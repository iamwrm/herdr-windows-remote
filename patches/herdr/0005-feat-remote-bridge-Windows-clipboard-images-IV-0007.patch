+    fn store_once(&mut self, extension: &str, data: &[u8]) -> Result<String, StoreFailure> {
+        let extension = normalized_image_extension(extension)
+            .ok_or_else(|| StoreFailure::Rejected("unsupported image extension".to_owned()))?;
+        let size = u64::try_from(data.len())
+            .map_err(|_| StoreFailure::Rejected("image size does not fit u64".to_owned()))?;
+        if size == 0 || size > self.capacity_bytes {
+            return Err(StoreFailure::Rejected(format!(
+                "image size {size} exceeds FIFO capacity {}",
+                self.capacity_bytes
+            )));
+        }
+        let capacity_bytes = self.capacity_bytes;
+        let session = self.session().map_err(StoreFailure::Unavailable)?;
+        let stdin = session
+            .stdin
+            .as_mut()
+            .ok_or_else(|| StoreFailure::Unavailable(io::Error::other("image store is closed")))?;
+        write!(
+            stdin,
+            "{REMOTE_IMAGE_STORE_PROTOCOL} {size} {extension} {capacity_bytes}\n"
+        )
+        .and_then(|()| stdin.write_all(data))
+        .and_then(|()| stdin.flush())
+        .map_err(StoreFailure::Unavailable)?;
