+#[cfg(windows)]
+fn forward_windows_input_events(
+    events: Vec<crate::protocol::ClientInputEvent>,
+    state: &mut ClientState,
+    predictor: &mut Option<predict::Predictor>,
+    echo_timing: &mut echo_timing::EchoTiming,
+    write_stream: &mut LocalStream,
+) -> Result<(), ClientError> {
+    if events.is_empty() {
+        return Ok(());
+    }
+    let raw_events = events
+        .iter()
+        .map(crate::protocol::ClientInputEvent::to_raw_input_event)
+        .collect::<Vec<_>>();
+    if crate::raw_input::events_require_host_surface_redraw(
+        &raw_events,
+        state.redraw_on_focus_gained,
+    ) {
+        state.request_repaint();
+    }
+    let prediction_output = predictor
+        .as_mut()
+        .map(|predictor| predictor.on_input_events(&events))
+        .unwrap_or_default();
+    write_prediction_output(&prediction_output);
+    let probe_input = events.iter().any(echo_timing::is_key_or_paste_event);
+    write_to_server(write_stream, &ClientMessage::InputEvents { events })
+        .map_err(ClientError::ConnectionLost)?;
+    if probe_input {
+        echo_timing.on_key_input_sent();
+    }
+    Ok(())
+}
+
+#[cfg(any(windows, test))]
+fn remote_image_paste_trigger_index(
+    events: &[crate::protocol::ClientInputEvent],
+    is_remote_client: bool,
+    configured_key: Option<(crossterm::event::KeyCode, crossterm::event::KeyModifiers)>,
+) -> Option<usize> {
+    if !is_remote_client {
+        return None;
+    }
+    events.iter().position(|event| match event {
+        crate::protocol::ClientInputEvent::Paste { text } if text.is_empty() => true,
+        _ => {
+            let Some(configured_key) = configured_key else {
+                return false;
+            };
+            let crate::raw_input::RawInputEvent::Key(key) = event.to_raw_input_event() else {
+                return false;
+            };
+            key.kind == crossterm::event::KeyEventKind::Press
+                && crate::config::terminal_key_matches_combo(&key, configured_key)
+        }
+    })
+}
+
+#[cfg(any(windows, test))]
+fn events_around_remote_image_paste_trigger(
+    events: Vec<crate::protocol::ClientInputEvent>,
+    trigger_index: usize,
+    configured_key: Option<(crossterm::event::KeyCode, crossterm::event::KeyModifiers)>,
+) -> (
+    Vec<crate::protocol::ClientInputEvent>,
+    Vec<crate::protocol::ClientInputEvent>,
+) {
+    let mut before = Vec::new();
+    let mut after = Vec::new();
+    for (index, event) in events.into_iter().enumerate() {
+        let matches_binding = configured_key.is_some_and(|configured_key| {
+            match event.to_raw_input_event() {
+                crate::raw_input::RawInputEvent::Key(key) => {
+                    crate::config::terminal_key_matches_combo(&key, configured_key)
+                }
+                _ => false,
+            }
+        });
+        if index < trigger_index {
+            before.push(event);
+        } else if index > trigger_index && !matches_binding {
+            after.push(event);
+        }
+    }
+    (before, after)
+}
