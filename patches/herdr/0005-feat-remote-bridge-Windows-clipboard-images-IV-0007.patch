+/// Reads a Windows clipboard image and normalizes it to PNG for the existing
+/// remote `ClipboardImage` protocol message.
+///
+/// Prefer the registered PNG clipboard format because it preserves the
+/// producer's bytes exactly. Windows screenshots commonly expose only
+/// CF_DIBV5/CF_DIB, which are decoded by the platform-neutral parser.
+pub fn read_clipboard_image() -> Option<ClipboardImage> {
+    let owner = unsafe { GetConsoleWindow() };
+    let mut opened = false;
+    for _ in 0..5 {
+        if unsafe { OpenClipboard(owner) } != 0 {
+            opened = true;
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    if !opened {
+        return None;
+    }
+    let _clipboard = ClipboardGuard;
+
+    let png_format_name = wide_null("PNG");
+    let png_format = unsafe { RegisterClipboardFormatW(png_format_name.as_ptr()) };
+    if let Some(bytes) = clipboard_format_bytes(png_format)
+        .and_then(|bytes| windows_clipboard::registered_png(&bytes))
+    {
+        return Some(ClipboardImage {
+            bytes,
+            extension: "png",
+        });
+    }
+
+    for format in [CF_DIBV5 as u32, CF_DIB as u32] {
+        if let Some(bytes) = clipboard_format_bytes(format)
+            .and_then(|bytes| windows_clipboard::dib_to_png(&bytes))
+        {
+            return Some(ClipboardImage {
+                bytes,
+                extension: "png",
+            });
+        }
+    }
+    None
+}
+
+fn clipboard_format_bytes(format: u32) -> Option<Vec<u8>> {
+    if format == 0 || unsafe { IsClipboardFormatAvailable(format) } == 0 {
+        return None;
+    }
+    let memory = unsafe { GetClipboardData(format) };
+    if memory.is_null() {
+        return None;
+    }
+    let byte_len = unsafe { GlobalSize(memory) };
+    if byte_len == 0 || byte_len > MAX_CLIPBOARD_FORMAT_BYTES {
+        return None;
+    }
+    let locked = unsafe { GlobalLock(memory) };
+    if locked.is_null() {
+        return None;
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(locked.cast::<u8>(), byte_len) }.to_vec();
+    unsafe {
+        GlobalUnlock(memory);
+    }
+    Some(bytes)
+}
