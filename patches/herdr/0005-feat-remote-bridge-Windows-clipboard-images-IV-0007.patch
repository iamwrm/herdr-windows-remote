+fn read_client_frame(stream: &LocalStream, frame: &mut Vec<u8>) -> io::Result<bool> {
+    frame.clear();
+    frame.resize(FRAME_LENGTH_PREFIX_BYTES, 0);
+    let mut reader = stream;
+    if !read_exact_or_clean_eof(&mut reader, frame)? {
+        frame.clear();
+        return Ok(false);
+    }
+    let payload_len = u32::from_le_bytes(
+        frame[..FRAME_LENGTH_PREFIX_BYTES]
+            .try_into()
+            .expect("fixed frame prefix"),
+    ) as usize;
+    if payload_len > MAX_GRAPHICS_FRAME_SIZE {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!(
+                "client frame size {payload_len} exceeds maximum {MAX_GRAPHICS_FRAME_SIZE}"
+            ),
+        ));
+    }
+    frame.resize(FRAME_LENGTH_PREFIX_BYTES + payload_len, 0);
+    read_exact_required(&mut reader, &mut frame[FRAME_LENGTH_PREFIX_BYTES..])?;
+    Ok(true)
+}
+
+fn read_exact_or_clean_eof(reader: &mut impl io::Read, buffer: &mut [u8]) -> io::Result<bool> {
+    let mut offset = 0;
+    while offset < buffer.len() {
+        match reader.read(&mut buffer[offset..]) {
+            Ok(0) if offset == 0 => return Ok(false),
+            Ok(0) => return Err(io::ErrorKind::UnexpectedEof.into()),
+            Ok(read) => offset += read,
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => {}
+            Err(err) => return Err(err),
+        }
+    }
+    Ok(true)
+}
+
+fn read_exact_required(reader: &mut impl io::Read, buffer: &mut [u8]) -> io::Result<()> {
+    if read_exact_or_clean_eof(reader, buffer)? {
+        Ok(())
+    } else {
+        Err(io::ErrorKind::UnexpectedEof.into())
+    }
+}
+
+fn clipboard_image_from_frame(frame: &[u8]) -> Option<(String, Vec<u8>)> {
+    let payload = frame.get(FRAME_LENGTH_PREFIX_BYTES..)?;
+    // Bincode's standard enum tag for ClipboardImage is stable at index 2;
+    // skip deserialization for every ordinary keystroke/render-control frame.
+    if payload.first() != Some(&2) {
+        return None;
+    }
+    let (message, consumed): (ClientMessage, usize) =
+        bincode::serde::decode_from_slice(payload, bincode::config::standard()).ok()?;
+    if consumed != payload.len() {
+        return None;
+    }
+    match message {
+        ClientMessage::ClipboardImage { extension, data } => Some((extension, data)),
+        _ => None,
+    }
+}
