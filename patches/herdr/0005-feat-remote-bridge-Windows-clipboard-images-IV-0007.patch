+                "remote store returned an unsafe image path".to_owned(),
+            )),
+            StoreResponse::Error(reason) => Err(StoreFailure::Rejected(reason)),
+            StoreResponse::Ready => Err(StoreFailure::Unavailable(io::Error::other(
+                "remote store returned duplicate READY response",
+            ))),
+        }
