new file mode 100644
index 00000000..b6fdd00f
--- /dev/null
+++ b/src/remote/linux_clipboard_image_store.sh
@@ -0,0 +1,131 @@
+#!/bin/sh
+# Embedded by the native Windows remote bridge and executed through a lazy
+# persistent `ssh -T` side channel. stdin is a sequence of:
+#
+#   HERDR_IMAGE_V1 <byte-count> <extension> <capacity-bytes>\n<raw bytes>
+#
+# stdout is line-oriented control traffic. No image bytes are echoed.
+
+set -eu
+LC_ALL=C
+export LC_ALL
+
+protocol=HERDR_IMAGE_V1
+
+reply_error() {
+    printf '%s ERR %s\n' "$protocol" "$1"
+}
+
+user=$(id -un) || {
+    reply_error user_lookup_failed
+    exit 1
+}
+uid=$(id -u) || {
+    reply_error uid_lookup_failed
+    exit 1
+}
+case "$user" in
+    ''|*[!A-Za-z0-9._-]*)
+        reply_error unsafe_user_name
+        exit 1
+        ;;
+esac
+
+dir="/tmp/herdr-$user"
+if [ -L "$dir" ]; then
+    reply_error staging_dir_is_symlink
+    exit 1
+fi
+if [ ! -e "$dir" ]; then
+    mkdir -m 700 -- "$dir" 2>/dev/null || true
+fi
+if [ ! -d "$dir" ] || [ -L "$dir" ]; then
+    reply_error invalid_staging_dir
+    exit 1
+fi
+if [ "$(stat -c %u -- "$dir")" != "$uid" ]; then
+    reply_error staging_dir_wrong_owner
+    exit 1
+fi
+chmod 700 -- "$dir"
+
+if ! command -v flock >/dev/null 2>&1; then
+    reply_error flock_unavailable
+    exit 1
+fi
+exec 9>"$dir/.fifo.lock"
+printf '%s READY\n' "$protocol"
+
+while IFS=' ' read -r magic size extension capacity extra; do
+    if [ "$magic" != "$protocol" ] || [ -n "${extra:-}" ]; then
+        reply_error invalid_header
+        exit 1
+    fi
+    case "$size" in
+        ''|*[!0-9]*)
+            reply_error invalid_size
+            exit 1
+            ;;
+    esac
+    case "$capacity" in
+        ''|*[!0-9]*)
+            reply_error invalid_capacity
+            exit 1
+            ;;
+    esac
+    case "$extension" in
+        png|jpg|gif|webp|bmp) ;;
+        *)
+            reply_error invalid_extension
+            exit 1
+            ;;
+    esac
+    if [ "$size" -le 0 ] || [ "$capacity" -le 0 ] || [ "$size" -gt "$capacity" ]; then
+        reply_error image_exceeds_capacity
+        exit 1
+    fi
+
+    file=$(mktemp --suffix=".$extension" "$dir/clipboard-XXXXXXXXXXXX") || {
+        reply_error file_create_failed
+        exit 1
+    }
+    trap 'rm -f -- "$file"' EXIT HUP INT TERM
+    if ! dd iflag=fullblock bs="$size" count=1 of="$file" status=none; then
+        reply_error short_image_payload
+        exit 1
+    fi
+    chmod 600 -- "$file"
+
+    # Multiple Windows clients for the same Unix account share one capacity
+    # budget. Serialize the scan/delete transaction and never evict the image
+    # currently being committed; because size <= capacity, removing older
+    # entries is always sufficient.
+    flock 9
+    total=$(find "$dir" -maxdepth 1 -type f -name 'clipboard-*' -printf '%s\n' |
+        awk '{ total += $1 } END { printf "%.0f\n", total + 0 }')
+    while [ "$total" -gt "$capacity" ]; do
+        oldest=$(find "$dir" -maxdepth 1 -type f -name 'clipboard-*' ! -path "$file" \
+            -printf '%T@ %p\n' | sort -n | head -n 1)
+        if [ -z "$oldest" ]; then
+            break
+        fi
+        oldest=${oldest#* }
+        old_size=$(stat -c %s -- "$oldest" 2>/dev/null || printf '0')
+        if rm -f -- "$oldest"; then
+            total=$((total - old_size))
+        else
+            break
+        fi
+    done
+    if [ "$total" -gt "$capacity" ]; then
+        rm -f -- "$file"
+        flock -u 9
+        trap - EXIT HUP INT TERM
+        reply_error fifo_cleanup_failed
+        continue
+    fi
+    flock -u 9
+
+    trap - EXIT HUP INT TERM
+    printf '%s OK %s\n' "$protocol" "$file"
+done
