+impl ClipboardImageStore for RemoteClipboardImageStore {
+    fn store(&mut self, extension: &str, data: &[u8]) -> Result<String, StoreFailure> {
+        let result = self.store_once(extension, data);
+        if matches!(&result, Err(StoreFailure::Unavailable(_))) {
+            self.session.take();
+        }
+        result
+    }
+}
+
+struct RemoteImageStoreSession {
+    child: Child,
+    stdin: Option<ChildStdin>,
+    stdout: BufReader<ChildStdout>,
+}
+
+impl RemoteImageStoreSession {
+    fn read_response(&mut self) -> io::Result<StoreResponse> {
+        for _ in 0..16 {
+            let mut line = String::new();
+            if self.stdout.read_line(&mut line)? == 0 {
+                return Err(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "clipboard image ssh side channel closed",
+                ));
+            }
+            if line.len() > 4096 {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "clipboard image store response is too long",
+                ));
+            }
+            let line = line.trim_end_matches(['\r', '\n']);
+            let Some(rest) = line.strip_prefix(REMOTE_IMAGE_STORE_PROTOCOL) else {
+                continue;
+            };
+            if rest == " READY" {
+                return Ok(StoreResponse::Ready);
+            }
+            if let Some(path) = rest.strip_prefix(" OK ") {
+                return Ok(StoreResponse::Stored(path.to_owned()));
+            }
+            if let Some(reason) = rest.strip_prefix(" ERR ") {
+                return Ok(StoreResponse::Error(reason.to_owned()));
+            }
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid clipboard image store response",
+            ));
+        }
+        Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "clipboard image store emitted too much non-protocol output",
+        ))
+    }
+}
+
+impl Drop for RemoteImageStoreSession {
+    fn drop(&mut self) {
+        self.stdin.take();
+        if self.child.try_wait().ok().flatten().is_none() {
+            let _ = self.child.kill();
+        }
+        let _ = self.child.wait();
+    }
+}
+
+enum StoreResponse {
+    Ready,
+    Stored(String),
+    Error(String),
+}
