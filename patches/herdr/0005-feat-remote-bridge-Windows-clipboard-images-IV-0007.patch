diff --git a/src/platform/windows_clipboard.rs b/src/platform/windows_clipboard.rs
new file mode 100644
index 00000000..612ce383
--- /dev/null
+++ b/src/platform/windows_clipboard.rs
@@ -0,0 +1,325 @@
+//! Pure Windows clipboard bitmap decoding.
+//!
+//! Kept free of Win32 calls so the DIB parser can be exercised by the normal
+//! cross-platform test suite. The Windows platform layer owns the clipboard
+//! handle and passes either registered PNG bytes or a packed CF_DIB/CF_DIBV5
+//! payload here.
+
+const PNG_SIGNATURE: &[u8; 8] = b"\x89PNG\r\n\x1a\n";
+const BITMAPINFOHEADER_SIZE: usize = 40;
+const BITMAPV5HEADER_SIZE: usize = 124;
+const BI_RGB: u32 = 0;
+const BI_BITFIELDS: u32 = 3;
+const BI_ALPHABITFIELDS: u32 = 6;
+const MAX_DIB_PIXELS: usize = 32 * 1024 * 1024;
+
+pub(super) fn registered_png(bytes: &[u8]) -> Option<Vec<u8>> {
+    bytes.starts_with(PNG_SIGNATURE).then(|| bytes.to_vec())
+}
+
+pub(super) fn dib_to_png(dib: &[u8]) -> Option<Vec<u8>> {
+    let header_size = read_u32(dib, 0)? as usize;
+    if header_size < BITMAPINFOHEADER_SIZE || header_size > dib.len() {
+        return None;
+    }
+
+    let width = read_i32(dib, 4)?;
+    let signed_height = read_i32(dib, 8)?;
+    if width <= 0 || signed_height == 0 || signed_height == i32::MIN {
+        return None;
+    }
+    let width = width as usize;
+    let height = signed_height.unsigned_abs() as usize;
+    let top_down = signed_height < 0;
+    if width.checked_mul(height)? > MAX_DIB_PIXELS {
+        return None;
+    }
+
+    if read_u16(dib, 12)? != 1 {
+        return None;
+    }
+    let bits_per_pixel = read_u16(dib, 14)?;
+    let compression = read_u32(dib, 16)?;
+    if !matches!(bits_per_pixel, 24 | 32)
+        || (bits_per_pixel == 24 && compression != BI_RGB)
+        || (bits_per_pixel == 32
+            && !matches!(compression, BI_RGB | BI_BITFIELDS | BI_ALPHABITFIELDS))
+    {
+        return None;
+    }
+
+    let masks = if bits_per_pixel == 32 && compression != BI_RGB {
+        Some(read_color_masks(dib, header_size, compression)?)
+    } else {
+        None
+    };
+    let pixel_offset = pixel_offset(dib, header_size, bits_per_pixel, compression)?;
+    let row_bits = width.checked_mul(bits_per_pixel as usize)?;
+    let row_stride = row_bits.checked_add(31)?.checked_div(32)?.checked_mul(4)?;
+    let pixel_bytes = row_stride.checked_mul(height)?;
+    if pixel_offset.checked_add(pixel_bytes)? > dib.len() {
+        return None;
+    }
+
+    let rgba_len = width.checked_mul(height)?.checked_mul(4)?;
+    let mut rgba = Vec::with_capacity(rgba_len);
+    let mut any_alpha = false;
+    for output_y in 0..height {
+        let source_y = if top_down {
+            output_y
+        } else {
+            height - output_y - 1
+        };
+        let row_start = pixel_offset.checked_add(source_y.checked_mul(row_stride)?)?;
+        let row = dib.get(row_start..row_start.checked_add(row_stride)?)?;
+
+        for x in 0..width {
+            if bits_per_pixel == 24 {
+                let offset = x.checked_mul(3)?;
+                let blue = *row.get(offset)?;
+                let green = *row.get(offset + 1)?;
+                let red = *row.get(offset + 2)?;
+                rgba.extend_from_slice(&[red, green, blue, 255]);
+                continue;
+            }
+
+            let offset = x.checked_mul(4)?;
+            let pixel = u32::from_le_bytes(row.get(offset..offset + 4)?.try_into().ok()?);
+            let (red, green, blue, alpha) = if let Some(masks) = masks {
+                (
+                    masked_component(pixel, masks.red),
+                    masked_component(pixel, masks.green),
+                    masked_component(pixel, masks.blue),
+                    masks
+                        .alpha
+                        .map(|mask| masked_component(pixel, mask))
+                        .unwrap_or(255),
+                )
+            } else {
+                let bytes = pixel.to_le_bytes();
+                (bytes[2], bytes[1], bytes[0], bytes[3])
+            };
+            any_alpha |= alpha != 0;
+            rgba.extend_from_slice(&[red, green, blue, alpha]);
+        }
+    }
+
+    // BI_RGB's fourth byte is reserved rather than a guaranteed alpha
+    // channel. Clipboard producers commonly zero it for otherwise opaque
+    // screenshots, so treat an entirely-zero plane as opaque.
+    if bits_per_pixel == 32 && masks.is_none() && !any_alpha {
+        for alpha in rgba.iter_mut().skip(3).step_by(4) {
+            *alpha = 255;
+        }
+    }
+
+    encode_rgba_png(width as u32, height as u32, &rgba)
+}
+
+#[derive(Clone, Copy)]
+struct ColorMasks {
+    red: u32,
+    green: u32,
+    blue: u32,
+    alpha: Option<u32>,
+}
+
+fn read_color_masks(dib: &[u8], header_size: usize, compression: u32) -> Option<ColorMasks> {
+    let mask_offset = if header_size == BITMAPINFOHEADER_SIZE {
+        header_size
+    } else {
+        40
+    };
+    let red = read_u32(dib, mask_offset)?;
+    let green = read_u32(dib, mask_offset + 4)?;
+    let blue = read_u32(dib, mask_offset + 8)?;
+    if red == 0 || green == 0 || blue == 0 {
+        return None;
+    }
+    let alpha = if compression == BI_ALPHABITFIELDS || header_size >= 56 {
+        read_u32(dib, mask_offset + 12).filter(|mask| *mask != 0)
+    } else {
+        None
+    };
+    Some(ColorMasks {
+        red,
+        green,
+        blue,
+        alpha,
+    })
+}
+
+fn pixel_offset(
+    dib: &[u8],
+    header_size: usize,
+    bits_per_pixel: u16,
+    compression: u32,
+) -> Option<usize> {
+    let mut offset = header_size;
+    if header_size == BITMAPINFOHEADER_SIZE && matches!(compression, BI_BITFIELDS | BI_ALPHABITFIELDS)
+    {
+        offset = offset.checked_add(if compression == BI_ALPHABITFIELDS { 16 } else { 12 })?;
+    }
+
+    // CF_DIBV5 may place an embedded color profile between its header and
+    // pixel array. Honor it only when it occupies that exact packed-DIB slot;
+    // profiles stored after the bitmap must not move the pixel offset.
+    if header_size >= BITMAPV5HEADER_SIZE {
+        let profile_offset = read_u32(dib, 112)? as usize;
+        let profile_size = read_u32(dib, 116)? as usize;
+        if profile_size != 0 && profile_offset == offset {
+            offset = offset.checked_add(profile_size)?;
+        }
+    }
+
+    // The supported 24/32-bit formats have no palette. Keep the calculation
+    // explicit so extending this decoder to indexed DIBs cannot accidentally
+    // interpret their color table as pixels.
+    if bits_per_pixel <= 8 {
+        let colors_used = read_u32(dib, 32)? as usize;
+        let palette_entries = if colors_used == 0 {
+            1usize.checked_shl(bits_per_pixel.into())?
+        } else {
+            colors_used
+        };
+        offset = offset.checked_add(palette_entries.checked_mul(4)?)?;
+    }
+    Some(offset)
+}
+
+fn masked_component(pixel: u32, mask: u32) -> u8 {
+    let shift = mask.trailing_zeros();
+    let maximum = mask >> shift;
+    if maximum == 0 {
+        return 0;
+    }
+    let value = (pixel & mask) >> shift;
+    ((u64::from(value) * 255 + u64::from(maximum) / 2) / u64::from(maximum)) as u8
+}
+
+fn encode_rgba_png(width: u32, height: u32, rgba: &[u8]) -> Option<Vec<u8>> {
+    let mut output = Vec::new();
+    {
+        let mut encoder = png::Encoder::new(&mut output, width, height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().ok()?;
+        writer.write_image_data(rgba).ok()?;
+    }
+    registered_png(&output)
+}
+
+fn read_u16(bytes: &[u8], offset: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(
+        bytes.get(offset..offset.checked_add(2)?)?.try_into().ok()?,
+    ))
+}
+
+fn read_u32(bytes: &[u8], offset: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(
+        bytes.get(offset..offset.checked_add(4)?)?.try_into().ok()?,
+    ))
+}
+
+fn read_i32(bytes: &[u8], offset: usize) -> Option<i32> {
+    Some(i32::from_le_bytes(
+        bytes.get(offset..offset.checked_add(4)?)?.try_into().ok()?,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn write_u16(bytes: &mut [u8], offset: usize, value: u16) {
+        bytes[offset..offset + 2].copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn write_u32(bytes: &mut [u8], offset: usize, value: u32) {
+        bytes[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn write_i32(bytes: &mut [u8], offset: usize, value: i32) {
+        bytes[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn decode_png(bytes: &[u8]) -> (u32, u32, Vec<u8>) {
+        let decoder = png::Decoder::new(std::io::Cursor::new(bytes));
+        let mut reader = decoder.read_info().expect("PNG header");
+        let mut output = vec![0; reader.output_buffer_size()];
+        let info = reader.next_frame(&mut output).expect("PNG frame");
+        output.truncate(info.buffer_size());
+        (info.width, info.height, output)
+    }
+
+    #[test]
+    fn decodes_bottom_up_24_bit_dib_with_row_padding() {
+        let mut dib = vec![0; BITMAPINFOHEADER_SIZE + 16];
+        write_u32(&mut dib, 0, BITMAPINFOHEADER_SIZE as u32);
+        write_i32(&mut dib, 4, 2);
+        write_i32(&mut dib, 8, 2);
+        write_u16(&mut dib, 12, 1);
+        write_u16(&mut dib, 14, 24);
+        // Bottom row: blue, white, then two bytes of stride padding.
+        dib[40..48].copy_from_slice(&[255, 0, 0, 255, 255, 255, 0, 0]);
+        // Top row: red, green, then padding.
+        dib[48..56].copy_from_slice(&[0, 0, 255, 0, 255, 0, 0, 0]);
+
+        let png = dib_to_png(&dib).expect("decode DIB");
+        let (width, height, rgba) = decode_png(&png);
+        assert_eq!((width, height), (2, 2));
+        assert_eq!(
+            rgba,
+            vec![
+                255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255,
+            ]
+        );
+    }
+
+    #[test]
+    fn decodes_top_down_v5_bitfields_with_alpha() {
+        let mut dib = vec![0; BITMAPV5HEADER_SIZE + 4];
+        write_u32(&mut dib, 0, BITMAPV5HEADER_SIZE as u32);
+        write_i32(&mut dib, 4, 1);
+        write_i32(&mut dib, 8, -1);
+        write_u16(&mut dib, 12, 1);
+        write_u16(&mut dib, 14, 32);
+        write_u32(&mut dib, 16, BI_BITFIELDS);
+        write_u32(&mut dib, 40, 0x00ff_0000);
+        write_u32(&mut dib, 44, 0x0000_ff00);
+        write_u32(&mut dib, 48, 0x0000_00ff);
+        write_u32(&mut dib, 52, 0xff00_0000);
+        dib[BITMAPV5HEADER_SIZE..].copy_from_slice(&[30, 20, 10, 40]);
+
+        let png = dib_to_png(&dib).expect("decode DIBV5");
+        let (_, _, rgba) = decode_png(&png);
+        assert_eq!(rgba, vec![10, 20, 30, 40]);
+    }
+
+    #[test]
+    fn treats_zeroed_bi_rgb_alpha_plane_as_opaque() {
+        let mut dib = vec![0; BITMAPINFOHEADER_SIZE + 4];
+        write_u32(&mut dib, 0, BITMAPINFOHEADER_SIZE as u32);
+        write_i32(&mut dib, 4, 1);
+        write_i32(&mut dib, 8, 1);
+        write_u16(&mut dib, 12, 1);
+        write_u16(&mut dib, 14, 32);
+        dib[BITMAPINFOHEADER_SIZE..].copy_from_slice(&[3, 2, 1, 0]);
+
+        let png = dib_to_png(&dib).expect("decode BI_RGB");
+        let (_, _, rgba) = decode_png(&png);
+        assert_eq!(rgba, vec![1, 2, 3, 255]);
+    }
+
+    #[test]
+    fn rejects_unsupported_compressed_dib() {
+        let mut dib = vec![0; BITMAPINFOHEADER_SIZE + 4];
+        write_u32(&mut dib, 0, BITMAPINFOHEADER_SIZE as u32);
+        write_i32(&mut dib, 4, 1);
+        write_i32(&mut dib, 8, 1);
+        write_u16(&mut dib, 12, 1);
+        write_u16(&mut dib, 14, 32);
+        write_u32(&mut dib, 16, 4);
+        assert!(dib_to_png(&dib).is_none());
+    }
+}
