+/// Writes the host terminal default-color query (OSC 10/11) to stdout.
+///
+/// Used by the Windows console reader to re-query after the host reports a
+/// color scheme change, mirroring the Unix client's behavior.
+#[cfg(windows)]
+fn write_host_terminal_theme_query_to_stdout() -> std::io::Result<()> {
+    use std::io::Write as _;
+    let mut stdout = std::io::stdout();
+    stdout.write_all(crate::terminal_theme::HOST_COLOR_QUERY_SEQUENCE.as_bytes())?;
+    stdout.flush()
+}
+
