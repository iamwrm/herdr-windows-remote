+}
+
+#[cfg(windows)]
+fn flush_pump_theme_reports(
+    pump: &mut WindowsInputPump,
+    event_tx: &mpsc::Sender<ClientLoopEvent>,
+) -> bool {
+    let outbox = pump.take_theme_reports();
+    if outbox.requery {
+        // The host announced a color scheme change: re-query the concrete
+        // default colors, mirroring the Unix client's behavior.
+        let _ = super::write_host_terminal_theme_query_to_stdout();
+    }
+    if outbox.bytes.is_empty() {
+        return true;
     }
+    event_tx
+        .blocking_send(ClientLoopEvent::StdinThemeReport(outbox.bytes))
+        .is_ok()
 }
 
