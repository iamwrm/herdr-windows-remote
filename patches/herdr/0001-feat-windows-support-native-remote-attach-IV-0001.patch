index 0000000..383343c
--- /dev/null
+++ b/src/remote/windows.rs
@@ -0,0 +1,370 @@
+//! Windows platform pieces of remote attach.
+//!
+//! The local bridge socket is a named pipe served through `crate::ipc` — the
+//! same transport the Windows thin client (`herdr client`) already speaks for
+//! local attach. Each accepted pipe connection is spliced onto the stdio of
+//! `ssh -T <target> "exec <remote-herdr> remote-client-bridge"`, exactly like
+//! the Unix implementation.
+//!
+//! Differences from Unix, forced by the platform:
+//!
+//! - Windows OpenSSH does not implement ControlMaster/ControlPath connection
+//!   multiplexing, so there is no managed ssh config. Keepalive options are
+//!   injected as `-o` command-line flags instead. Every ssh invocation is a
+//!   full new connection; use key-based auth (with `ssh-agent`) to avoid
+//!   repeated password prompts.
+//! - Named pipes have no half-close: dropping the send half of a split stream
+//!   does not deliver EOF to the peer, and reads cannot be unblocked by a
+//!   shutdown from another thread. The client→ssh pump therefore polls with
+//!   `PeekNamedPipe` (like `crate::ipc::poll_local_stream_read` does) instead
+//!   of blocking in `read`, so the whole pipe can be dropped — which *is*
+//!   observable by the client — once the ssh transport dies.
+
+use std::fs;
+use std::io::{self, Read as _};
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use interprocess::local_socket::traits::Listener as _;
+
+use super::launcher::{
+    copy_flush, remote_bridge_command, remote_timing, sanitize_path_component, RemoteHerdr,
+};
+use crate::ipc::LocalStream;
+
+/// How often the client→ssh pump checks for new client data or a stop
+/// request. Only waited out when the client is idle; pending input is drained
+/// before sleeping again.
+const CLIENT_READ_POLL: Duration = Duration::from_millis(10);
+
+/// Windows has no ssh connection multiplexing, so the "managed" options are
+/// just inline keepalive flags for every ssh command we spawn.
+#[derive(Clone, Debug)]
+pub(crate) struct ManagedSshOptions {
+    keepalive: bool,
+}
+
+pub(crate) struct ManagedSshConfig {
+    options: ManagedSshOptions,
+}
+
+impl ManagedSshConfig {
+    pub(crate) fn options(&self) -> &ManagedSshOptions {
+        &self.options
+    }
+}
+
+/// No config file is written on Windows; `remote.manage_ssh_config = true`
+/// (the default) just opts into herdr's keepalive `-o` flags. Unlike the Unix
+/// managed config these override `ServerAlive*` values from the user's own
+/// ssh config, because OpenSSH gives command-line options top precedence.
+pub(crate) fn write_managed_ssh_config() -> io::Result<ManagedSshConfig> {
+    Ok(ManagedSshConfig {
+        options: ManagedSshOptions { keepalive: true },
+    })
+}
+
+pub(crate) fn apply_managed_ssh_options(
+    command: &mut Command,
+    options: Option<&ManagedSshOptions>,
+) {
+    let Some(options) = options else {
+        return;
+    };
+    if options.keepalive {
+        command
+            .arg("-o")
+            .arg("ServerAliveInterval=15")
+            .arg("-o")
+            .arg("ServerAliveCountMax=4");
+    }
+}
+
+/// Nothing to tear down: no ControlMaster connection exists on Windows.
+pub(crate) fn teardown_remote_ssh(_ssh: &super::launcher::RemoteSsh) {}
+
+/// `herdr remote-client-bridge` runs on the *remote* host. Windows hosts
+/// cannot be remote-attach targets yet.
+pub(crate) fn run_remote_client_bridge() -> io::Result<()> {
+    Err(io::Error::other(
+        "remote client bridge is not supported on Windows yet (Windows hosts cannot be `--remote` targets)",
+    ))
+}
+
+/// Marker-file path whose string form doubles as the named-pipe name through
+/// `crate::ipc` (`GenericNamespaced`). No `sun_path` length limits apply.
+pub(crate) fn local_forward_socket_path(target: &str, session_name: &str) -> PathBuf {
+    let pid = std::process::id();
+    let target_clean = sanitize_path_component(target);
+    let session_clean = sanitize_path_component(session_name);
+
+    std::env::temp_dir().join(format!(
+        "herdr-remote-{pid}-{target_clean}-{session_clean}.sock"
+    ))
+}
+
+pub(crate) struct SshStdioBridge {
+    local_socket: PathBuf,
+    should_stop: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl SshStdioBridge {
+    pub(crate) fn start(
+        target: String,
+        remote_herdr: RemoteHerdr,
+        local_socket: PathBuf,
+        session_name: String,
+        ssh_options: Option<&ManagedSshOptions>,
+    ) -> io::Result<Self> {
+        let _ = fs::remove_file(&local_socket);
+        let listener = crate::ipc::bind_local_listener(&local_socket)?;
+
+        let should_stop = Arc::new(AtomicBool::new(false));
+        let thread_stop = Arc::clone(&should_stop);
+        let thread_ssh_options = ssh_options.cloned();
+        let thread = thread::spawn(move || {
+            // Blocking accept; `Drop` wakes it with a throwaway connection
+            // after setting `should_stop`.
+            loop {
+                match listener.accept() {
+                    Ok(stream) => {
+                        if thread_stop.load(Ordering::Acquire) {
+                            break;
+                        }
+                        if let Err(err) = bridge_connection(
+                            stream,
+                            &target,
+                            &remote_herdr,
+                            &session_name,
+                            thread_ssh_options.as_ref(),
+                        ) {
+                            eprintln!("herdr: remote bridge failed: {err}");
+                        }
+                        if thread_stop.load(Ordering::Acquire) {
+                            break;
+                        }
+                    }
+                    Err(err) => {
+                        if thread_stop.load(Ordering::Acquire) {
+                            break;
+                        }
+                        eprintln!("herdr: remote bridge listener failed: {err}");
+                        break;
+                    }
+                }
+            }
+        });
+
+        Ok(Self {
+            local_socket,
+            should_stop,
+            thread: Some(thread),
+        })
+    }
+}
+
+impl Drop for SshStdioBridge {
+    fn drop(&mut self) {
+        // Order matters: the stop flag must be visible before the wake
+        // connection, so the accept loop cannot re-enter `accept` after
+        // consuming the wake without seeing the flag.
+        self.should_stop.store(true, Ordering::Release);
+        // The wake stream must stay open until the thread is joined:
+        // interprocess' accept treats an already-disconnected client as an
+        // "empty connection", clears it, and keeps blocking (ERROR_NO_DATA
+        // loop in `block_on_connect_clearing_empty_conns`).
+        let wake = crate::ipc::connect_local_stream(&self.local_socket);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+        drop(wake);
+        let _ = fs::remove_file(&self.local_socket);
+    }
+}
+
+fn bridge_connection(
+    stream: LocalStream,
+    target: &str,
+    remote_herdr: &RemoteHerdr,
+    session_name: &str,
+    ssh_options: Option<&ManagedSshOptions>,
+) -> io::Result<()> {
+    let mut command = Command::new("ssh");
+    apply_managed_ssh_options(&mut command, ssh_options);
+    command
+        .arg("-T")
+        .arg(target)
+        .arg(remote_bridge_command(remote_herdr, session_name));
+    command
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit());
+
+    let spawn_started = std::time::Instant::now();
+    let mut child = command
+        .spawn()
+        .map_err(|err| io::Error::new(err.kind(), format!("failed to start ssh bridge: {err}")))?;
+    remote_timing("bridge: ssh transport spawn", target, spawn_started.elapsed());
+    let mut child_stdin = child
+        .stdin
+        .take()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::BrokenPipe, "ssh bridge stdin missing"))?;
+    let mut child_stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::BrokenPipe, "ssh bridge stdout missing"))?;
+
+    // `&LocalStream` implements `Read`/`Write`, so both pumps can share one
+    // pipe handle through an `Arc` — no half-close semantics needed.
+    let stream = Arc::new(stream);
+    let upload_stream = Arc::clone(&stream);
+    let download_stream = Arc::clone(&stream);
+    let stop = Arc::new(AtomicBool::new(false));
+    let upload_stop = Arc::clone(&stop);
+
+    let upload = thread::spawn(move || {
+        pump_client_to_ssh(&upload_stream, &mut child_stdin, &upload_stop);
+        // Dropping `child_stdin` closes the remote bridge's stdin so the
+        // remote side detaches this client.
+    });
+    let download = thread::spawn(move || {
+        let _ = copy_flush(&mut child_stdout, &mut &*download_stream);
+    });
+
+    let status = child.wait()?;
+    let _ = download.join();
+    stop.store(true, Ordering::Release);
+    let _ = upload.join();
+    // All Arc clones are gone here: the pipe handle closes, which the client
+    // observes as a broken pipe and reports as a lost connection.
+    drop(stream);
+
+    if status.success() {
+        Ok(())
+    } else {
+        Err(io::Error::new(
+            io::ErrorKind::ConnectionAborted,
+            format!("ssh bridge exited with {status}"),
+        ))
+    }
+}
+
+/// Pumps client bytes into ssh's stdin without ever blocking in `read`, so a
+/// stop request (ssh died) is honored even while the client is idle.
+fn pump_client_to_ssh(
+    stream: &LocalStream,
+    child_stdin: &mut (impl io::Write + Send),
+    stop: &AtomicBool,
+) {
+    let mut buffer = [0_u8; 16 * 1024];
+    loop {
+        if stop.load(Ordering::Acquire) {
+            return;
+        }
+        match crate::ipc::windows_named_pipe_available(stream) {
+            // Client closed its end of the pipe.
+            Ok(None) => return,
+            Ok(Some(0)) => thread::sleep(CLIENT_READ_POLL),
+            Ok(Some(_)) => {
+                let mut reader = stream;
+                match reader.read(&mut buffer) {
+                    Ok(0) => return,
+                    Ok(bytes_read) => {
+                        if child_stdin
+                            .write_all(&buffer[..bytes_read])
+                            .and_then(|()| child_stdin.flush())
+                            .is_err()
+                        {
+                            return;
+                        }
+                    }
+                    Err(err) if err.kind() == io::ErrorKind::Interrupted => {}
+                    Err(_) => return,
+                }
+            }
+            Err(_) => return,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::launcher::RemotePlatform;
+    use super::*;
+
+    #[test]
+    fn local_forward_socket_path_uses_readable_name() {
+        let path = local_forward_socket_path("user@host:22", "default");
+        let filename = path
+            .file_name()
+            .and_then(|s| s.to_str())
+            .unwrap_or("")
+            .to_string();
+        assert!(
+            filename.starts_with("herdr-remote-"),
+            "expected readable name, got {filename}"
+        );
+        assert!(
+            filename.contains("-user-host-22-default."),
+            "got {filename}"
+        );
+    }
+
+    #[test]
+    fn keepalive_options_apply_only_when_managed() {
+        let config = write_managed_ssh_config().expect("managed options");
+        let mut command = Command::new("ssh");
+        apply_managed_ssh_options(&mut command, Some(config.options()));
+        let args = command
+            .get_args()
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect::<Vec<_>>();
+        assert_eq!(
+            args,
+            vec![
+                "-o".to_string(),
+                "ServerAliveInterval=15".to_string(),
+                "-o".to_string(),
+                "ServerAliveCountMax=4".to_string(),
+            ]
+        );
+
+        let mut plain = Command::new("ssh");
+        apply_managed_ssh_options(&mut plain, None);
+        assert_eq!(plain.get_args().count(), 0);
+    }
+
+    #[test]
+    fn bridge_drop_wakes_blocking_accept_without_spawning_ssh() {
+        let socket = std::env::temp_dir().join(format!(
+            "herdr-bridge-drop-test-{}.sock",
+            std::process::id()
+        ));
+        let remote_herdr = RemoteHerdr::for_platform(RemotePlatform {
+            os: "linux",
+            arch: "x86_64",
+        });
+        let bridge = SshStdioBridge::start(
+            "bridge-drop-test-nonexistent-host.invalid".to_string(),
+            remote_herdr,
+            socket.clone(),
+            "default".to_string(),
+            None,
+        )
+        .expect("start bridge listener");
+
+        // Dropping must set the stop flag, wake the blocked accept with a
+        // throwaway connection, join the thread, and remove the marker file —
+        // all without ever spawning ssh toward the bogus target.
+        drop(bridge);
+
+        assert!(!socket.exists(), "marker file should be cleaned up");
+    }
+}
