+    fn cell_has_base_style(&self, x: u16, y: u16, base_sgr: &str, reversed: bool) -> bool {
+        self.model
+            .cell(x, y)
+            .and_then(|cell| cell.prediction_style.as_ref())
+            .is_some_and(|style| style.base_sgr.as_ref() == base_sgr && style.reversed == reversed)
+    }
+
+    fn prediction_cursor(&self) -> Option<PredictionCursor> {
+        if let Some(prediction) = self.pending.front() {
+            return Some(prediction.cursor.clone());
+        }
+        if self.model.cursor_visible() {
+            return Some(PredictionCursor::Hardware);
+        }
+        let (x, y) = self.model.cursor();
+        if x + 1 >= self.model.width() {
+            return None;
+        }
+        let caret = self.model.cell(x, y)?.prediction_style.as_ref()?;
+        let next = self.model.cell(x + 1, y)?.prediction_style.as_ref()?;
+        (caret.reversed && !next.reversed && caret.base_sgr == next.base_sgr).then(|| {
+            PredictionCursor::Software {
+                base_sgr: caret.base_sgr.clone(),
+            }
+        })
+    }
+
+    fn server_cursor_matches_chain(&self) -> bool {
+        let Some(prediction) = self.pending.front() else {
+            return true;
+        };
+        match &prediction.cursor {
+            PredictionCursor::Hardware => self.model.cursor_visible(),
+            PredictionCursor::Software { base_sgr } => {
+                if self.model.cursor_visible() {
+                    return false;
+                }
+                let (x, y) = self.model.cursor();
+                self.cell_has_base_style(x, y, base_sgr, true)
+            }
+        }
+    }
