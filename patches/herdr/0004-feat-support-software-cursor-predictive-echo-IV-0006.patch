+use std::sync::Arc;
+
+/// The SGR sequence `build_sgr` emits for a completely unstyled cell.
+const PLAIN_SGR: &str = "\x1b[0;39;49m";
+
+/// A cell style safe for predictive echo. Colors are preserved, while the
+/// only accepted modifier is reverse video (used by software cursors).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct PredictionStyle {
+    pub(crate) base_sgr: Arc<str>,
+    pub(crate) reversed: bool,
+}
+
+#[derive(Clone, Debug)]
+struct PenStyle {
+    sgr: Arc<str>,
+    prediction: Option<PredictionStyle>,
+}
+
+impl PenStyle {
+    fn plain() -> Self {
+        Self {
+            sgr: Arc::from(PLAIN_SGR),
+            prediction: Some(PredictionStyle {
+                base_sgr: Arc::from(PLAIN_SGR),
+                reversed: false,
+            }),
+        }
+    }
+
+    fn unknown() -> Self {
+        Self {
+            sgr: Arc::from(PLAIN_SGR),
+            prediction: None,
+        }
+    }
+}
+
+/// Parses the complete canonical SGR emitted by `render_ansi::build_sgr`.
+/// Retaining only colors and an optional reverse modifier keeps software
+/// cursor detection strict while supporting indexed and RGB themes.
+fn parse_pen_style(params: &str) -> PenStyle {
+    if matches!(params, "" | "0") {
+        return PenStyle::plain();
+    }
+
+    let sgr: Arc<str> = format!("\x1b[{params}m").into();
+    let parts = params.split(';').collect::<Vec<_>>();
+    if parts.first() != Some(&"0") {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let Some(fg_start) = parts
+        .iter()
+        .enumerate()
+        .skip(1)
+        .find_map(|(index, part)| is_fg_start(part).then_some(index))
+    else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+
+    let modifiers = &parts[1..fg_start];
+    let reversed = modifiers == ["7"];
+    if !modifiers.is_empty() && !reversed {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let Some(fg_end) = color_end(&parts, fg_start, true) else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+    let Some(bg_end) = color_end(&parts, fg_end, false) else {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    };
+    if bg_end != parts.len() {
+        return PenStyle {
+            sgr,
+            prediction: None,
+        };
+    }
+
+    let base_sgr: Arc<str> = format!(
+        "\x1b[0;{};{}m",
+        parts[fg_start..fg_end].join(";"),
+        parts[fg_end..bg_end].join(";")
+    )
+    .into();
+    PenStyle {
+        sgr,
+        prediction: Some(PredictionStyle { base_sgr, reversed }),
+    }
+}
+
+fn is_fg_start(part: &str) -> bool {
+    part.parse::<u16>()
