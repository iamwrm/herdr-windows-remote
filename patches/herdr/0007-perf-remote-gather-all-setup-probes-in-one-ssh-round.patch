+//! Combined remote setup probe (i0002 W2).
+//!
+//! The launcher historically ran 4–5 sequential ssh commands before the
+//! bridge could start (platform, PATH lookup, known-path scan, per-candidate
+//! version check, server status). On Windows every ssh command is a fresh
+//! connection (no ControlMaster), so at high RTT the probes dominated attach
+//! time. This module gathers all of them in **one** `ssh /bin/sh -s`
+//! invocation emitting a sentinel-tagged blob, plus a per-target cache that
+//! lets reattaches probe only the previously verified binary path.
+//!
+//! The decision logic in `launcher.rs` is unchanged — this module only
+//! changes how its inputs are gathered.
+
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest as _, Sha256};
+
+use super::launcher::{
+    client_status_protocol, command_failed, current_version, sanitize_path_component, shell_quote,
+    RemotePlatform, RemoteSsh, CURRENT_PROTOCOL,
+};
+
+/// Sentinel prefixing every probe output line, so login-shell rc noise in
+/// stdout cannot be mistaken for probe data.
+const SENTINEL: &str = "__HERDR_PROBE__";
+
+/// Kill switch for the per-target probe cache (`HERDR_REMOTE_NO_CACHE=1`).
+const NO_CACHE_ENV_VAR: &str = "HERDR_REMOTE_NO_CACHE";
+
+/// One remote herdr binary discovered by the probe script, with the results
+/// of running it. Paths are absolute and fully expanded by the remote shell.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CandidateProbe {
+    pub(crate) path: String,
+    /// First line of `<path> --version`, e.g. `herdr 0.7.4`.
+    pub(crate) version_line: Option<String>,
+    /// First line of `<path> status client --json`.
+    pub(crate) client_status_json: Option<String>,
+}
+
+impl CandidateProbe {
+    /// Mirrors `launcher::remote_binary_matches`: exact version line and
+    /// client protocol match against the local binary.
+    pub(crate) fn matches_current(&self) -> bool {
+        self.version_line.as_deref() == Some(expected_version_line().as_str())
+            && self
+                .client_status_json
+                .as_deref()
+                .and_then(client_status_protocol)
+                == Some(CURRENT_PROTOCOL)
+    }
+}
+
+/// Everything the launcher needs to know about the remote host, gathered in
+/// a single ssh round trip.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct RemoteProbe {
+    /// Raw `uname -s` value (kept for error messages).
+    pub(crate) uname_s: String,
+    /// Raw `uname -m` value (kept for error messages).
+    pub(crate) uname_m: String,
+    /// Parsed platform; `None` when unsupported or (cached fast probe) known
+    /// from the cache instead of uname.
+    pub(crate) platform: Option<RemotePlatform>,
+    /// Discovered binaries in priority order (login-shell PATH first, then
+    /// known install locations), deduplicated by path.
+    pub(crate) candidates: Vec<CandidateProbe>,
+    /// `status server --json` output from the best available binary.
+    pub(crate) server_status_json: Option<String>,
+    /// Whether the end marker was seen (output not truncated).
+    complete: bool,
+}
+
+impl RemoteProbe {
+    pub(crate) fn matching_candidate(&self) -> Option<&CandidateProbe> {
+        self.candidates
+            .iter()
+            .find(|candidate| candidate.matches_current())
+    }
+
+    pub(crate) fn platform_detail(&self) -> String {
+        format!("{} {}", self.uname_s.trim(), self.uname_m.trim())
+    }
+}
+
+fn expected_version_line() -> String {
+    format!("herdr {}", current_version())
+}
+
+/// Runs the remote probe: a single-connection fast probe of the cached
+/// verified path when the cache is warm, falling back to (and replacing the
+/// cache after) the full probe. ssh transport errors always propagate —
+/// only *stale cache content* falls back.
+pub(crate) fn probe_remote(ssh: &RemoteSsh) -> io::Result<RemoteProbe> {
+    if let Some(cached) = load_cache(ssh.target()) {
+        let output = ssh.sh_output(&fast_probe_script(&cached.path))?;
+        if let Some(probe) = cached_probe_from_output(&output, &cached)? {
+            return Ok(probe);
+        }
+        remove_cache(ssh.target());
+    }
+
+    let output = ssh.sh_output(&full_probe_script())?;
+    if !output.status.success() {
+        return Err(command_failed("remote probe failed", &output));
+    }
+    let probe = parse_probe_output(&String::from_utf8_lossy(&output.stdout));
+    if !probe.complete {
+        return Err(io::Error::other(
+            "remote probe output was truncated (no end marker)",
+        ));
+    }
+    Ok(probe)
+}
+
+fn cached_probe_from_output(
+    output: &std::process::Output,
+    cached: &ProbeCacheEntry,
+) -> io::Result<Option<RemoteProbe>> {
+    if !output.status.success() {
+        return Err(command_failed("cached remote probe failed", output));
+    }
+
+    let mut probe = parse_probe_output(&String::from_utf8_lossy(&output.stdout));
+    if !probe.complete || probe.matching_candidate().is_none() {
+        return Ok(None);
+    }
+    probe.platform = RemotePlatform::from_ids(&cached.os, &cached.arch);
+    Ok(probe.platform.is_some().then_some(probe))
+}
+
+/// Shared shell prelude: the `probe` function runs one binary and emits its
+/// results; `first`/`best` track which binary should report server status
+/// (prefer one matching the local version).
+fn probe_script_prelude(header: &str) -> String {
+    format!(
+        r#"{header}
+S={SENTINEL}
+version={version}
+expected="herdr $version"
+first=
+best=
+probe() {{
+    p=$1
+    tag=$2
+    [ -n "$p" ] && [ -x "$p" ] || return 0
+    case "$p" in /*) ;; *) return 0 ;; esac
+    printf '%s %s %s\n' "$S" "$tag" "$p"
+    v=$("$p" --version 2>/dev/null | head -n 1)
+    if [ -n "$v" ]; then
+        printf '%s version %s\t%s\n' "$S" "$p" "$v"
+        cs=$("$p" status client --json 2>/dev/null | head -n 1)
+        if [ -n "$cs" ]; then
+            printf '%s client_status %s\t%s\n' "$S" "$p" "$cs"
+        fi
+        if [ -z "$first" ]; then
+            first=$p
+        fi
+        if [ "$v" = "$expected" ] && [ -z "$best" ]; then
+            best=$p
+        fi
+    fi
+    return 0
+}}
+"#,
+        version = shell_quote(&current_version()),
+    )
+}
+
+/// Shared shell epilogue: server status from the best binary + end marker.
+const PROBE_SCRIPT_EPILOGUE: &str = r#"status_bin=${best:-$first}
+if [ -n "$status_bin" ]; then
+    ss=$("$status_bin" status server --json 2>/dev/null | head -n 1)
+    if [ -n "$ss" ]; then
+        printf '%s server_status %s\n' "$S" "$ss"
+    fi
+fi
+printf '%s end\n' "$S"
+"#;
+
+/// The full probe: uname, login-shell PATH lookup, known install locations
+/// (same list `known_remote_binary_candidate_script` used to scan), then
+/// server status. Branches on `uname -s` because the platform is not known
+/// before the probe runs.
+pub(crate) fn full_probe_script() -> String {
+    let mut script = probe_script_prelude("# herdr remote probe (full)");
+    script.push_str(
+        r#"os=$(uname -s)
+printf '%s uname_s %s\n' "$S" "$os"
+printf '%s uname_m %s\n' "$S" "$(uname -m)"
+if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ]; then
+    path_out=$("$SHELL" -c 'command -v herdr' 2>/dev/null)
+    IFS='
+'
+    for line in $path_out; do
+        probe "$line" path_candidate
+    done
+    unset IFS
+fi
+if [ -n "${HOME:-}" ]; then
+    probe "$HOME/.local/bin/herdr" candidate
+fi
+case "$os" in
+    Darwin)
+        probe "/opt/homebrew/bin/herdr" candidate
+        probe "/usr/local/bin/herdr" candidate
+        ;;
+    Linux)
+        probe "/home/linuxbrew/.linuxbrew/bin/herdr" candidate
+        ;;
+esac
+if [ -n "${HOME:-}" ]; then
+    probe "$HOME/.local/share/mise/installs/herdr/$version/bin/herdr" candidate
+    probe "$HOME/.local/share/mise/installs/herdr/$version/herdr" candidate
+    probe "$HOME/.local/share/mise/installs/github-ogulcancelik-herdr/$version/herdr" candidate
+    probe "$HOME/.nix-profile/bin/herdr" candidate
+fi
+if [ -n "${USER:-}" ]; then
+    probe "/etc/profiles/per-user/$USER/bin/herdr" candidate
+fi
+probe "/nix/var/nix/profiles/default/bin/herdr" candidate
+probe "/run/current-system/sw/bin/herdr" candidate
+"#,
+    );
+    script.push_str(PROBE_SCRIPT_EPILOGUE);
+    script
+}
+
+/// The cached fast probe: check only the previously verified path (platform
+/// comes from the cache, so no uname round trip is needed either).
+pub(crate) fn fast_probe_script(cached_path: &str) -> String {
+    let mut script = probe_script_prelude("# herdr remote probe (cached path)");
+    script.push_str(&format!(
+        "probe {} candidate\n",
+        shell_quote(cached_path)
+    ));
+    script.push_str(PROBE_SCRIPT_EPILOGUE);
+    script
+}
+
+pub(crate) fn parse_probe_output(stdout: &str) -> RemoteProbe {
+    let mut probe = RemoteProbe {
+        uname_s: String::new(),
+        uname_m: String::new(),
+        platform: None,
+        candidates: Vec::new(),
+        server_status_json: None,
+        complete: false,
+    };
+
+    for line in stdout.lines() {
+        let Some(rest) = line.strip_prefix(SENTINEL).and_then(|rest| rest.strip_prefix(' '))
+        else {
+            continue;
+        };
+        let (tag, value) = rest.split_once(' ').unwrap_or((rest, ""));
+        match tag {
+            "uname_s" => probe.uname_s = value.to_string(),
+            "uname_m" => probe.uname_m = value.to_string(),
+            "path_candidate" | "candidate" => {
+                if !probe
+                    .candidates
+                    .iter()
+                    .any(|candidate| candidate.path == value)
+                {
+                    probe.candidates.push(CandidateProbe {
+                        path: value.to_string(),
+                        version_line: None,
+                        client_status_json: None,
+                    });
+                }
+            }
+            "version" | "client_status" => {
+                let Some((path, payload)) = value.split_once('\t') else {
+                    continue;
+                };
+                let Some(candidate) = probe
+                    .candidates
+                    .iter_mut()
+                    .find(|candidate| candidate.path == path)
+                else {
+                    continue;
+                };
+                if tag == "version" {
+                    candidate.version_line = Some(payload.to_string());
+                } else {
+                    candidate.client_status_json = Some(payload.to_string());
+                }
+            }
+            "server_status" => probe.server_status_json = Some(value.to_string()),
+            "end" => probe.complete = true,
+            _ => {}
+        }
+    }
+
+    probe.platform = RemotePlatform::from_uname(&probe.uname_s, &probe.uname_m);
+    probe
+}
+
+// ---------------------------------------------------------------------------
+// Per-target probe cache
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct ProbeCacheEntry {
+    /// Local herdr version the entry was verified against.
+    pub(crate) herdr_version: String,
+    /// Expanded absolute path of the verified remote binary.
+    pub(crate) path: String,
+    /// Remote platform ids (`linux`/`macos`, `x86_64`/`aarch64`).
+    pub(crate) os: String,
+    pub(crate) arch: String,
+}
+
+fn cache_disabled() -> bool {
+    std::env::var_os(NO_CACHE_ENV_VAR).is_some_and(|value| !value.is_empty())
+}
+
+fn cache_dir() -> PathBuf {
+    crate::config::state_dir().join("remote-probe-cache")
+}
+
+fn cache_file(target: &str) -> PathBuf {
+    let readable_target = sanitize_path_component(target);
+    let target_digest = format!("{:x}", Sha256::digest(target.as_bytes()));
+    cache_dir().join(format!("{readable_target}-{target_digest}.json"))
+}
+
+fn load_cache(target: &str) -> Option<ProbeCacheEntry> {
+    if cache_disabled() {
+        return None;
+    }
+    let contents = fs::read_to_string(cache_file(target)).ok()?;
+    let entry: ProbeCacheEntry = serde_json::from_str(&contents).ok()?;
+    (entry.herdr_version == current_version()).then_some(entry)
+}
+
+pub(crate) fn save_cache(target: &str, path: &str, platform: &RemotePlatform) {
+    if cache_disabled() {
+        return;
+    }
+    let entry = ProbeCacheEntry {
+        herdr_version: current_version(),
+        path: path.to_string(),
+        os: platform.os.to_string(),
+        arch: platform.arch.to_string(),
+    };
+    let Ok(contents) = serde_json::to_string_pretty(&entry) else {
+        return;
+    };
+    let file = cache_file(target);
+    if let Some(parent) = file.parent() {
+        let _ = fs::create_dir_all(parent);
+    }
+    let _ = fs::write(file, contents);
+}
+
+fn remove_cache(target: &str) {
+    let _ = fs::remove_file(cache_file(target));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn parse(lines: &[&str]) -> RemoteProbe {
+        parse_probe_output(&lines.join("\n"))
+    }
+
+    #[test]
+    fn parse_reads_platform_candidates_and_server_status() {
+        let probe = parse(&[
+            "login shell noise",
+            "__HERDR_PROBE__ uname_s Linux",
+            "__HERDR_PROBE__ uname_m x86_64",
+            "__HERDR_PROBE__ path_candidate /usr/bin/herdr",
+            "__HERDR_PROBE__ version /usr/bin/herdr\therdr 0.7.4",
+            "__HERDR_PROBE__ client_status /usr/bin/herdr\t{\"protocol\":11}",
+            "__HERDR_PROBE__ candidate /home/can/.local/bin/herdr",
+            "__HERDR_PROBE__ server_status {\"running\":false}",
+            "__HERDR_PROBE__ end",
+        ]);
+
+        assert_eq!(
+            probe.platform,
+            Some(RemotePlatform {
+                os: "linux",
+                arch: "x86_64"
+            })
+        );
+        assert_eq!(probe.candidates.len(), 2);
+        assert_eq!(probe.candidates[0].path, "/usr/bin/herdr");
+        assert_eq!(
+            probe.candidates[0].version_line.as_deref(),
+            Some("herdr 0.7.4")
+        );
+        assert_eq!(
+            probe.candidates[0].client_status_json.as_deref(),
+            Some("{\"protocol\":11}")
+        );
+        assert_eq!(probe.candidates[1].path, "/home/can/.local/bin/herdr");
+        assert_eq!(
+            probe.server_status_json.as_deref(),
+            Some("{\"running\":false}")
+        );
+        assert!(probe.complete);
+    }
+
+    #[test]
+    fn parse_dedups_candidates_and_keeps_priority_order() {
+        let probe = parse(&[
+            "__HERDR_PROBE__ path_candidate /home/can/.local/bin/herdr",
+            "__HERDR_PROBE__ candidate /home/can/.local/bin/herdr",
+            "__HERDR_PROBE__ candidate /usr/local/bin/herdr",
+            "__HERDR_PROBE__ end",
+        ]);
+
+        assert_eq!(probe.candidates.len(), 2);
+        assert_eq!(probe.candidates[0].path, "/home/can/.local/bin/herdr");
+        assert_eq!(probe.candidates[1].path, "/usr/local/bin/herdr");
+    }
+
+    #[test]
+    fn parse_without_end_marker_is_incomplete() {
+        let probe = parse(&["__HERDR_PROBE__ uname_s Linux"]);
+        assert!(!probe.complete);
+    }
+
+    #[test]
+    fn parse_ignores_unknown_tags_and_orphan_results() {
+        let probe = parse(&[
+            "__HERDR_PROBE__ future_tag whatever",
+            "__HERDR_PROBE__ version /not/probed\therdr 0.7.4",
+            "__HERDR_PROBE__ end",
+        ]);
+        assert!(probe.candidates.is_empty());
+        assert!(probe.complete);
+    }
+
+    #[test]
+    fn candidate_matches_current_requires_version_and_protocol() {
+        let matching = CandidateProbe {
+            path: "/usr/bin/herdr".to_string(),
+            version_line: Some(expected_version_line()),
+            client_status_json: Some(format!("{{\"protocol\":{CURRENT_PROTOCOL}}}")),
+        };
+        assert!(matching.matches_current());
+
+        let wrong_version = CandidateProbe {
+            version_line: Some("herdr 0.0.1".to_string()),
+            ..matching.clone()
+        };
+        assert!(!wrong_version.matches_current());
+
+        let wrong_protocol = CandidateProbe {
+            client_status_json: Some("{\"protocol\":1}".to_string()),
+            ..matching.clone()
+        };
+        assert!(!wrong_protocol.matches_current());
+
+        let no_status = CandidateProbe {
+            client_status_json: None,
+            ..matching
+        };
+        assert!(!no_status.matches_current());
+    }
+
+    fn test_cache_entry() -> ProbeCacheEntry {
+        ProbeCacheEntry {
+            herdr_version: current_version(),
+            path: "/usr/bin/herdr".to_string(),
+            os: "linux".to_string(),
+            arch: "x86_64".to_string(),
+        }
+    }
+
+    fn process_output(command: &str) -> std::process::Output {
+        #[cfg(windows)]
+        let output = std::process::Command::new("cmd")
+            .args(["/D", "/C", command])
+            .output();
+        #[cfg(unix)]
+        let output = std::process::Command::new("sh")
+            .args(["-c", command])
+            .output();
+        output.expect("run test child")
+    }
+
+    #[test]
+    fn cached_probe_transport_failure_propagates_without_fallback() {
+        let output = process_output("exit 255");
+        let error = cached_probe_from_output(&output, &test_cache_entry())
+            .expect_err("ssh-style transport exit must fail");
+        assert!(error.to_string().contains("cached remote probe failed"));
+    }
+
+    #[test]
+    fn successful_stale_cached_probe_requests_full_fallback() {
+        let output = process_output("exit 0");
+        assert!(
+            cached_probe_from_output(&output, &test_cache_entry())
+                .expect("successful probe is parseable")
+                .is_none(),
+            "complete validation failure must fall back to the full probe"
+        );
+    }
+
+    #[test]
+    fn full_probe_script_covers_known_install_locations() {
+        let script = full_probe_script();
+
+        assert!(script.contains("probe \"$HOME/.local/bin/herdr\" candidate"));
+        assert!(script.contains(&format!("version={}", shell_quote(&current_version()))));
+        assert!(script
+            .contains("probe \"$HOME/.local/share/mise/installs/herdr/$version/bin/herdr\""));
+        assert!(script.contains("probe \"$HOME/.local/share/mise/installs/herdr/$version/herdr\""));
+        assert!(script.contains(
+            "probe \"$HOME/.local/share/mise/installs/github-ogulcancelik-herdr/$version/herdr\""
+        ));
+        assert!(script.contains("probe \"$HOME/.nix-profile/bin/herdr\""));
+        assert!(script.contains("probe \"/etc/profiles/per-user/$USER/bin/herdr\""));
+        assert!(script.contains("probe \"/run/current-system/sw/bin/herdr\""));
+        assert!(script.contains("probe \"/home/linuxbrew/.linuxbrew/bin/herdr\""));
+        assert!(script.contains("probe \"/opt/homebrew/bin/herdr\""));
+        assert!(script.contains("probe \"/usr/local/bin/herdr\""));
+        // Shims are rejected Rust-side (remote_herdr_from_path); the script
+        // must not scan them as known locations.
+        assert!(!script.contains("mise/shims/herdr"));
+        // Single round trip: uname, PATH lookup, and server status are all in
+        // the same script.
+        assert!(script.contains("uname -s"));
+        assert!(script.contains("command -v herdr"));
+        assert!(script.contains("status server --json"));
+        assert!(script.contains("status client --json"));
+    }
+
+    #[test]
+    fn fast_probe_script_checks_only_cached_path() {
+        let script = fast_probe_script("/opt/herdr bin/herdr");
+
+        assert!(script.contains("probe '/opt/herdr bin/herdr' candidate"));
+        assert!(!script.contains("uname"));
+        assert!(!script.contains("command -v herdr"));
+        assert!(script.contains("status server --json"));
+    }
+
+    #[test]
+    fn cache_entry_round_trips_through_json() {
+        let entry = ProbeCacheEntry {
+            herdr_version: "0.7.4".to_string(),
+            path: "/usr/bin/herdr".to_string(),
+            os: "linux".to_string(),
+            arch: "x86_64".to_string(),
+        };
+        let json = serde_json::to_string(&entry).expect("serialize");
+        let parsed: ProbeCacheEntry = serde_json::from_str(&json).expect("parse");
+        assert_eq!(parsed, entry);
+    }
+
+    fn cache_file_name(target: &str) -> String {
+        cache_file(target)
+            .file_name()
+            .and_then(|name| name.to_str())
+            .expect("UTF-8 cache filename")
+            .to_string()
+    }
+
+    #[test]
+    fn cache_file_name_is_readable_deterministic_and_bounded() {
+        let name = cache_file_name("user@host:22");
+        assert_eq!(name, cache_file_name("user@host:22"));
+        assert!(name.starts_with("user-host-22-"));
+        assert!(name.ends_with(".json"));
+        assert_eq!(name.len(), "user-host-22-".len() + 64 + ".json".len());
+        assert!(name.len() <= 102);
+    }
+
+    #[test]
+    fn cache_file_hashes_the_complete_unsanitized_target() {
+        assert_ne!(
+            cache_file_name("user@host:22"),
+            cache_file_name("user-host:22"),
+            "targets with the same sanitized form must not collide"
+        );
+
+        let shared_prefix = "a".repeat(40);
+        assert_ne!(
+            cache_file_name(&format!("{shared_prefix}-first.example")),
+            cache_file_name(&format!("{shared_prefix}-second.example")),
+            "targets truncated to the same readable prefix must not collide"
+        );
+    }
+}
