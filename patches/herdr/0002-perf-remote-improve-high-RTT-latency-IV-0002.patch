diff --git a/src/client/echo_timing.rs b/src/client/echo_timing.rs
new file mode 100644
index 0000000..476f39a
--- /dev/null
+++ b/src/client/echo_timing.rs
@@ -0,0 +1,202 @@
+//! Env-gated keystroke→frame echo latency probe (`HERDR_ECHO_TIMING=1`).
+//!
+//! Measures the wall-clock time between sending a key input to the server and
+//! receiving the next rendered frame. On a remote attach this approximates
+//! the full echo path (client → ssh → server → PTY → render → ssh → client),
+//! which is dominated by the link RTT.
+//!
+//! Methodology: at most one probe is outstanding at a time; the first frame
+//! received after a probed input closes the probe. Frames generated for
+//! unrelated reasons (spinner animation, background output) close probes
+//! early and show up as below-RTT outliers — measure while typing into an
+//! idle shell prompt for the clean signal.
+//!
+//! `HERDR_ECHO_TIMING=1` prints one summary when the client loop ends;
+//! `HERDR_ECHO_TIMING=verbose` additionally reports rolling stats every
+//! [`REPORT_EVERY`] samples. Zero overhead when the env var is unset.
+
+use std::time::Instant;
+
+const ENV_VAR: &str = "HERDR_ECHO_TIMING";
+const REPORT_EVERY: usize = 25;
+const MAX_SAMPLES: usize = 10_000;
+
+pub(crate) struct EchoTiming {
+    enabled: bool,
+    /// Report rolling stats while sampling instead of only a final summary.
+    verbose: bool,
+    outstanding: Option<Instant>,
+    samples_ms: Vec<u64>,
+    reported_at: usize,
+}
+
+impl EchoTiming {
+    pub(crate) fn from_env() -> Self {
+        let value = std::env::var(ENV_VAR).unwrap_or_default();
+        let value = value.trim();
+        let enabled = !value.is_empty() && value != "0";
+        let verbose = matches!(value, "verbose" | "rolling" | "2");
+        Self {
+            enabled,
+            verbose,
+            outstanding: None,
+            samples_ms: Vec::new(),
+            reported_at: 0,
+        }
+    }
+
+    /// Records that a key input was just sent to the server. No-op while a
+    /// previous probe is still waiting for its frame.
+    pub(crate) fn on_key_input_sent(&mut self) {
+        if !self.enabled || self.outstanding.is_some() {
+            return;
+        }
+        self.outstanding = Some(Instant::now());
+    }
+
+    /// Records that a rendered frame arrived from the server, closing the
+    /// outstanding probe if any.
+    pub(crate) fn on_render_received(&mut self) {
+        let Some(started) = self.outstanding.take() else {
+            return;
+        };
+        if self.samples_ms.len() >= MAX_SAMPLES {
+            return;
+        }
+        let elapsed_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);
+        self.samples_ms.push(elapsed_ms);
+        if self.verbose && self.samples_ms.len() - self.reported_at >= REPORT_EVERY {
+            self.report("rolling");
+        }
+    }
+
+    /// Prints a stats summary to stderr. Called automatically while sampling
+    /// and once more (as "final") when the client loop ends.
+    pub(crate) fn report(&mut self, label: &str) {
+        if !self.enabled || self.samples_ms.is_empty() || self.reported_at == self.samples_ms.len()
+        {
+            return;
+        }
+        self.reported_at = self.samples_ms.len();
+        let stats = Stats::compute(&self.samples_ms);
+        // \r\n: the host terminal is in raw mode while the client runs.
+        eprint!(
+            "herdr echo-timing ({label}): n={} p50={}ms p95={}ms min={}ms max={}ms\r\n",
+            stats.count, stats.p50, stats.p95, stats.min, stats.max
+        );
+    }
+}
+
+impl Drop for EchoTiming {
+    fn drop(&mut self) {
+        self.report("final");
+    }
+}
+
+/// Whether a structured input event should start an echo probe: key
+/// presses/repeats and pastes produce output; releases, mouse moves and
+/// focus events usually do not.
+#[cfg(windows)]
+pub(crate) fn is_key_or_paste_event(event: &crate::protocol::ClientInputEvent) -> bool {
+    use crate::protocol::{ClientInputEvent, ClientKeyKind};
+    match event {
+        ClientInputEvent::Key { kind, .. } => {
+            matches!(kind, ClientKeyKind::Press | ClientKeyKind::Repeat)
+        }
+        ClientInputEvent::Paste { .. } => true,
+        ClientInputEvent::Mouse { .. }
+        | ClientInputEvent::FocusGained
+        | ClientInputEvent::FocusLost => false,
+    }
+}
+
+struct Stats {
+    count: usize,
+    p50: u64,
+    p95: u64,
+    min: u64,
+    max: u64,
+}
+
+impl Stats {
+    fn compute(samples: &[u64]) -> Self {
+        let mut sorted = samples.to_vec();
+        sorted.sort_unstable();
+        let percentile = |p: usize| -> u64 {
+            let index = (sorted.len().saturating_sub(1)) * p / 100;
+            sorted[index]
+        };
+        Self {
+            count: sorted.len(),
+            p50: percentile(50),
+            p95: percentile(95),
+            min: sorted[0],
+            max: sorted[sorted.len() - 1],
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn enabled_probe() -> EchoTiming {
+        EchoTiming {
+            enabled: true,
+            verbose: false,
+            outstanding: None,
+            samples_ms: Vec::new(),
+            reported_at: 0,
+        }
+    }
+
+    #[test]
+    fn disabled_probe_records_nothing() {
+        let mut probe = EchoTiming {
+            enabled: false,
+            verbose: false,
+            outstanding: None,
+            samples_ms: Vec::new(),
+            reported_at: 0,
+        };
+        probe.on_key_input_sent();
+        assert!(probe.outstanding.is_none());
+        probe.on_render_received();
+        assert!(probe.samples_ms.is_empty());
+    }
+
+    #[test]
+    fn one_probe_outstanding_at_a_time() {
+        let mut probe = enabled_probe();
+        probe.on_key_input_sent();
+        let first = probe.outstanding;
+        assert!(first.is_some());
+        probe.on_key_input_sent();
+        assert_eq!(probe.outstanding, first, "second input must not restart");
+        probe.on_render_received();
+        assert!(probe.outstanding.is_none());
+        assert_eq!(probe.samples_ms.len(), 1);
+    }
+
+    #[test]
+    fn frame_without_probe_is_ignored() {
+        let mut probe = enabled_probe();
+        probe.on_render_received();
+        assert!(probe.samples_ms.is_empty());
+    }
+
+    #[test]
+    fn stats_percentiles() {
+        let samples: Vec<u64> = (1..=100).collect();
+        let stats = Stats::compute(&samples);
+        assert_eq!(stats.count, 100);
+        assert_eq!(stats.p50, 50);
+        assert_eq!(stats.p95, 95);
+        assert_eq!(stats.min, 1);
+        assert_eq!(stats.max, 100);
+
+        let one = Stats::compute(&[42]);
+        assert_eq!(one.p50, 42);
+        assert_eq!(one.p95, 42);
+    }
+}
