+        );
+    }
+
+    #[test]
+    fn coalesced_abc_space_def_confirms_without_stale_cursor() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&wide_prompt("", 2));
+        for ch in "abc def".chars() {
+            harness.predictor.on_char(ch, &mut Vec::new());
+        }
+
+        // The final diff writes every non-space character, while the space at
