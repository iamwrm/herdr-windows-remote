 const PREVIEW_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/preview.json";
 const REMOTE_BINARY_ENV_VAR: &str = "HERDR_REMOTE_BINARY";
+/// When set (e.g. `HERDR_REMOTE_TIMING=1`), the launcher prints per-phase
+/// timing to stderr so slow attaches can be diagnosed. Each ssh round-trip is
+/// a fresh connection on Windows (no ControlMaster), so phase timing usually
+/// pinpoints either per-connection auth cost or a slow remote command.
+const REMOTE_TIMING_ENV_VAR: &str = "HERDR_REMOTE_TIMING";
+
+pub(crate) fn remote_timing_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        std::env::var_os(REMOTE_TIMING_ENV_VAR).is_some_and(|value| !value.is_empty())
+    })
+}
+
+pub(crate) fn remote_timing(label: &str, detail: &str, elapsed: Duration) {
+    if !remote_timing_enabled() {
+        return;
+    }
+    if detail.is_empty() {
+        eprintln!("herdr: remote timing: {label} took {elapsed:.2?}");
+    } else {
+        eprintln!("herdr: remote timing: {label} [{detail}] took {elapsed:.2?}");
+    }
+}
+
+fn timed<T>(label: &str, detail: &str, run: impl FnOnce() -> T) -> T {
+    let started = Instant::now();
+    let result = run();
+    remote_timing(label, detail, started.elapsed());
+    result
+}
+
+/// First line of a remote shell script, for timing labels.
+fn script_summary(script: &str) -> &str {
+    script.lines().next().unwrap_or("").trim()
+}
 pub(crate) const REATTACH_COMMAND_ENV_VAR: &str = "HERDR_REATTACH_COMMAND";
 
 pub(crate) const REMOTE_KEYBINDINGS_ENV_VAR: &str = "HERDR_REMOTE_KEYBINDINGS";
