+//! Predictive local echo for remote attach (i0002 W3, mosh-style).
+//!
+//! On a high-RTT link every keystroke takes a full round trip before it
+//! echoes. When the typing context is safe (plain unstyled cells, visible
+//! cursor, room before the right margin) the client draws the typed
+//! character immediately — underlined, like mosh — and reconciles against
+//! the frames the server sends later:
+//!
+//! - the server echoes the same character into the predicted cell → the
+//!   prediction is confirmed (the server's own write repaints the cell with
+//!   its real style, dropping the underline);
+//! - the server writes something else there → all outstanding predictions
+//!   are repainted from the [`ScreenModel`] (the server's truth) — this is
+//!   why the model exists: the server diffs against *its* idea of the
+//!   screen and would never repaint a wrongly-predicted cell it did not
+//!   touch;
+//! - a prediction stays unconfirmed too long → same repaint, so stalls
+//!   cannot leave stale artifacts.
+//!
+//! Modes (`remote.predictive_echo`, env `HERDR_PREDICTIVE_ECHO`):
+//! `off` — fully disabled, byte-for-byte today's behavior; `always` — draw
+//! from the first keystroke; `auto` (default) — predictions are tracked
+//! invisibly until two of them are confirmed with an echo delay above
+//! [`AUTO_MIN_LATENCY`], so fast links never see underlines and broken
+//! contexts never draw at all.
+//!
+//! Only printable width-1 characters (optionally shifted) and backspace
+//! over our own predictions are predicted. Any other key press flushes
+//! outstanding predictions back to server truth.
+
+use std::collections::VecDeque;
+use std::io::Write;
+use std::time::{Duration, Instant};
+
+use super::screen_model::ScreenModel;
+use crate::protocol::TerminalFrame;
+
+/// The plain pen (matches `render_ansi::build_sgr` for an unstyled cell).
+const PLAIN_SGR: &str = "\x1b[0;39;49m";
+/// Prediction pen: underline over default colors.
+const UNDERLINE_SGR: &str = "\x1b[0;4;39;49m";
+/// Maximum keystrokes predicted ahead of the last confirmation.
+const MAX_PENDING: usize = 8;
+/// Unconfirmed predictions older than this are flushed back to server truth.
+const PREDICTION_TIMEOUT: Duration = Duration::from_secs(5);
+/// `auto` starts drawing after this many confirmed predictions…
+const AUTO_MIN_CONFIRMED: u64 = 2;
+/// …whose echo delay exceeded this (fast links never show predictions).
+const AUTO_MIN_LATENCY: Duration = Duration::from_millis(60);
+
+const ENV_VAR: &str = "HERDR_PREDICTIVE_ECHO";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PredictiveEchoMode {
+    Off,
+    Auto,
+    Always,
+}
+
+impl PredictiveEchoMode {
+    pub(crate) fn from_config(config_value: &str) -> Self {
+        let value = std::env::var(ENV_VAR)
+            .ok()
+            .filter(|value| !value.trim().is_empty())
+            .unwrap_or_else(|| config_value.to_string());
+        match value.trim().to_ascii_lowercase().as_str() {
+            "off" | "false" | "0" => Self::Off,
+            "always" => Self::Always,
+            _ => Self::Auto,
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Prediction {
+    x: u16,
+    y: u16,
+    ch: char,
+    drawn: bool,
+    sent_at: Instant,
+}
+
+pub(crate) struct Predictor {
+    model: ScreenModel,
+    pending: VecDeque<Prediction>,
+    display_unlocked: bool,
+    confirmed: u64,
+    touched_scratch: Vec<(u16, u16)>,
+}
+
+impl Predictor {
+    /// Returns `None` for [`PredictiveEchoMode::Off`], so the client loop
+    /// carries no prediction state at all when disabled.
+    pub(crate) fn new(mode: PredictiveEchoMode) -> Option<Self> {
+        if mode == PredictiveEchoMode::Off {
+            return None;
+        }
+        Some(Self {
+            model: ScreenModel::new(),
+            pending: VecDeque::new(),
+            display_unlocked: mode == PredictiveEchoMode::Always,
+            confirmed: 0,
+            touched_scratch: Vec::new(),
+        })
+    }
+
+    /// Structured input events (Windows client input path).
+    #[cfg(windows)]
+    pub(crate) fn on_input_events(
+        &mut self,
+        events: &[crate::protocol::ClientInputEvent],
+        out: &mut impl Write,
+    ) {
+        use crate::protocol::{ClientInputEvent, ClientKeyCode, ClientKeyKind};
+
+        const SHIFT: u8 = 0b1;
+        for event in events {
+            match event {
+                ClientInputEvent::Key {
+                    code,
+                    modifiers,
+                    kind: ClientKeyKind::Press | ClientKeyKind::Repeat,
+                } => match code {
+                    ClientKeyCode::Char(ch) if modifiers & !SHIFT == 0 => {
+                        self.on_char(*ch, out);
+                    }
+                    ClientKeyCode::Backspace if *modifiers == 0 => {
+                        self.on_backspace(out);
+                    }
+                    _ => self.on_other_input(out),
+                },
+                ClientInputEvent::Paste { .. } => self.on_other_input(out),
+                _ => {}
+            }
+        }
+    }
+
+    /// Raw stdin bytes (Unix client input path). Predicts only when the
+    /// chunk is pure printable text; anything with ESC or control bytes
+    /// (arrows, bracketed pastes, chords) flushes instead.
+    #[cfg(unix)]
+    pub(crate) fn on_raw_input(&mut self, data: &[u8], out: &mut impl Write) {
+        if data == b"\x7f" {
+            self.on_backspace(out);
+            return;
+        }
+        match std::str::from_utf8(data) {
+            Ok(text) if !text.is_empty() && !text.chars().any(char::is_control) => {
+                for ch in text.chars() {
+                    self.on_char(ch, out);
+                }
+            }
+            _ => self.on_other_input(out),
+        }
+    }
+
+    /// A printable character was typed. Predicts and (when unlocked) draws
+    /// it underlined at the predicted insertion point.
+    pub(crate) fn on_char(&mut self, ch: char, out: &mut impl Write) {
+        use unicode_width::UnicodeWidthChar as _;
+
+        if self.pending.len() >= MAX_PENDING {
+            return;
+        }
+        if ch.is_control() || ch.width() != Some(1) {
+            self.on_other_input(out);
+            return;
+        }
+        if !self.model.cursor_visible() {
+            return;
+        }
+        let (x, y) = self.insertion_point();
+        // Same-row typing with room before the right margin; the target and
+        // the cell we push the cursor into must both be unstyled.
+        if y != self.model.cursor().1
+            || x + 1 >= self.model.width()
+            || !self.cell_is_plain(x, y)
+            || !self.cell_is_plain(x + 1, y)
+        {
+            return;
+        }
+
+        let drawn = self.display_unlocked;
+        if drawn {
+            let _ = write!(
+                out,
+                "\x1b[{};{}H{UNDERLINE_SGR}{ch}{PLAIN_SGR}",
+                y + 1,
+                x + 1
+            );
+            let _ = out.flush();
+        }
+        self.pending.push_back(Prediction {
+            x,
+            y,
+            ch,
+            drawn,
+            sent_at: Instant::now(),
+        });
+    }
+
+    /// Backspace is only predicted over our own outstanding predictions.
+    pub(crate) fn on_backspace(&mut self, out: &mut impl Write) {
+        let Some(prediction) = self.pending.pop_back() else {
+            return;
+        };
+        if prediction.drawn {
+            let symbol = self.model_symbol(prediction.x, prediction.y);
+            let _ = write!(
+                out,
+                "\x1b[{row};{col}H{PLAIN_SGR}{symbol}\x1b[{row};{col}H",
+                row = prediction.y + 1,
+                col = prediction.x + 1,
+            );
+            let _ = out.flush();
+        }
+    }
+
+    /// Any other key press: restore server truth before its effects arrive.
+    pub(crate) fn on_other_input(&mut self, out: &mut impl Write) {
+        self.flush_repaint(out);
+    }
+
+    pub(crate) fn on_resize(&mut self) {
+        // A full redraw follows; it repaints everything we predicted.
+        self.pending.clear();
+    }
+
+    /// Applies a received frame to the model and reconciles predictions.
+    /// Must be called *after* the frame bytes were written to the host
+    /// terminal, so repaints and re-anchors land on top.
+    pub(crate) fn on_frame(&mut self, frame: &TerminalFrame, out: &mut impl Write) {
+        self.model.ensure_size(frame.width, frame.height);
+        let mut touched = std::mem::take(&mut self.touched_scratch);
+        touched.clear();
+        self.model.apply(&frame.bytes, &mut touched);
+
+        if frame.full {
+            // The redraw repainted every cell; the screen is server truth.
+            self.pending.clear();
+            self.touched_scratch = touched;
+            return;
+        }
+
+        // Confirm from the oldest prediction while the server's writes show
+        // exactly what we predicted.
+        while let Some(front) = self.pending.front() {
+            let confirmed = touched.contains(&(front.x, front.y))
+                && self.model_symbol_is(front.x, front.y, front.ch);
+            if !confirmed {
+                break;
+            }
+            let front = self.pending.pop_front().expect("front exists");
+            self.confirmed += 1;
+            if front.sent_at.elapsed() >= AUTO_MIN_LATENCY && self.confirmed >= AUTO_MIN_CONFIRMED
+            {
+                self.display_unlocked = true;
+            }
+        }
+
+        // Any remaining prediction whose cell the server rewrote with other
+        // content — or that has waited too long — is a misprediction.
+        let mispredicted = self
+            .pending
+            .iter()
+            .any(|prediction| {
+                touched.contains(&(prediction.x, prediction.y))
+                    && !self.model_symbol_is(prediction.x, prediction.y, prediction.ch)
+            })
+            || self
+                .pending
+                .front()
+                .is_some_and(|front| front.sent_at.elapsed() > PREDICTION_TIMEOUT);
+
+        if mispredicted {
+            self.flush_repaint(out);
+        } else if self.pending.iter().any(|prediction| prediction.drawn) {
+            // The frame parked the host cursor at the server's position and
+            // may have repainted cells under still-valid predictions; put
+            // both back.
+            self.redraw_pending(out);
+        }
+        self.touched_scratch = touched;
+    }
+
+    fn insertion_point(&self) -> (u16, u16) {
+        match self.pending.back() {
+            Some(prediction) => ((prediction.x + 1).min(self.model.width()), prediction.y),
+            None => self.model.cursor(),
+        }
+    }
+
+    fn cell_is_plain(&self, x: u16, y: u16) -> bool {
+        self.model.cell(x, y).is_some_and(|cell| cell.plain)
+    }
+
+    fn model_symbol_is(&self, x: u16, y: u16, ch: char) -> bool {
+        self.model
+            .cell(x, y)
+            .is_some_and(|cell| cell.symbol.chars().eq(std::iter::once(ch)))
+    }
+
+    fn model_symbol(&self, x: u16, y: u16) -> String {
+        match self.model.cell(x, y) {
+            Some(cell) if !cell.symbol.is_empty() => cell.symbol.clone(),
+            _ => " ".to_string(),
+        }
+    }
+
+    /// Repaints every drawn prediction with the model's (server-truth)
+    /// content and parks the host cursor back at the server's position.
+    fn flush_repaint(&mut self, out: &mut impl Write) {
+        let mut wrote = false;
+        while let Some(prediction) = self.pending.pop_front() {
+            if !prediction.drawn {
+                continue;
+            }
+            let symbol = self.model_symbol(prediction.x, prediction.y);
+            let _ = write!(
+                out,
+                "\x1b[{};{}H{PLAIN_SGR}{symbol}",
+                prediction.y + 1,
+                prediction.x + 1,
+            );
+            wrote = true;
+        }
+        if wrote {
+            let (x, y) = self.model.cursor();
+            let _ = write!(out, "\x1b[{};{}H", y + 1, x + 1);
+            let _ = out.flush();
+        }
+    }
+
+    /// Re-draws still-valid predictions after a frame repainted underneath
+    /// them, and re-anchors the host cursor at the predicted insertion
+    /// point.
+    fn redraw_pending(&mut self, out: &mut impl Write) {
+        for prediction in &self.pending {
+            if !prediction.drawn {
+                continue;
+            }
+            let _ = write!(
+                out,
+                "\x1b[{};{}H{UNDERLINE_SGR}{}",
+                prediction.y + 1,
+                prediction.x + 1,
+                prediction.ch,
+            );
+        }
+        let (x, y) = self.insertion_point();
+        let _ = write!(out, "{PLAIN_SGR}\x1b[{};{}H", y + 1, x.min(self.model.width().saturating_sub(1)) + 1);
+        let _ = out.flush();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::render_ansi::BlitEncoder;
+    use crate::protocol::{CellData, CursorState, FrameData};
+
+    fn plain_cell(symbol: &str) -> CellData {
+        CellData {
+            symbol: symbol.to_string(),
+            fg: 0,
+            bg: 0,
+            modifier: 0,
+            skip: false,
+            hyperlink: None,
+        }
+    }
+
+    fn styled_cell(symbol: &str) -> CellData {
+        CellData {
+            modifier: 1,
+            ..plain_cell(symbol)
+        }
+    }
+
+    /// A tiny 8x2 "shell": `$ ` prompt with the cursor after it.
+    fn prompt_frame(extra: &[(u16, u16, CellData)], cursor: (u16, u16)) -> FrameData {
+        let mut cells = vec![plain_cell(" "); 16];
+        cells[0] = plain_cell("$");
+        for (x, y, cell) in extra {
+            cells[*y as usize * 8 + *x as usize] = cell.clone();
+        }
+        FrameData {
+            cells,
+            width: 8,
+            height: 2,
+            cursor: Some(CursorState {
+                x: cursor.0,
+                y: cursor.1,
+                visible: true,
+                shape: 0,
+            }),
+            hyperlinks: Vec::new(),
+            graphics: Vec::new(),
+        }
+    }
+
+    /// Drives frames through a real `BlitEncoder` into the predictor.
+    struct Harness {
+        encoder: BlitEncoder,
+        predictor: Predictor,
+        seq: u64,
+    }
+
+    impl Harness {
+        fn new(mode: PredictiveEchoMode) -> Self {
+            Self {
+                encoder: BlitEncoder::new(),
+                predictor: Predictor::new(mode).expect("mode not off"),
+                seq: 0,
+            }
+        }
+
+        fn feed(&mut self, frame: &FrameData) -> Vec<u8> {
+            let encoded = self.encoder.encode(frame, false);
+            self.seq += 1;
+            let terminal_frame = TerminalFrame {
+                seq: self.seq,
+                width: frame.width,
+                height: frame.height,
+                full: encoded.full,
+                bytes: encoded.bytes.clone(),
+            };
+            self.encoder.commit(frame.clone(), encoded);
+            let mut out = Vec::new();
+            self.predictor.on_frame(&terminal_frame, &mut out);
+            out
+        }
+    }
+
+    #[test]
+    fn off_mode_creates_no_predictor() {
+        assert!(Predictor::new(PredictiveEchoMode::Off).is_none());
+    }
+
+    #[test]
+    fn mode_parsing_defaults_to_auto() {
+        assert_eq!(
+            PredictiveEchoMode::from_config("off"),
+            PredictiveEchoMode::Off
+        );
+        assert_eq!(
+            PredictiveEchoMode::from_config("always"),
+            PredictiveEchoMode::Always
+        );
+        assert_eq!(
+            PredictiveEchoMode::from_config("auto"),
+            PredictiveEchoMode::Auto
+        );
+        assert_eq!(
+            PredictiveEchoMode::from_config("garbage"),
+            PredictiveEchoMode::Auto
+        );
+    }
+
+    #[test]
+    fn always_mode_draws_underlined_prediction_at_cursor() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+
+        let mut out = Vec::new();
+        harness.predictor.on_char('l', &mut out);
+        let out = String::from_utf8(out).expect("utf8");
+        assert!(out.contains("\x1b[1;3H"), "CUP to cursor: {out:?}");
+        assert!(out.contains(UNDERLINE_SGR), "underline pen: {out:?}");
+        assert!(out.contains('l'), "predicted char: {out:?}");
+        assert!(out.ends_with(PLAIN_SGR), "pen restored: {out:?}");
+        assert_eq!(harness.predictor.pending.len(), 1);
+    }
+
+    #[test]
+    fn prediction_confirms_when_server_echoes_same_char() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('l', &mut Vec::new());
+
+        // Server echo: `l` appears at (2,0), cursor advances.
+        let out = harness.feed(&prompt_frame(&[(2, 0, plain_cell("l"))], (3, 0)));
+        assert!(harness.predictor.pending.is_empty(), "confirmed");
+        assert_eq!(harness.predictor.confirmed, 1);
+        assert!(out.is_empty(), "no repaint needed: {out:?}");
+    }
+
+    #[test]
+    fn misprediction_repaints_server_truth_and_flushes() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('a', &mut Vec::new());
+        harness.predictor.on_char('b', &mut Vec::new());
+
+        // Server writes something else into the first predicted cell.
+        let out = harness.feed(&prompt_frame(&[(2, 0, plain_cell("X"))], (3, 0)));
+        let out = String::from_utf8(out).expect("utf8");
+        assert!(harness.predictor.pending.is_empty(), "flushed");
+        // The second prediction's cell (3,0) is repainted from the model.
+        assert!(out.contains("\x1b[1;4H"), "repaint second cell: {out:?}");
+        assert!(out.contains(PLAIN_SGR), "plain pen: {out:?}");
+    }
+
+    #[test]
+    fn typeahead_predictions_are_redrawn_and_cursor_reanchored() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('a', &mut Vec::new());
+        harness.predictor.on_char('b', &mut Vec::new());
+
+        // Server confirms only the first char; the second is still pending.
+        let out = harness.feed(&prompt_frame(&[(2, 0, plain_cell("a"))], (3, 0)));
+        let out = String::from_utf8(out).expect("utf8");
+        assert_eq!(harness.predictor.pending.len(), 1);
+        assert!(out.contains("\x1b[1;4H"), "redraw pending at (3,0): {out:?}");
+        assert!(out.contains(UNDERLINE_SGR), "still underlined: {out:?}");
+        assert!(
+            out.ends_with("\x1b[1;5H"),
+            "cursor re-anchored past prediction: {out:?}"
+        );
+    }
+
+    #[test]
+    fn auto_mode_dark_launches_then_unlocks_after_confirmations() {
+        let mut harness = Harness::new(PredictiveEchoMode::Auto);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+
+        let mut out = Vec::new();
+        harness.predictor.on_char('a', &mut out);
+        assert!(out.is_empty(), "auto must not draw yet");
+        assert_eq!(harness.predictor.pending.len(), 1, "still tracked");
+
+        // Two confirmations slower than AUTO_MIN_LATENCY unlock drawing.
+        std::thread::sleep(AUTO_MIN_LATENCY + Duration::from_millis(20));
+        harness.feed(&prompt_frame(&[(2, 0, plain_cell("a"))], (3, 0)));
+        harness.predictor.on_char('b', &mut Vec::new());
+        std::thread::sleep(AUTO_MIN_LATENCY + Duration::from_millis(20));
+        harness.feed(&prompt_frame(
+            &[(2, 0, plain_cell("a")), (3, 0, plain_cell("b"))],
+            (4, 0),
+        ));
+        assert!(harness.predictor.display_unlocked, "unlocked after 2 slow confirms");
+
+        let mut out = Vec::new();
+        harness.predictor.on_char('c', &mut out);
+        assert!(!out.is_empty(), "draws once unlocked");
+    }
+
+    #[test]
+    fn styled_cells_and_hidden_cursor_are_not_predicted() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[(2, 0, styled_cell("~"))], (2, 0)));
+        harness.predictor.on_char('x', &mut Vec::new());
+        assert!(harness.predictor.pending.is_empty(), "styled target");
+
+        let mut hidden = prompt_frame(&[], (2, 0));
+        hidden.cursor.as_mut().expect("cursor").visible = false;
+        harness.feed(&hidden);
+        harness.predictor.on_char('x', &mut Vec::new());
+        assert!(harness.predictor.pending.is_empty(), "hidden cursor");
+    }
+
+    #[test]
+    fn right_margin_is_not_predicted() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (7, 0)));
+        harness.predictor.on_char('x', &mut Vec::new());
+        assert!(harness.predictor.pending.is_empty());
+    }
+
+    #[test]
+    fn backspace_undoes_last_prediction_only() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('a', &mut Vec::new());
+
+        let mut out = Vec::new();
+        harness.predictor.on_backspace(&mut out);
+        let out = String::from_utf8(out).expect("utf8");
+        assert!(harness.predictor.pending.is_empty());
+        assert!(out.contains("\x1b[1;3H"), "restores the cell: {out:?}");
+
+        // Without pending predictions, backspace is left to the server.
+        let mut out = Vec::new();
+        harness.predictor.on_backspace(&mut out);
+        assert!(out.is_empty());
+    }
+
+    #[test]
+    fn other_keys_flush_drawn_predictions() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('a', &mut Vec::new());
+
+        let mut out = Vec::new();
+        harness.predictor.on_other_input(&mut out);
+        let out = String::from_utf8(out).expect("utf8");
+        assert!(harness.predictor.pending.is_empty());
+        assert!(out.contains("\x1b[1;3H"), "repaint predicted cell: {out:?}");
+        assert!(out.ends_with("\x1b[1;3H"), "cursor at server pos: {out:?}");
+    }
+
+    #[test]
+    fn full_redraw_clears_pending_without_repaint() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        harness.feed(&prompt_frame(&[], (2, 0)));
+        harness.predictor.on_char('a', &mut Vec::new());
+
+        // A resize forces the next encode to be a full frame.
+        harness.predictor.on_resize();
+        assert!(harness.predictor.pending.is_empty());
+    }
+
+    #[test]
+    fn pending_cap_stops_predicting() {
+        let mut harness = Harness::new(PredictiveEchoMode::Always);
+        let wide = FrameData {
+            cells: vec![plain_cell(" "); 24],
+            width: 24,
+            height: 1,
+            cursor: Some(CursorState {
+                x: 0,
+                y: 0,
+                visible: true,
+                shape: 0,
+            }),
+            hyperlinks: Vec::new(),
+            graphics: Vec::new(),
+        };
+        harness.feed(&wide);
+        for _ in 0..MAX_PENDING + 3 {
+            harness.predictor.on_char('x', &mut Vec::new());
+        }
+        assert_eq!(harness.predictor.pending.len(), MAX_PENDING);
+    }
+}
