-pub fn show_desktop_notification(_title: &str, _body: Option<&str>) -> std::io::Result<bool> {
-    Ok(false)
+const WINDOWS_TOAST_APP_ID: &str = "herdr";
+const WINDOWS_TOAST_DEBUG_ENV_VAR: &str = "HERDR_WINDOWS_TOAST_DEBUG";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum WindowsToastStage {
+    BuildDocument,
+    CreateNotification,
+    CreateNotifier,
+    ReadSetting,
+    Show,
+}
+
+impl WindowsToastStage {
+    fn label(self) -> &'static str {
+        match self {
+            Self::BuildDocument => "build WinRT XML document",
+            Self::CreateNotification => "create ToastNotification",
+            Self::CreateNotifier => "create ToastNotifier for app ID 'herdr'",
+            Self::ReadSetting => "read ToastNotifier.Setting",
+            Self::Show => "call ToastNotifier.Show",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+enum WindowsShellNotificationState {
+    Value(QUERY_USER_NOTIFICATION_STATE),
+    QueryFailed(u32),
+}
+
+#[derive(Debug, Clone, Copy)]
+struct WindowsToastOutcome {
+    setting: NotificationSetting,
+    shell_state: WindowsShellNotificationState,
+}
+
+#[derive(Debug)]
+struct WindowsToastError {
+    stage: WindowsToastStage,
+    source: windows::core::Error,
+}
+
+impl WindowsToastError {
+    fn new(stage: WindowsToastStage, source: windows::core::Error) -> Self {
+        Self { stage, source }
+    }
+
+    fn hresult(&self) -> u32 {
+        self.source.code().0 as u32
+    }
+}
+
+impl std::fmt::Display for WindowsToastError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            formatter,
+            "{} failed (HRESULT 0x{:08X}): {}",
+            self.stage.label(),
+            self.hresult(),
+            self.source.message()
+        )
+    }
+}
+
+impl std::error::Error for WindowsToastError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.source)
+    }
+}
+
+/// Show a native Windows toast through the current user's WinRT notification
+/// service. This uses no helper process, external runtime, registration, or
+/// elevated operation.
+pub fn show_desktop_notification(title: &str, body: Option<&str>) -> std::io::Result<bool> {
+    let result = show_windows_toast(title, body);
+    if windows_toast_debug_enabled() {
+        match &result {
+            Ok(outcome) => tracing::info!(
+                event = "windows.toast.diagnostic",
+                outcome = "winrt_show_returned_success",
+                notification_setting = windows_notification_setting_label(outcome.setting),
+                shell_state = windows_shell_notification_state_label(outcome.shell_state),
+                "Windows system toast diagnostic"
+            ),
+            Err(err) => tracing::warn!(
+                event = "windows.toast.diagnostic",
+                outcome = "winrt_error",
+                stage = err.stage.label(),
+                hresult = format_args!("0x{:08X}", err.hresult()),
+                error = %err.source.message(),
+                "Windows system toast diagnostic"
+            ),
+        }
+        show_windows_toast_debug_dialog(&windows_toast_debug_report(title, body, &result));
+    }
+
+    result
+        .map(|_| true)
+        .map_err(|err| std::io::Error::other(err.to_string()))
+}
+
+fn show_windows_toast(
+    title: &str,
+    body: Option<&str>,
+) -> Result<WindowsToastOutcome, WindowsToastError> {
+    let document = build_windows_toast_document(title, body)
+        .map_err(|err| WindowsToastError::new(WindowsToastStage::BuildDocument, err))?;
+    let notification = ToastNotification::CreateToastNotification(&document)
+        .map_err(|err| WindowsToastError::new(WindowsToastStage::CreateNotification, err))?;
+    let notifier =
+        ToastNotificationManager::CreateToastNotifierWithId(&HSTRING::from(WINDOWS_TOAST_APP_ID))
+            .map_err(|err| WindowsToastError::new(WindowsToastStage::CreateNotifier, err))?;
+    let setting = notifier
+        .Setting()
+        .map_err(|err| WindowsToastError::new(WindowsToastStage::ReadSetting, err))?;
+    let shell_state = query_windows_shell_notification_state();
+    notifier
+        .Show(&notification)
+        .map_err(|err| WindowsToastError::new(WindowsToastStage::Show, err))?;
+    Ok(WindowsToastOutcome {
+        setting,
+        shell_state,
+    })
+}
+
+fn query_windows_shell_notification_state() -> WindowsShellNotificationState {
+    let mut state = 0;
+    let result = unsafe { SHQueryUserNotificationState(&mut state) };
+    if result >= 0 {
+        WindowsShellNotificationState::Value(state)
+    } else {
+        WindowsShellNotificationState::QueryFailed(result as u32)
+    }
+}
+
+fn windows_notification_setting_label(setting: NotificationSetting) -> &'static str {
+    if setting == NotificationSetting::Enabled {
+        "Enabled"
+    } else if setting == NotificationSetting::DisabledForApplication {
+        "DisabledForApplication"
+    } else if setting == NotificationSetting::DisabledForUser {
+        "DisabledForUser"
+    } else if setting == NotificationSetting::DisabledByGroupPolicy {
+        "DisabledByGroupPolicy"
+    } else if setting == NotificationSetting::DisabledByManifest {
+        "DisabledByManifest"
+    } else {
+        "Unknown"
+    }
+}
+
+fn windows_shell_notification_state_label(state: WindowsShellNotificationState) -> &'static str {
+    match state {
+        WindowsShellNotificationState::Value(QUNS_ACCEPTS_NOTIFICATIONS) => "AcceptsNotifications",
+        WindowsShellNotificationState::Value(QUNS_NOT_PRESENT) => "UserNotPresent",
+        WindowsShellNotificationState::Value(QUNS_BUSY) => "Busy",
+        WindowsShellNotificationState::Value(QUNS_RUNNING_D3D_FULL_SCREEN) => {
+            "RunningD3dFullScreen"
+        }
+        WindowsShellNotificationState::Value(QUNS_PRESENTATION_MODE) => "PresentationMode",
+        WindowsShellNotificationState::Value(QUNS_QUIET_TIME) => "QuietTime",
+        WindowsShellNotificationState::Value(QUNS_APP) => "App",
+        WindowsShellNotificationState::Value(_) => "Unknown",
+        WindowsShellNotificationState::QueryFailed(_) => "QueryFailed",
+    }
+}
+
+pub(crate) fn show_windows_toast_debug_ready() {
+    if !windows_toast_debug_enabled() {
+        return;
+    }
+
+    tracing::info!(
+        event = "windows.toast.diagnostic",
+        outcome = "client_ready",
+        "Windows system toast diagnostics enabled"
+    );
+    show_windows_toast_debug_dialog(
+        "Windows notification diagnostics are active.\r\n\r\n\
+         The Herdr client started and inherited HERDR_WINDOWS_TOAST_DEBUG. \
+         Dismiss this dialog, then trigger a system notification.\r\n\r\n\
+         If no second dialog appears, the remote server did not send a \
+         SystemToast to this Windows client.",
+    );
+}
+
+fn windows_toast_debug_enabled() -> bool {
+    windows_toast_debug_enabled_from_value(
+        std::env::var(WINDOWS_TOAST_DEBUG_ENV_VAR).ok().as_deref(),
+    )
+}
+
+fn windows_toast_debug_enabled_from_value(value: Option<&str>) -> bool {
+    value
+        .map(|value| {
+            matches!(
+                value.trim().to_ascii_lowercase().as_str(),
+                "1" | "true" | "yes" | "on"
+            )
+        })
+        .unwrap_or(false)
+}
+
+fn windows_toast_debug_report(
+    title: &str,
+    body: Option<&str>,
+    result: &Result<WindowsToastOutcome, WindowsToastError>,
+) -> String {
+    let body = body.filter(|body| !body.is_empty()).unwrap_or("<none>");
+    let log_path = crate::session::data_dir().join("herdr-client.log");
+    let outcome = match result {
+        Ok(outcome) => {
+            let setting = windows_notification_setting_label(outcome.setting);
+            let shell_state = windows_shell_notification_state_label(outcome.shell_state);
+            let shell_state_value = match outcome.shell_state {
+                WindowsShellNotificationState::Value(value) => value.to_string(),
+                WindowsShellNotificationState::QueryFailed(hresult) => {
+                    format!("HRESULT 0x{hresult:08X}")
+                }
+            };
+            format!(
+                "WinRT notification setting: {setting} ({}).\r\n\
+                 Windows shell state: {shell_state} ({shell_state_value}).\r\n\
+                 ToastNotifier.Show returned success.\r\n\r\n\
+                 If the setting is not Enabled, that setting is the failure layer. \
+                 If the shell does not accept notifications, Windows is suppressing popups. \
+                 If both permit notifications but no toast appeared, portable app identity is the likely layer.",
+                outcome.setting.0
+            )
+        }
+        Err(err) => format!(
+            "WinRT result: FAILED at {}.\r\nHRESULT: 0x{:08X}\r\nError: {}",
+            err.stage.label(),
+            err.hresult(),
+            err.source.message()
+        ),
+    };
+
+    format!(
+        "Herdr invoked the Windows system-toast backend.\r\n\r\n\
+         For a remote session, this proves the Linux server's SystemToast reached the Windows client.\r\n\r\n\
+         Title: {title}\r\nBody: {body}\r\n\r\n{outcome}\r\n\r\n\
+         Client log: {}",
+        log_path.display()
+    )
+}
+
+fn show_windows_toast_debug_dialog(message: &str) {
+    let caption = wide_null("Herdr Windows notification diagnostics");
+    let message = wide_null(message);
+    let result = unsafe {
+        MessageBoxW(
+            null_mut(),
+            message.as_ptr(),
+            caption.as_ptr(),
+            MB_OK | MB_ICONINFORMATION | MB_SETFOREGROUND | MB_TOPMOST,
+        )
+    };
+    if result == 0 {
+        tracing::warn!(
+            event = "windows.toast.diagnostic",
+            outcome = "dialog_failed",
+            "failed to show Windows system toast diagnostic dialog"
+        );
+    }
+}
+
+fn build_windows_toast_document(
+    title: &str,
+    body: Option<&str>,
+) -> windows::core::Result<XmlDocument> {
+    let document = XmlDocument::new()?;
+    let toast = document.CreateElement(&HSTRING::from("toast"))?;
+    document.AppendChild(&toast)?;
+
+    let visual = document.CreateElement(&HSTRING::from("visual"))?;
+    toast.AppendChild(&visual)?;
+
+    let binding = document.CreateElement(&HSTRING::from("binding"))?;
+    binding.SetAttribute(&HSTRING::from("template"), &HSTRING::from("ToastGeneric"))?;
+    visual.AppendChild(&binding)?;
+
+    append_windows_toast_text(&document, &binding, title)?;
+    if let Some(body) = body.filter(|body| !body.is_empty()) {
+        append_windows_toast_text(&document, &binding, body)?;
+    }
+
+    Ok(document)
+}
+
+fn append_windows_toast_text(
+    document: &XmlDocument,
+    binding: &XmlElement,
+    text: &str,
+) -> windows::core::Result<()> {
+    let element = document.CreateElement(&HSTRING::from("text"))?;
+    element.SetInnerText(&HSTRING::from(text))?;
+    binding.AppendChild(&element)?;
+    Ok(())
 }
 
